          "content": {
            "size": 179779,
            "mimeType": "text/html; charset=utf-8",
            "compression": 0,
            "text": "<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<title>Demand Pattern RCA Agent — Console</title>\r\n<style>\r\n  :root{\r\n    --bg:#f4f7fc; --panel:#ffffff; --panel-2:#f5f8fc; --border:#e1e7f0; --nav:#0d1b3e;\r\n    --text:#14203a; --muted:#586179; --accent:#2d6cdf; --accent-2:#12986f;\r\n    --warn:#c96a10; --danger:#d13a58; --purple:#7952d1; --pink:#c43e86;\r\n    --insW:360px;\r\n  }\r\n  *{box-sizing:border-box;}\r\n  body{background:var(--bg);color:var(--text);margin:0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;line-height:1.5;transition:padding-right .24s ease;}\r\n  body.ins-open{padding-right:var(--insW);}\r\n\r\n  /* NAV BAR */\r\n  .nav{background:var(--nav);color:#fff;position:sticky;top:0;z-index:50;box-shadow:0 2px 10px rgba(0,0,0,.15);}\r\n  .nav-in{max-width:1400px;margin:0 auto;display:flex;align-items:center;gap:6px;padding:0 16px;flex-wrap:wrap;}\r\n  .brand{font-weight:800;font-size:15px;letter-spacing:-0.2px;padding:12px 14px 12px 0;display:flex;align-items:center;gap:9px;}\r\n  .brand .dot{width:9px;height:9px;border-radius:50%;background:var(--accent-2);}\r\n  .nav a{color:#c7d2ec;text-decoration:none;font-size:12.5px;font-weight:600;padding:14px 12px;border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;}\r\n  .nav a:hover{color:#fff;}\r\n  .nav a.active{color:#fff;border-bottom-color:var(--accent-2);}\r\n  .nav .spacer{flex:1;}\r\n  .nav .env{font-size:11px;color:#9fb0d4;padding:0 6px;}\r\n\r\n  .page{max-width:1400px;margin:0 auto;padding:20px 16px 70px;}\r\n  .tab{display:none;} .tab.active{display:block;}\r\n  h1{font-size:22px;margin:0 0 3px;letter-spacing:-0.3px;}\r\n  .sub{color:var(--muted);font-size:13px;margin-bottom:16px;}\r\n  h2.sec{font-size:12px;text-transform:uppercase;letter-spacing:1.1px;color:var(--muted);margin:26px 0 12px;font-weight:800;}\r\n\r\n  /* generic cards */\r\n  .cards{display:grid;gap:12px;}\r\n  .g2{grid-template-columns:repeat(2,1fr);} .g3{grid-template-columns:repeat(3,1fr);} .g4{grid-template-columns:repeat(4,1fr);}\r\n  .card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:14px 15px;}\r\n  .card h4{margin:0 0 8px;font-size:13.5px;}\r\n  .card ul{margin:0;padding-left:16px;font-size:12.5px;color:var(--muted);} .card li{margin-bottom:5px;} .card li b{color:var(--text);}\r\n  .tag{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:999px;background:rgba(45,108,223,.1);color:var(--accent);border:1px solid rgba(45,108,223,.25);margin:0 4px 4px 0;}\r\n  .tag.g{background:rgba(18,152,111,.1);color:var(--accent-2);border-color:rgba(18,152,111,.25);}\r\n  .tag.p{background:rgba(121,82,209,.1);color:var(--purple);border-color:rgba(121,82,209,.25);}\r\n  .tag.w{background:rgba(201,106,16,.1);color:var(--warn);border-color:rgba(201,106,16,.25);}\r\n\r\n  /* ===== RCA CONSOLE ===== */\r\n  .toolbar{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}\r\n  .filebtn{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12.5px;font-weight:600;cursor:pointer;}\r\n  .filebtn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent);}\r\n  .filebtn.map{background:var(--purple);}\r\n  .filebtn.sql{background:var(--accent-2);}\r\n  /* pipeline strip: data ingestion → RCA */\r\n  .pipe{display:flex;align-items:stretch;gap:0;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:10px 6px;margin-bottom:14px;overflow-x:auto;}\r\n  .pstage{flex:1;min-width:118px;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 12px;position:relative;text-align:center;}\r\n  .pstage:not(:last-child)::after{content:\"›\";position:absolute;right:-5px;top:calc(50% - 2px);transform:translateY(-50%);color:var(--muted);font-weight:800;font-size:18px;}\r\n  .pstage .pi{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;background:var(--panel-2);border:1px solid var(--border);}\r\n  .pstage .pt{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);}\r\n  .pstage .pv{font-size:11.5px;font-weight:800;color:var(--text);min-height:15px;}\r\n  .pstage.pending{opacity:.5;}\r\n  .pstage.done .pi{background:rgba(18,152,111,.15);border-color:var(--accent-2);}\r\n  .pstage.done .pt{color:var(--accent-2);}\r\n  .pstage.active .pi{background:rgba(45,108,223,.15);border-color:var(--accent);}\r\n  .pstage.active .pt{color:var(--accent);}\r\n  /* SQL connect modal fields */\r\n  .sqlf{display:flex;align-items:center;gap:10px;margin-bottom:9px;}\r\n  .sqlf label{width:96px;font-size:12px;color:var(--muted);flex-shrink:0;}\r\n  .sqlf input{flex:1;border:1px solid var(--border);border-radius:6px;padding:7px 9px;font-size:12px;background:var(--panel-2);color:var(--text);font-family:ui-monospace,Consolas,monospace;}\r\n  .sqlnote{font-size:11.5px;color:var(--muted);background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin:12px 0 14px;line-height:1.5;}\r\n  .sqlnote code{background:var(--panel);padding:1px 5px;border-radius:3px;}\r\n  .status{font-size:11.5px;color:var(--muted);}\r\n  .status b{color:var(--text);}\r\n  .badge{font-size:10px;font-weight:800;padding:2px 8px;border-radius:5px;letter-spacing:.3px;}\r\n  .badge.ok{background:rgba(18,152,111,.12);color:var(--accent-2);border:1px solid rgba(18,152,111,.3);}\r\n  .badge.unm{background:rgba(201,106,16,.12);color:var(--warn);border:1px solid rgba(201,106,16,.3);}\r\n  label.band{font-size:12px;color:var(--muted);display:inline-flex;align-items:center;gap:6px;margin-left:auto;}\r\n  input[type=number]{width:56px;background:var(--panel-2);border:1px solid var(--border);border-radius:6px;padding:4px 6px;font-size:12px;color:var(--text);}\r\n\r\n  .console{display:grid;grid-template-columns:236px 300px 1fr;gap:14px;align-items:start;}\r\n  @media (max-width:1100px){.console{grid-template-columns:1fr;}}\r\n\r\n  /* Excel-style filters */\r\n  .filters{background:var(--panel);border:1px solid var(--border);border-radius:12px;overflow:hidden;position:sticky;top:64px;}\r\n  .filters .fh{padding:10px 13px;border-bottom:1px solid var(--border);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);display:flex;justify-content:space-between;align-items:center;}\r\n  .filters .fh .fh-t{display:flex;align-items:center;gap:6px;cursor:pointer;user-select:none;flex:1;}\r\n  .filters .fh .fchev{display:inline-block;font-size:9px;transition:transform .15s;}\r\n  .filters.collapsed .fh{border-bottom:none;}\r\n  .filters.collapsed #filterBody{display:none;}\r\n  .fgroup{border-bottom:1px solid var(--border);}\r\n  .fgroup > .ft{padding:9px 13px;font-size:12.5px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;user-select:none;}\r\n  .fgroup .fbody{padding:0 13px 10px;display:block;}\r\n  .fgroup.collapsed .fbody{display:none;}\r\n  .fsearch{width:100%;border:1px solid var(--border);border-radius:6px;padding:5px 8px;font-size:11.5px;margin:2px 0 7px;background:var(--panel-2);color:var(--text);}\r\n  .fopts{max-height:150px;overflow:auto;}\r\n  .fopt{display:flex;align-items:center;gap:7px;font-size:12px;padding:3px 0;cursor:pointer;}\r\n  .fopt input{accent-color:var(--accent);}\r\n  .reset{width:100%;border:1px solid var(--danger);color:var(--danger);background:transparent;border-radius:8px;padding:9px;font-size:12px;font-weight:700;cursor:pointer;margin:10px 0 0;}\r\n\r\n  .metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:12px;}\r\n  .metric{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 11px;}\r\n  .metric .v{font-size:18px;font-weight:800;} .metric .l{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:1px;}\r\n  .metric.flag .v{color:var(--danger);} .metric.good .v{color:var(--accent-2);}\r\n\r\n  .listcol h3, .reportcol h3{margin:0 0 9px;font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);}\r\n  .qwrap{max-height:640px;overflow:auto;}\r\n  .qitem{background:var(--panel);border:1px solid var(--border);border-radius:9px;padding:10px 11px;margin-bottom:8px;cursor:pointer;}\r\n  .qitem:hover{border-color:var(--accent);}\r\n  .qitem.active{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset;}\r\n  .qitem .qn{font-size:12px;font-weight:700;}\r\n  .qitem .qmeta{font-size:10.5px;color:var(--muted);margin-top:2px;}\r\n  .qitem .chips{margin-top:6px;display:flex;gap:5px;flex-wrap:wrap;}\r\n  .chip{font-size:10px;font-weight:700;padding:2px 7px;border-radius:999px;}\r\n  .chip.red{background:rgba(209,58,88,.13);color:var(--danger);border:1px solid rgba(209,58,88,.3);}\r\n  .chip.amber{background:rgba(201,106,16,.13);color:var(--warn);border:1px solid rgba(201,106,16,.3);}\r\n  .chip.green{background:rgba(18,152,111,.13);color:var(--accent-2);border:1px solid rgba(18,152,111,.3);}\r\n\r\n  .reportcol{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:16px;min-height:360px;}\r\n  .rhead{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start;}\r\n  .rtitle{font-size:16px;font-weight:800;}\r\n  .rmeta{font-size:11.5px;color:var(--muted);margin-top:2px;}\r\n  .acc{text-align:right;} .acc .big{font-size:24px;font-weight:800;} .acc .lbl{font-size:11px;color:var(--muted);}\r\n\r\n  .rca-bullets{list-style:none;padding:0;margin:14px 0 0;}\r\n  .rca-bullets li{display:flex;gap:9px;align-items:flex-start;padding:9px 0;border-top:1px dashed var(--border);font-size:13px;}\r\n  .rca-bullets li:first-child{border-top:none;}\r\n  .bdot{width:7px;height:7px;border-radius:50%;margin-top:6px;flex-shrink:0;}\r\n  .bdot.hit{background:var(--danger);} .bdot.part{background:var(--warn);} .bdot.info{background:var(--accent);}\r\n  .btext{flex:1;} .btext b{color:var(--text);}\r\n  .ibtn{flex-shrink:0;width:19px;height:19px;border-radius:50%;border:1px solid var(--accent);color:var(--accent);background:transparent;font-size:11px;font-weight:800;cursor:pointer;font-style:italic;line-height:1;}\r\n  .ibtn:hover{background:var(--accent);color:#fff;}\r\n\r\n  .subhead{font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);font-weight:800;margin:18px 0 6px;}\r\n  .kv{display:flex;justify-content:space-between;font-size:12.5px;padding:3px 0;gap:10px;} .kv .k{color:var(--muted);} .kv .val{font-weight:700;}\r\n  .evi{font-size:11.5px;color:var(--muted);font-family:ui-monospace,Menlo,Consolas,monospace;background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;}\r\n  .evi div{padding:2px 0;}\r\n\r\n  .empty{color:var(--muted);font-size:13px;text-align:center;padding:60px 16px;border:1px dashed var(--border);border-radius:12px;background:var(--panel);}\r\n  .empty b{color:var(--text);}\r\n\r\n  /* ===== VOLUMETRICS (EPIC) ===== */\r\n  .vol{position:relative;background:radial-gradient(120% 140% at 0% 0%,#1d4f8f 0%,#16306b 42%,#0b1631 100%);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:26px 28px;margin-bottom:16px;color:#fff;box-shadow:0 18px 44px -18px rgba(8,16,36,.7);overflow:hidden;}\r\n  .vol::before{content:\"\";position:absolute;inset:0;background:radial-gradient(60% 80% at 100% 0%,rgba(95,224,176,.10),transparent 60%);pointer-events:none;}\r\n  .vol > *{position:relative;}\r\n  .vol .vtop{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;margin-bottom:20px;}\r\n  .vol .vtitle{font-size:17px;font-weight:800;letter-spacing:-.3px;display:flex;align-items:center;gap:10px;}\r\n  .vol .vtitle .spark{font-size:22px;}\r\n  .vol .vsub{font-size:12px;color:#c2d0ee;margin-top:4px;max-width:660px;line-height:1.5;}\r\n  .vol .vscope{font-size:11px;color:#aebfe4;text-align:right;white-space:nowrap;}\r\n  .vol .vscope b{color:#fff;}\r\n  .vhero{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px;margin-bottom:24px;}\r\n  .vhcell{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:12px 13px;transition:transform .12s,background .12s;min-width:0;}\r\n  .vhcell:hover{background:rgba(255,255,255,.1);transform:translateY(-2px);}\r\n  .vhcell .n{font-size:21px;font-weight:800;letter-spacing:-.5px;line-height:1.05;overflow-wrap:break-word;}\r\n  .vhcell .k{font-size:8.5px;text-transform:uppercase;letter-spacing:.5px;color:#aebfe4;margin-top:7px;}\r\n  @media (max-width:1100px){.vhero{grid-template-columns:repeat(auto-fit,minmax(120px,1fr));} .vhcell .n{font-size:24px;}}\r\n  .vhcell.accent .n{color:#5fe0b0;} .vhcell.warn .n{color:#ffb968;} .vhcell.flag .n{color:#ff8199;}\r\n  .vgrid-h{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#9fb2d8;margin:0 0 12px;display:flex;align-items:center;gap:10px;}\r\n  .vgrid-h::after{content:\"\";flex:1;height:1px;background:linear-gradient(90deg,rgba(255,255,255,.18),transparent);}\r\n  .vgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(256px,1fr));gap:12px;}\r\n  .vdim{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:14px 15px;transition:border-color .12s,background .12s;}\r\n  .vdim:hover{border-color:rgba(95,224,176,.4);background:rgba(255,255,255,.07);}\r\n  .vdim .vd-h{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;gap:8px;padding-bottom:9px;border-bottom:1px solid rgba(255,255,255,.08);}\r\n  .vdim .vd-l{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;color:#c2d0ee;font-weight:800;}\r\n  .vdim .vd-c{font-size:21px;font-weight:800;letter-spacing:-.5px;}\r\n  .vdim .vd-c small{font-size:9px;font-weight:700;color:#8fa3cf;letter-spacing:.3px;margin-left:3px;}\r\n  .vbar{margin:8px 0;}\r\n  .vbar .vb-t{display:flex;justify-content:space-between;font-size:11px;color:#e4ebf8;margin-bottom:4px;gap:8px;}\r\n  .vbar .vb-t .vb-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px;font-weight:600;}\r\n  .vbar .vb-t .vb-pct{color:#cdd9f2;flex-shrink:0;font-variant-numeric:tabular-nums;font-weight:700;}\r\n  .vbar .vb-track{height:6px;background:rgba(255,255,255,.12);border-radius:99px;overflow:hidden;}\r\n  .vbar .vb-fill{height:100%;background:linear-gradient(90deg,#3d8bff,#5fe0b0);border-radius:99px;}\r\n  .vdim .vd-more{font-size:10px;color:#8fa3cf;margin-top:9px;cursor:pointer;user-select:none;}\r\n  .vdim .vd-more:hover{color:#cdd9f2;text-decoration:underline;}\r\n  .vdim .vd-rest{margin-top:2px;max-height:230px;overflow:auto;}\r\n  /* drill-down */\r\n  .vbar.drillable{cursor:pointer;border-radius:8px;padding:3px 7px;margin:5px -7px;transition:background .1s;}\r\n  .vbar.drillable:hover{background:rgba(95,224,176,.13);}\r\n  .vbar.drillable .vb-name::after{content:\" ›\";color:#5fe0b0;font-weight:800;}\r\n  .vdrill{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin:0 0 14px;font-size:11.5px;}\r\n  .vd-crumb{color:#9fd0ff;cursor:pointer;font-weight:700;padding:2px 8px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);}\r\n  .vd-crumb:hover{background:rgba(255,255,255,.13);}\r\n  .vd-crumb.cur{color:#0b1631;background:#5fe0b0;border-color:#5fe0b0;cursor:default;}\r\n  .vd-sep{color:#6b7ea6;}\r\n  .vd-clear{margin-left:4px;background:rgba(255,129,153,.14);border:1px solid rgba(255,129,153,.42);color:#ff9bad;border-radius:999px;padding:2px 10px;font-size:10.5px;font-weight:700;cursor:pointer;}\r\n  .vd-clear:hover{background:rgba(255,129,153,.24);}\r\n\r\n  /* ===== DASHBOARD CHARTS ===== */\r\n  .dash{display:grid;gap:14px;}\r\n  .dgrid{display:grid;gap:14px;grid-template-columns:1fr 1fr;}\r\n  @media (max-width:900px){.dgrid{grid-template-columns:1fr;}}\r\n  .chart{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:15px 16px;position:relative;}\r\n  .chart h4{margin:0 0 2px;font-size:13.5px;}\r\n  .chart .cs{font-size:11px;color:var(--muted);margin-bottom:12px;}\r\n  .chart svg{display:block;width:100%;height:auto;overflow:visible;}\r\n  .trend{position:relative;}\r\n  .ax{fill:var(--muted);font-size:10px;font-family:inherit;}\r\n  .axt{fill:var(--muted);font-size:9.5px;font-family:inherit;}\r\n  .vlbl{fill:var(--text);font-size:10px;font-weight:700;font-family:inherit;font-variant-numeric:tabular-nums;}\r\n  .grid-l{stroke:var(--border);stroke-width:1;}\r\n  .barrect{transition:opacity .12s;} .barrect:hover{opacity:.82;}\r\n  .dotm:hover{r:5.5;}\r\n  /* crosshair tooltip */\r\n  .cx-tip{position:absolute;pointer-events:none;background:var(--nav);color:#fff;border-radius:7px;padding:6px 9px;font-size:11px;line-height:1.35;box-shadow:0 6px 20px -8px rgba(0,0,0,.5);opacity:0;transform:translate(-50%,-115%);transition:opacity .08s;white-space:nowrap;z-index:6;}\r\n  .cx-tip b{color:#9fd0ff;}\r\n  .cx-line{stroke:var(--accent);stroke-width:1;stroke-dasharray:3 3;opacity:.55;}\r\n  .dlegend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:8px;}\r\n  .dlegend span{display:inline-flex;align-items:center;gap:6px;}\r\n  .dlegend .sw{width:12px;height:9px;border-radius:3px;display:inline-block;}\r\n\r\n  /* insights callout */\r\n  .insights{background:linear-gradient(135deg,rgba(45,108,223,.09),rgba(18,152,111,.07));border:1px solid var(--border);border-left:3px solid var(--accent);margin-bottom:16px;}\r\n  .insights h4{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:13.5px;}\r\n  .insights h4 .isc{font-size:10.5px;font-weight:700;color:var(--muted);text-transform:none;}\r\n  .insights ul{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:9px 18px;}\r\n  @media (max-width:820px){.insights ul{grid-template-columns:1fr;}}\r\n  .insights li{font-size:12.5px;color:var(--text);display:flex;gap:9px;align-items:flex-start;line-height:1.45;}\r\n  .insights li .ic{flex-shrink:0;font-size:14px;line-height:1.3;}\r\n  .insights b{color:var(--text);font-weight:700;}\r\n  .ins-up{color:var(--accent-2);font-weight:800;} .ins-down{color:var(--danger);font-weight:800;}\r\n  /* right-side slidable + resizable Insights drawer */\r\n  .ins-drawer{position:fixed;top:48px;right:0;height:calc(100vh - 48px);width:0;z-index:48;display:none;}\r\n  .ins-drawer.avail{display:block;}\r\n  .ins-panel{position:absolute;top:0;right:0;height:100%;width:var(--insW);background:var(--panel);border-left:1px solid var(--border);box-shadow:-14px 0 36px -20px rgba(8,16,36,.55);transform:translateX(100%);transition:transform .24s ease;display:flex;flex-direction:column;}\r\n  .ins-drawer.open .ins-panel{transform:translateX(0);}\r\n  .ins-resize{position:absolute;left:0;top:0;height:100%;width:7px;cursor:ew-resize;z-index:3;}\r\n  .ins-resize:hover{background:linear-gradient(90deg,var(--accent),transparent);}\r\n  .ins-handle{position:absolute;top:96px;right:100%;background:var(--accent);color:#fff;writing-mode:vertical-rl;text-orientation:mixed;padding:16px 9px;border-radius:10px 0 0 10px;cursor:pointer;font-weight:800;font-size:12px;letter-spacing:.6px;box-shadow:-6px 0 18px -10px rgba(8,16,36,.5);user-select:none;}\r\n  .ins-handle span{transform:rotate(180deg);}\r\n  .ins-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border);font-weight:800;font-size:14px;color:var(--text);flex-shrink:0;}\r\n  .ins-head .ins-x{background:none;border:none;font-size:16px;cursor:pointer;color:var(--muted);line-height:1;padding:2px 6px;border-radius:6px;}\r\n  .ins-head .ins-x:hover{color:var(--text);background:var(--panel-2);}\r\n  .ins-body{padding:16px;overflow:auto;flex:1;}\r\n  .ins-scope{font-size:10.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:14px;}\r\n  .ins-ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px;}\r\n  .ins-ul li{font-size:12.5px;color:var(--text);display:flex;gap:9px;align-items:flex-start;line-height:1.5;}\r\n  .ins-ul li .ic{flex-shrink:0;font-size:15px;line-height:1.3;}\r\n  .ins-ul b{color:var(--text);font-weight:700;}\r\n  @media (max-width:820px){.ins-ul{gap:12px;}}\r\n  /* diverging (signed bias) bars */\r\n  .dvg{display:flex;flex-direction:column;gap:11px;}\r\n  .dvg-row .dvg-t{display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:4px;gap:8px;}\r\n  .dvg-row .dvg-t .nm{color:var(--text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\r\n  .dvg-track{position:relative;height:12px;background:var(--panel-2);border-radius:4px;overflow:hidden;}\r\n  .dvg-track .mid{position:absolute;left:50%;top:-1px;bottom:-1px;width:1px;background:var(--muted);opacity:.55;}\r\n  .dvg-fill{position:absolute;top:2px;height:8px;border-radius:3px;transition:width .15s;}\r\n  .dvg-legend{display:flex;justify-content:space-between;font-size:10.5px;color:var(--muted);margin-top:9px;}\r\n  /* KPI delta chip in the volumetrics hero */\r\n  .vhcell .d{font-size:10.5px;font-weight:800;margin-top:4px;}\r\n  .vhcell .d.up{color:#5fe0b0;} .vhcell .d.down{color:#ff8199;}\r\n\r\n  /* ===== EMBEDDED GANTT (Timeline tab) ===== */\r\n  #tab-timeline .top{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;}\r\n  #tab-timeline .kpi{background:var(--panel);border:1px solid var(--border);border-radius:11px;padding:13px 15px;}\r\n  #tab-timeline .kpi .v{font-size:22px;font-weight:800;}\r\n  #tab-timeline .kpi .l{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:2px;}\r\n  #tab-timeline .kpi.hot .v{color:var(--danger);}\r\n  #tab-timeline .glegend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-bottom:14px;}\r\n  #tab-timeline .glegend span{display:inline-flex;align-items:center;gap:6px;}\r\n  #tab-timeline .gsw{width:14px;height:10px;border-radius:3px;display:inline-block;}\r\n  #tab-timeline .gsw.done{background:var(--accent-2);} #tab-timeline .gsw.prog{background:var(--warn);} #tab-timeline .gsw.todo{background:#8a93a8;}\r\n  #tab-timeline .gsw.ms{background:var(--purple);border-radius:50%;width:11px;height:11px;transform:rotate(45deg);}\r\n  #tab-timeline .gantt{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:8px 12px 16px;overflow-x:auto;}\r\n  #tab-timeline .grid-head,#tab-timeline .grow{display:grid;grid-template-columns:250px repeat(11,minmax(46px,1fr));align-items:center;}\r\n  #tab-timeline .grid-head{border-bottom:1px solid var(--border);padding:8px 0;}\r\n  #tab-timeline .grid-head .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;font-weight:700;}\r\n  #tab-timeline .dh{text-align:center;font-size:11px;color:var(--muted);}\r\n  #tab-timeline .dh b{display:block;color:var(--text);font-size:13px;}\r\n  #tab-timeline .dh.wknd{color:var(--muted);}\r\n  #tab-timeline .dh.deadline b{color:var(--danger);}\r\n  #tab-timeline .dh.today b{color:var(--accent);}\r\n  #tab-timeline .grow{border-top:1px dashed var(--border);min-height:52px;}\r\n  #tab-timeline .grow .gname{padding:8px 10px 8px 0;}\r\n  #tab-timeline .grow .gname .t{font-size:13px;font-weight:700;}\r\n  #tab-timeline .grow .gname .d{font-size:11px;color:var(--muted);margin-top:1px;}\r\n  #tab-timeline .gchip{font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:999px;text-transform:uppercase;letter-spacing:.4px;margin-left:6px;vertical-align:middle;}\r\n  #tab-timeline .gchip.done{background:rgba(18,152,111,.16);color:var(--accent-2);}\r\n  #tab-timeline .gchip.prog{background:rgba(201,106,16,.16);color:var(--warn);}\r\n  #tab-timeline .gchip.todo{background:rgba(140,150,180,.16);color:#8a93a8;}\r\n  #tab-timeline .track{grid-column:2 / span 11;display:grid;grid-template-columns:repeat(11,1fr);position:relative;height:34px;align-items:center;}\r\n  #tab-timeline .cell{grid-row:1;height:34px;border-left:1px solid var(--border);}\r\n  #tab-timeline .cell.wknd{background:#eceff5;}\r\n  #tab-timeline .cell:last-child{border-right:1px solid var(--border);}\r\n  #tab-timeline .bar{grid-row:1;height:22px;border-radius:6px;z-index:2;display:flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:700;color:#08111f;padding:0 6px;overflow:hidden;white-space:nowrap;}\r\n  #tab-timeline .bar.done{background:var(--accent-2);color:#fff;}\r\n  #tab-timeline .bar.prog{background:var(--warn);color:#fff;}\r\n  #tab-timeline .bar.todo{background:#8a93a8;color:#fff;}\r\n  #tab-timeline .msq{grid-row:1;z-index:3;justify-self:center;width:16px;height:16px;background:var(--purple);transform:rotate(45deg);border:2px solid var(--panel);border-radius:3px;}\r\n  #tab-timeline .todayline{grid-row:1;z-index:1;width:2px;background:var(--accent);justify-self:start;height:34px;margin-left:-1px;opacity:.6;}\r\n  #tab-timeline .gnotes{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:14px;}\r\n  #tab-timeline .gnotes .card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:14px 16px;}\r\n  #tab-timeline .gnotes .card.risk{border-left:3px solid var(--danger);}\r\n  @media (max-width:820px){#tab-timeline .top{grid-template-columns:repeat(2,1fr);}#tab-timeline .gnotes{grid-template-columns:1fr;}}\r\n\r\n  /* math modal */\r\n  .modal-bg{display:none;position:fixed;inset:0;background:rgba(10,20,40,.45);z-index:100;align-items:center;justify-content:center;padding:20px;}\r\n  .modal-bg.show{display:flex;}\r\n  .modal{background:var(--panel);border:1px solid var(--border);border-radius:14px;max-width:560px;width:100%;padding:20px 22px;box-shadow:0 20px 60px -20px rgba(0,0,0,.5);}\r\n  .modal h3{margin:0 0 4px;font-size:16px;}\r\n  .modal .msub{font-size:12px;color:var(--muted);margin-bottom:14px;}\r\n  .formula{background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:12px 14px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;margin-bottom:10px;}\r\n  .formula .lbl{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);display:block;margin-bottom:4px;font-family:inherit;}\r\n  .formula .res{color:var(--accent-2);font-weight:700;}\r\n  .mclose{margin-top:8px;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 16px;font-weight:600;cursor:pointer;float:right;}\r\n\r\n  /* probing */\r\n  .probe{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-top:14px;}\r\n  .probe .q{font-size:13px;font-weight:700;margin-bottom:8px;}\r\n  .probe textarea{width:100%;height:56px;border:1px solid var(--border);border-radius:8px;padding:8px 10px;font-size:12.5px;resize:vertical;background:var(--panel-2);color:var(--text);}\r\n  .probe .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;}\r\n  .kbitem{font-size:12px;border-top:1px dashed var(--border);padding:7px 0;}\r\n  .kbitem b{color:var(--text);} .kbitem .a{color:var(--muted);}\r\n  .pill{font-size:11px;background:var(--panel-2);border:1px solid var(--border);border-radius:999px;padding:3px 9px;cursor:pointer;color:var(--muted);}\r\n  .pill:hover{border-color:var(--accent);color:var(--accent);}\r\n\r\n  /* ===== Root-Cause Investigation report ===== */\r\n  .inv-card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:10px;}\r\n  .inv-kv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;}\r\n  @media (max-width:600px){.inv-kv-grid{grid-template-columns:repeat(2,1fr);}}\r\n  .inv-kv-grid .kvi{background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px 10px;}\r\n  .inv-kv-grid .kvi .l{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;}\r\n  .inv-kv-grid .kvi .v{font-size:13.5px;font-weight:800;margin-top:2px;}\r\n  .inv-sec{background:var(--panel);border:1px solid var(--border);border-radius:10px;margin-bottom:8px;overflow:hidden;}\r\n  .inv-sec summary{cursor:pointer;padding:11px 16px;font-size:13.5px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:var(--text);list-style:none;display:flex;justify-content:space-between;align-items:center;}\r\n  .inv-sec summary::-webkit-details-marker{display:none;}\r\n  .inv-sec summary::after{content:'▾';color:var(--muted);font-size:11px;transition:transform .15s;}\r\n  .inv-sec[open] summary::after{transform:rotate(180deg);}\r\n  .inv-sec .body{padding:2px 14px 14px;font-size:12.5px;color:var(--text);}\r\n  .inv-findings{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px;}\r\n  .inv-findings li{padding:8px 10px;background:var(--panel-2);border-left:3px solid var(--accent);border-radius:6px;}\r\n  .rc-card{border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:10px;background:var(--panel-2);}\r\n  .rc-card.primary{border-left:4px solid var(--accent-2);}\r\n  .rc-card.secondary{border-left:4px solid var(--accent);}\r\n  .rc-conf{height:6px;background:var(--border);border-radius:99px;overflow:hidden;margin:8px 0 3px;}\r\n  .rc-conf-fill{height:100%;background:var(--accent-2);}\r\n  .ev-chip{display:inline-block;font-size:11px;background:rgba(45,108,223,.10);border:1px solid rgba(45,108,223,.55);color:#123a7a;font-weight:600;border-radius:999px;padding:3px 9px;margin:6px 4px 0 0;}\r\n  .rej-item{padding:8px 0;border-top:1px dashed var(--border);}\r\n  .rej-item:first-child{border-top:none;}\r\n  .rej-item .h{font-weight:700;color:var(--text);}\r\n  .rej-item .r{color:var(--muted);font-size:11.5px;margin-top:2px;}\r\n  .inv-empty{color:var(--muted);font-size:12px;font-style:italic;padding:6px 0;}\r\n  .inv-conf-meter{display:flex;align-items:center;gap:10px;}\r\n  .inv-conf-meter .bar{flex:1;height:10px;background:var(--panel-2);border:1px solid var(--border);border-radius:99px;overflow:hidden;}\r\n  .inv-conf-meter .fill{height:100%;background:var(--accent-2);}\r\n  .inv-meta{font-size:10.5px;color:var(--muted);margin-top:2px;padding-top:10px;border-top:1px dashed var(--border);}\r\n  .inv-badge{font-size:9.5px;font-weight:800;padding:3px 8px;border-radius:5px;text-transform:uppercase;letter-spacing:.3px;white-space:nowrap;}\r\n  .inv-badge.placeholder{background:rgba(201,106,16,.12);color:var(--warn);border:1px solid rgba(201,106,16,.3);}\r\n  .inv-badge.llm{background:rgba(18,152,111,.12);color:var(--accent-2);border:1px solid rgba(18,152,111,.3);}\r\n\r\n  table.def{width:100%;border-collapse:collapse;font-size:12.5px;}\r\n  table.def th,table.def td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);vertical-align:top;}\r\n  table.def th{color:var(--muted);text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;}\r\n  table.def td code{background:var(--panel-2);padding:1px 5px;border-radius:4px;font-size:11.5px;}\r\n  /* direction caption under the big Forecast Adherence figure -- the sign alone is easy to miss,\r\n     and reading it backwards inverts the conclusion */\r\n  .acc .adhdir{ font-size:9.5px; font-weight:600; color:var(--muted); margin-top:2px;\r\n                text-transform:none; letter-spacing:0; line-height:1.25; max-width:150px; }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<!-- NAV BAR -->\r\n<div class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <div class=\"brand\"><span class=\"dot\"></span>Demand Pattern RCA Agent</div>\r\n    <a data-tab=\"console\" class=\"active\">RCA Console</a>\r\n    <a data-tab=\"dashboard\">Dashboard</a>\r\n    <a data-tab=\"timeline\">Timeline</a>\r\n    <a data-tab=\"arch\">Architecture</a>\r\n    <a data-tab=\"stack\">Tech Stack</a>\r\n    <a data-tab=\"models\">AI Models</a>\r\n    <a data-tab=\"data\">Data &amp; Files</a>\r\n    <a data-tab=\"defs\">Definitions &amp; Formulas</a>\r\n    <span class=\"spacer\"></span>\r\n    <span class=\"env\">Client env · GitLab · on-prem</span>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"page\">\r\n\r\n  <!-- ============ RCA CONSOLE ============ -->\r\n  <div class=\"tab active\" id=\"tab-console\">\r\n    <h1>RCA Console</h1>\r\n    <div class=\"sub\">Upload the weekly file, then type your 2–3 target <b>Forecast_name</b>s in the test box (or filter like Excel). Only two metrics are computed — <b>Forecast Accuracy</b> and <b>Forecast Adherence</b>; each has an <b>ⓘ</b> showing the exact formula and the numbers used. Rows with no/zero forecast are skipped (can't compute).</div>\r\n\r\n    <div class=\"toolbar\">\r\n      <input type=\"file\" id=\"fileWeekly\" accept=\".csv,.tsv,.txt,.xlsx\" style=\"display:none\" onchange=\"onWeekly(this.files&&this.files[0])\">\r\n      <input type=\"file\" id=\"fileMap\" accept=\".csv,.tsv,.txt,.xlsx\" style=\"display:none\" onchange=\"onMapping(this.files&&this.files[0])\">\r\n      <button class=\"filebtn sql\" onclick=\"openSQL()\">🗄 Connect to SQL Server (AA)</button>\r\n      <button class=\"filebtn\" onclick=\"window._pendingSrc='file';document.getElementById('fileWeekly').click()\">⬆ Upload weekly file</button>\r\n      <button class=\"filebtn map\" onclick=\"document.getElementById('fileMap').click()\">⬆ Upload CQN mapping</button>\r\n      <span class=\"status\" id=\"fileStatus\">No file loaded.</span>\r\n      <span id=\"mapBadge\"></span>\r\n      <input id=\"focusInput\" list=\"fnList\" style=\"flex:1;min-width:220px;max-width:420px;border:1px solid var(--border);border-radius:8px;padding:7px 10px;font-size:12px;color:var(--text);background:var(--panel-2)\" placeholder=\"Test specific Forecast_name(s) — comma-separated, or start typing to browse\" onkeydown=\"if(event.key==='Enter')applyFocus()\">\r\n      <datalist id=\"fnList\"></datalist>\r\n      <button class=\"filebtn ghost\" onclick=\"applyFocus()\">Test these</button>\r\n      <button class=\"filebtn ghost\" onclick=\"pickRandomQueue()\" title=\"Jump to a random Forecast_name from the loaded data — no need to know its name\">🎲 Random queue</button>\r\n      <button class=\"filebtn ghost\" onclick=\"clearFocus()\" title=\"Clear the Forecast_name test box\">✕ Clear</button>\r\n      <label class=\"band\">Accuracy band ±<input type=\"number\" id=\"band\" value=\"10\" min=\"1\" max=\"50\" onchange=\"if(ROWS.length)applyAndScan()\">%</label>\r\n    </div>\r\n\r\n    <!-- pipeline: data ingestion → RCA (fills in as data flows) -->\r\n    <div class=\"pipe\" id=\"pipe\"></div>\r\n\r\n    <div id=\"emptyState\" class=\"empty\">\r\n      <div style=\"font-size:34px;margin-bottom:8px;\">📂</div>\r\n      <b>Upload the weekly demand file to begin.</b><br>\r\n      Accepted: <b>.csv, .tsv, .xlsx</b> · header row + the standard demand columns (Fiscal_Week, Region, Forecast_name, Actual_Offered, fcst_offered, …).<br>\r\n      Optionally add the <b>CQN mapping file</b> to resolve the true Combined Queue Name — without it the tool falls back to <code>Forecast_name</code> and marks queues <span class=\"badge unm\">unmapped</span>.\r\n    </div>\r\n\r\n    <div id=\"consoleArea\" style=\"display:none;\">\r\n      <div class=\"console\">\r\n        <!-- FILTERS -->\r\n        <div class=\"filters\" id=\"filters\">\r\n          <div class=\"fh\"><span class=\"fh-t\" onclick=\"toggleFilters()\"><span class=\"fchev\" id=\"filtChev\">▾</span> Filters</span><span class=\"pill\" onclick=\"resetFilters()\">Reset</span></div>\r\n          <div id=\"filterBody\">\r\n            <div id=\"filterGroups\"></div>\r\n            <div style=\"padding:0 13px 12px;\"><button class=\"reset\" onclick=\"resetFilters()\">↻ Reset All Filters</button></div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- FLAGGED LIST -->\r\n        <div class=\"listcol\">\r\n          <div class=\"metrics\" id=\"metrics\"></div>\r\n          <h3>Flagged queues / weeks</h3>\r\n          <div class=\"qwrap\" id=\"qlist\"></div>\r\n        </div>\r\n\r\n        <!-- REPORT -->\r\n        <div>\r\n          <div class=\"reportcol\" id=\"report\"><div class=\"empty\" style=\"border:none;padding:40px 10px;\">Select a flagged item to see its RCA.</div></div>\r\n\r\n          <!-- PROBING — HIDDEN for now (Phase 2: knowledge-base / RAG over confirmed causes).\r\n               Kept in source intentionally; the JS (renderContextProbes/saveKnowledge/downloadKB) still\r\n               exists and no-ops safely because these elements are absent. See IMP_DOCS/TODO.md P3. -->\r\n          <!--\r\n          <div class=\"probe\">\r\n            <div class=\"q\">🧠 Probing layer — knowledge gathering</div>\r\n            <div style=\"font-size:11.5px;color:var(--muted);margin-bottom:8px;\">The agent asks to clarify domain rules. Answers are saved to a Markdown knowledge base you can download and reuse.</div>\r\n            <div class=\"row\" id=\"probePills\"></div>\r\n            <div style=\"margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;\">\r\n              <input id=\"probeQ\" class=\"fsearch\" style=\"margin:0;flex:1;min-width:200px;\" placeholder=\"Question the agent is clarifying…\">\r\n              <select id=\"probeCat\" class=\"fsearch\" style=\"margin:0;width:150px;flex:0 0 auto;\">\r\n                <option value=\"General\">General</option>\r\n                <option value=\"Adherence rule\">Adherence rule</option>\r\n                <option value=\"Plan restatement\">Plan restatement</option>\r\n                <option value=\"CQN / mapping\">CQN / mapping</option>\r\n                <option value=\"Forecaster\">Forecaster</option>\r\n                <option value=\"Offering / Channel\">Offering / Channel</option>\r\n                <option value=\"Calendar / holiday\">Calendar / holiday</option>\r\n                <option value=\"Definition\">Definition</option>\r\n              </select>\r\n            </div>\r\n            <textarea id=\"probeA\" placeholder=\"Your answer / domain knowledge…\"></textarea>\r\n            <label class=\"fopt\" style=\"margin:6px 0 2px;\"><input type=\"checkbox\" id=\"probeCtx\" checked> Attach current queue/week context</label>\r\n            <div class=\"row\">\r\n              <button class=\"filebtn\" onclick=\"saveKnowledge()\">＋ Save to knowledge base</button>\r\n              <button class=\"filebtn ghost\" onclick=\"downloadKB()\">⬇ Download knowledge base (.md)</button>\r\n              <span class=\"status\" id=\"kbCount\">0 entries</span>\r\n            </div>\r\n            <div id=\"kbList\" style=\"margin-top:8px;\"></div>\r\n          </div>\r\n          -->\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============ INGESTION LOADING SCREEN ============ -->\r\n  <div id=\"ingestOverlay\" style=\"display:none;position:fixed;inset:0;z-index:9999;background:rgba(6,12,26,.72);align-items:center;justify-content:center;\">\r\n    <div style=\"background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:22px 26px;width:min(460px,92vw);box-shadow:0 24px 70px -24px rgba(0,0,0,.65);\">\r\n      <div style=\"font-size:15px;font-weight:800;\">Ingesting demand data…</div>\r\n      <div id=\"ingSub\" style=\"font-size:12px;color:var(--muted);margin:3px 0 13px;\">Starting…</div>\r\n      <div style=\"height:10px;background:var(--panel-2);border:1px solid var(--border);border-radius:6px;overflow:hidden;\"><i id=\"ingBar\" style=\"display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-2,#12986f));transition:width .3s;\"></i></div>\r\n      <div id=\"ingSteps\" style=\"margin-top:15px;display:grid;gap:8px;\"></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============ AFFECTED-QUEUES POPUP (opens on Fiscal Week select) ============ -->\r\n  <div id=\"affPopup\" style=\"display:none;position:fixed;inset:0;z-index:9998;background:rgba(6,12,26,.72);align-items:center;justify-content:center;\" onclick=\"if(event.target===this)closeAffPopup()\">\r\n    <div style=\"background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:18px 20px;width:min(780px,94vw);max-height:82vh;display:flex;flex-direction:column;box-shadow:0 24px 70px -24px rgba(0,0,0,.65);\">\r\n      <div style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px;\">\r\n        <div id=\"affPopupHead\" style=\"font-size:14.5px;font-weight:800;\"></div>\r\n        <button class=\"filebtn ghost\" onclick=\"closeAffPopup()\">✕ Close</button>\r\n      </div>\r\n      <div id=\"affPopupBody\" style=\"overflow:auto;\"></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============ DASHBOARD ============ -->\r\n  <div class=\"tab\" id=\"tab-dashboard\">\r\n    <h1>Dashboard</h1>\r\n    <div class=\"sub\">Volumetrics and demand-signal graphs for the loaded file. Reflects the filters set in the <b>RCA Console</b>. Only Actual/Forecast-offered figures are charted — nothing is inferred or invented.</div>\r\n    <div id=\"dashEmpty\" class=\"empty\">\r\n      <div style=\"font-size:34px;margin-bottom:8px;\">📊</div>\r\n      <b>No data loaded.</b><br>Upload the weekly demand file in the <b>RCA Console</b> tab — this dashboard populates automatically and follows your filters.\r\n    </div>\r\n    <div id=\"dashFilterWrap\" style=\"display:none;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:14px;\">\r\n      <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:700;margin-bottom:9px;\">Filter the dashboard — pick values and the graphs below show the affected (flagged) queues for that selection</div>\r\n      <div id=\"dashFilters\" style=\"display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;\"></div>\r\n    </div>\r\n    <div id=\"dashboardArea\" style=\"display:none;\"></div>\r\n  </div>\r\n\r\n  <!-- ============ TIMELINE (deadline Gantt) ============ -->\r\n  <div class=\"tab\" id=\"tab-timeline\">\r\n    <h1>Build Timeline — to 30 July</h1>\r\n    <div class=\"sub\">A simple week-by-week view of what we're building and when — goal: by <b>Thu 30 July 2026</b>, demo a tool that reads the weekly demand data, finds the off-forecast queues, and explains why. <b>Today is <span id=\"todayTxt\">—</span>.</b></div>\r\n\r\n    <div class=\"top\">\r\n      <div class=\"kpi\"><div class=\"v\">6 of 10</div><div class=\"l\">Steps finished</div></div>\r\n      <div class=\"kpi\"><div class=\"v\">1</div><div class=\"l\">In progress now</div></div>\r\n      <div class=\"kpi hot\"><div class=\"v\" id=\"kpiDays\">—</div><div class=\"l\" id=\"kpiDaysLbl\">Until the demo</div></div>\r\n      <div class=\"kpi\"><div class=\"v\">30 Jul</div><div class=\"l\">Demo day</div></div>\r\n    </div>\r\n    <div style=\"background:var(--panel);border:1px solid var(--border);border-radius:11px;padding:13px 16px;margin:0 0 16px;\">\r\n      <div style=\"display:flex;justify-content:space-between;font-size:12.5px;color:var(--muted);flex-wrap:wrap;gap:6px;\"><span><b style=\"color:var(--text)\">Overall progress</b></span><span><b style=\"color:var(--text)\">6 of 10</b> steps done · <b style=\"color:var(--text)\">1</b> in progress · <b style=\"color:var(--text)\">3</b> to go</span></div>\r\n      <div style=\"height:16px;background:var(--panel-2);border:1px solid var(--border);border-radius:9px;overflow:hidden;margin-top:9px;position:relative;\"><i style=\"display:block;height:100%;width:60%;background:linear-gradient(90deg,var(--done,#12986f),var(--accent));\"></i><b style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:800;color:var(--text);\">≈ 60% complete</b></div>\r\n    </div>\r\n\r\n    <div style=\"background:var(--panel-2);border:1px dashed var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;color:var(--muted);margin-bottom:12px;\"><b style=\"color:var(--text)\">How to read this:</b> each row is one build step; the coloured bar shows which days it runs (20–30 Jul across the top); the blue vertical line is <b>today</b>; grey columns are the weekend.</div>\r\n    <div class=\"glegend\">\r\n      <span><span class=\"gsw done\"></span> Done</span>\r\n      <span><span class=\"gsw prog\"></span> Working on it now</span>\r\n      <span><span class=\"gsw todo\"></span> Not started yet</span>\r\n      <span><span class=\"gsw ms\"></span> The demo (finish line)</span>\r\n      <span style=\"color:var(--accent);\">▏ = today (Wed 22 Jul)</span>\r\n    </div>\r\n\r\n    <div class=\"gantt\">\r\n      <div class=\"grid-head\">\r\n        <div class=\"lbl\">Step</div>\r\n        <div class=\"dh\" data-day=\"20\"><b>20</b>Mon</div><div class=\"dh\" data-day=\"21\"><b>21</b>Tue</div>\r\n        <div class=\"dh\" data-day=\"22\"><b>22</b>Wed</div><div class=\"dh\" data-day=\"23\"><b>23</b>Thu</div><div class=\"dh\" data-day=\"24\"><b>24</b>Fri</div>\r\n        <div class=\"dh wknd\" data-day=\"25\"><b>25</b>Sat</div><div class=\"dh wknd\" data-day=\"26\"><b>26</b>Sun</div>\r\n        <div class=\"dh\" data-day=\"27\"><b>27</b>Mon</div><div class=\"dh\" data-day=\"28\"><b>28</b>Tue</div><div class=\"dh\" data-day=\"29\"><b>29</b>Wed</div>\r\n        <div class=\"dh deadline\" data-day=\"30\"><b>30</b>Thu</div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">1 · Set up the data foundation<span class=\"gchip done\">Done</span></span><div class=\"d\">Agreed what the data looks like (33 columns) and the rule for a \"missed\" week (more than ±10% off).</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"todayline\" style=\"grid-column:3;\"></div>\r\n          <div class=\"bar done\" style=\"grid-column:1 / 4;\">✓ schema locked</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">2 · Make the accuracy number honest<span class=\"gchip done\">Done</span></span><div class=\"d\">A poor forecast now shows a low score. (Before, over/under misses cancelled out and it wrongly read ~99%.)</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar done\" style=\"grid-column:1 / 4;\">✓ calc fixed</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">3 · Open the weekly file in the browser<span class=\"gchip done\">Done</span></span><div class=\"d\">Load a CSV/Excel with 100,000+ rows right in the browser — nothing to install.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar done\" style=\"grid-column:1 / 4;\">✓ built</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">4 · Scan every queue &amp; flag the misses<span class=\"gchip done\">Done</span></span><div class=\"d\">Go through all ~100 queues and mark the weeks where the forecast was off beyond the ±band.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar done\" style=\"grid-column:1 / 5;\">✓ done</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">5 · RCA output — report per queue<span class=\"gchip prog\">Working on it now</span></span><div class=\"d\">The core deliverable: for each flagged queue, a clear report of <b>why</b> the forecast missed, plus a one-click summary of all flagged queues.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar prog\" style=\"grid-column:4 / 8;\">now → 26 Jul</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">6 · Charts &amp; volume views<span class=\"gchip done\">Done</span></span><div class=\"d\">A dashboard of graphs showing volumes and accuracy, sliceable by region, channel, country, etc.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar done\" style=\"grid-column:3 / 6;\">✓ dashboard</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">7 · Connect to the live database<span class=\"gchip done\">Done</span></span><div class=\"d\">Pull the data straight from the company SQL Server database — no more uploading a file by hand.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar done\" style=\"grid-column:3 / 6;\">✓ live</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">8 · Check with the expert &amp; set the tolerance<span class=\"gchip todo\">Not started</span></span><div class=\"d\">Run it on the full real data with the business expert (Prashant) and confirm the right ±% cut-off.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar todo\" style=\"grid-column:7 / 10;\">Jul 26–28</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">9 · Get the demo ready<span class=\"gchip todo\">Not started</span></span><div class=\"d\">Prepare the walkthrough, the summary export, and rehearse it once.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"bar todo\" style=\"grid-column:9 / 11;\">Jul 28–29</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grow\">\r\n        <div class=\"gname\"><span class=\"t\">10 · Show the working tool 🎯<span class=\"gchip todo\">Demo day</span></span><div class=\"d\">Present the finished tool running on real data — the 30 July deliverable.</div></div>\r\n        <div class=\"track\">\r\n          <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell wknd\"></div><div class=\"cell wknd\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\r\n          <div class=\"msq\" style=\"grid-column:11;\" title=\"30 July — Demo\"></div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <script>\r\n    (function(){\r\n      try{\r\n        var now=new Date(), deadline=new Date(2026,6,30);\r\n        var t0=new Date(now.getFullYear(),now.getMonth(),now.getDate());\r\n        var days=Math.round((deadline-t0)/86400000);\r\n        var DN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'], MN=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\r\n        var tt=document.getElementById('todayTxt'); if(tt) tt.textContent=DN[now.getDay()]+' '+now.getDate()+' '+MN[now.getMonth()]+' '+now.getFullYear();\r\n        var dk=document.getElementById('kpiDays'), dl=document.getElementById('kpiDaysLbl');\r\n        if(dk){ if(days>0){ dk.textContent=days; if(dl) dl.textContent=(days===1?'day until the demo':'days until the demo'); }\r\n                else if(days===0){ dk.textContent='Today'; if(dl) dl.textContent='is demo day'; }\r\n                else { dk.textContent=Math.abs(days); if(dl) dl.textContent='days since the demo'; } }\r\n        var inJul=(now.getFullYear()===2026 && now.getMonth()===6);\r\n        var col=inJul?(now.getDate()<20?1:(now.getDate()>30?11:now.getDate()-19)):(t0<deadline?1:11);\r\n        document.querySelectorAll('#tab-timeline .dh[data-day]').forEach(function(h){\r\n          h.classList.toggle('today', inJul && parseInt(h.getAttribute('data-day'),10)===now.getDate());\r\n        });\r\n        document.querySelectorAll('#tab-timeline .todayline').forEach(function(e){e.remove();});\r\n        document.querySelectorAll('#tab-timeline .track').forEach(function(tr){\r\n          var line=document.createElement('div'); line.className='todayline'; line.style.gridColumn=String(col);\r\n          tr.insertBefore(line, tr.firstChild);\r\n        });\r\n      }catch(e){}\r\n    })();\r\n    </script>\r\n\r\n    <div class=\"gnotes\">\r\n      <div class=\"card\">\r\n        <h3>Already in the bag (de-risks the deadline)</h3>\r\n        <ul>\r\n          <li><b>Upload for CSV &amp; Excel</b> — in-browser parse, handles 100k+ rows.</li>\r\n          <li><b>Two-metric RCA engine</b> — Forecast Accuracy + Plan Adherence, with ⓘ formula/number modal.</li>\r\n          <li><b>Avg accuracy fixed</b> — was a misleading ~99% (over/under cancel); now 100−MAPE (77.1% on full file).</li>\r\n          <li><b>Volumetrics + Dashboard graphs</b> across all 10 business dimensions, reactive to filters.</li>\r\n        </ul>\r\n      </div>\r\n      <div class=\"card\">\r\n        <h3>Critical path to 30 Jul</h3>\r\n        <ul>\r\n          <li><b>P4 Phase-1 digest</b> — multi-queue scan → top-N → printable report is the main remaining build.</li>\r\n          <li><b>P6 SQL Server (AA) connection</b> — live ingestion + server-side metric compute; the bridge from the file-upload mockup to production.</li>\r\n          <li><b>P7 validation with Prashant</b> must land by <b>28 Jul</b> to leave a buffer day.</li>\r\n          <li>Weekend (25–26 Jul) kept light — validation and packaging are weekday-anchored.</li>\r\n        </ul>\r\n      </div>\r\n      <div class=\"card risk\">\r\n        <h3>Risks &amp; dependencies</h3>\r\n        <ul>\r\n          <li><b>RCA calculation</b> — fixed &amp; verified (P2 done); downstream phases now unblocked.</li>\r\n          <li><b>Real full dataset access</b> — needed for P4/P6; slippage compresses validation.</li>\r\n          <li><b>Adherence band (±10% vs ±15%)</b> — confirm with Prashant before P6 tuning.</li>\r\n          <li>On-prem LLaMA narration is a later phase, not in the 30 Jul scope.</li>\r\n        </ul>\r\n      </div>\r\n      <div class=\"card\">\r\n        <h3>What the 30 Jul demo shows</h3>\r\n        <ul>\r\n          <li>Upload the real file → live scan → flagged queues + Dashboard volumetrics.</li>\r\n          <li>Open any flagged queue → data-backed root cause + volume metrics.</li>\r\n          <li>One-click <b>Phase-1 digest</b> of all flagged queues.</li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============ ARCHITECTURE ============ -->\r\n  <div class=\"tab\" id=\"tab-arch\">\r\n    <h1>Architecture — on the enterprise Agentic Platform</h1>\r\n    <div class=\"sub\">Every component maps to the client's existing Agentic Platform. Nothing built outside the approved stack. Code lives in client-hosted GitLab.</div>\r\n    <div class=\"cards g3\">\r\n      <div class=\"card\"><h4>① Discover</h4><ul><li><b>Agent Catalog</b> — register \"Demand Pattern RCA Agent\"</li><li><b>Tools Catalog (MCP)</b> — adherence, wow, plan-bias, peer, holiday, volume tools</li><li><b>Alation</b> — catalog demand_facts + metric defs</li></ul></div>\r\n      <div class=\"card\"><h4>② Security</h4><ul><li><b>Guardrails</b> — block unsafe I/O; reject numbers not backed by a tool</li><li><b>Kong</b> — SSO + API gateway on every call</li></ul></div>\r\n      <div class=\"card\"><h4>③·④ Agentic Platform</h4><ul><li><b>RCA agent</b> on <b>LangGraph</b></li><li>Connectors: SQL Server (source), ServiceNow (escalation)</li><li>Frameworks available: CrewAI · AutoGen · LangGraph</li></ul></div>\r\n      <div class=\"card\"><h4>⑤ LLMs &amp; Embeddings</h4><ul><li><b>On-prem LLaMA</b> (chosen) · Mistral · Gemini</li><li>In-network, no data egress</li></ul></div>\r\n      <div class=\"card\"><h4>⑥ Interoperability</h4><ul><li><b>MCP Server</b> hosts RCA tools</li><li><b>A2A protocol</b> for agent-to-agent</li></ul></div>\r\n      <div class=\"card\"><h4>⑦ Intent Orchestrator</h4><ul><li>Routes \"why did &lt;CQN&gt; miss?\" → RCA agent</li></ul></div>\r\n      <div class=\"card\"><h4>⑧ AI Ready Data</h4><ul><li>demand_facts + metric views (adherence, WoW, flags)</li><li>Source: SQL Server → AI Ready Data</li></ul></div>\r\n      <div class=\"card\"><h4>⑨ Agentic Memory</h4><ul><li>Session queue/week + confirmed known-causes (probing KB)</li></ul></div>\r\n      <div class=\"card\"><h4>⑩ Deploy · Publish · Observe</h4><ul><li><b>GitLab CI/CD</b> (client-hosted repos)</li><li>Langfuse · Splunk · Prometheus</li><li>Results → Data Mesh</li></ul></div>\r\n    </div>\r\n    <h2 class=\"sec\">Runtime flow</h2>\r\n    <div class=\"card\"><ul style=\"font-size:12.5px;color:var(--muted);margin:0;padding-left:16px;\">\r\n      <li>UI (custom, via Kong) → <b>Intent Orchestrator</b> receives intent</li>\r\n      <li><b>Guardrails</b> checks input → <b>RCA agent (LangGraph)</b> clarifies scope</li>\r\n      <li>Agent calls deterministic <b>MCP tools</b> → query <b>AI Ready Data</b></li>\r\n      <li>Reasons with <b>on-prem LLaMA</b>; remembers via <b>Agentic Memory</b></li>\r\n      <li>Output filtered by Guardrails → back through Kong → traced in Langfuse/Splunk</li>\r\n    </ul></div>\r\n  </div>\r\n\r\n  <!-- ============ TECH STACK ============ -->\r\n  <div class=\"tab\" id=\"tab-stack\">\r\n    <h1>Technology Stack</h1>\r\n    <div class=\"sub\">Everything constrained to the client's approved platform + client-hosted GitLab for source control.</div>\r\n    <div class=\"cards g3\">\r\n      <div class=\"card\"><h4>Data &amp; ingestion</h4><span class=\"tag\">SQL Server (source)</span><span class=\"tag\">AI Ready Data</span><span class=\"tag\">Data Mesh</span><span class=\"tag\">Pandera (validation)</span><span class=\"tag\">CSV / Excel upload</span></div>\r\n      <div class=\"card\"><h4>Storage &amp; metrics</h4><span class=\"tag g\">demand_facts table</span><span class=\"tag g\">SQL metric views</span><span class=\"tag g\">Alation catalog</span></div>\r\n      <div class=\"card\"><h4>Agent framework</h4><span class=\"tag p\">LangGraph ✓</span><span class=\"tag p\">CrewAI</span><span class=\"tag p\">AutoGen</span></div>\r\n      <div class=\"card\"><h4>AI models</h4><span class=\"tag\">LLaMA (on-prem) ✓</span><span class=\"tag\">Mistral</span><span class=\"tag\">Gemini</span><span class=\"tag w\">Llama Guard (guardrails, TBD)</span></div>\r\n      <div class=\"card\"><h4>Tooling &amp; interop</h4><span class=\"tag p\">MCP Server</span><span class=\"tag p\">A2A protocol</span><span class=\"tag p\">Intent Orchestrator</span><span class=\"tag p\">Agentic Memory</span></div>\r\n      <div class=\"card\"><h4>Security &amp; gateway</h4><span class=\"tag w\">Kong (auth + gateway)</span><span class=\"tag w\">Guardrails</span><span class=\"tag w\">SSO (Entra/Okta)</span></div>\r\n      <div class=\"card\"><h4>Source control (client env)</h4><span class=\"tag\">GitLab (client-hosted)</span><span class=\"tag\">GitLab CI/CD</span><span class=\"tag\">Merge-request review</span></div>\r\n      <div class=\"card\"><h4>Observability</h4><span class=\"tag\">Langfuse (LLM traces)</span><span class=\"tag\">Prometheus</span><span class=\"tag\">Splunk</span></div>\r\n      <div class=\"card\"><h4>UI</h4><span class=\"tag\">Custom UI via Kong</span><span class=\"tag\">Excel-style filters</span><span class=\"tag\">Bullet RCA + ⓘ math</span></div>\r\n    </div>\r\n    <h2 class=\"sec\">Guiding principles</h2>\r\n    <div class=\"card\"><ul style=\"font-size:12.5px;color:var(--muted);margin:0;padding-left:16px;\">\r\n      <li><b>LLM never does arithmetic</b> — every number comes from a deterministic (rule-based) tool; the ⓘ button shows that math.</li>\r\n      <li><b>Data never leaves the network</b> — model served on-prem; code in client GitLab.</li>\r\n      <li><b>Metrics &amp; rules are SQL/config specs</b> the business can sign off.</li>\r\n    </ul></div>\r\n  </div>\r\n\r\n  <!-- ============ AI MODELS ============ -->\r\n  <div class=\"tab\" id=\"tab-models\">\r\n    <h1>AI Models</h1>\r\n    <div class=\"sub\">Reasoning + narration layer. The RCA math itself is rule-based Python tool calls — the model orchestrates and explains, never invents numbers.</div>\r\n    <div class=\"cards g2\">\r\n      <div class=\"card\"><h4>LLaMA — on-prem <span class=\"tag g\">chosen</span></h4><ul><li>Open-weight, served in-network on GPU (vLLM / TGI)</li><li>No data egress — satisfies client data-residency</li><li>Role: scope clarification, driver narration, summary</li></ul></div>\r\n      <div class=\"card\"><h4>Mistral / Gemini <span class=\"tag\">alternatives</span></h4><ul><li>Mistral — on-prem alternative</li><li>Gemini — cloud; only if egress approved (not selected)</li></ul></div>\r\n      <div class=\"card\"><h4>Embeddings</h4><ul><li>For known-cause retrieval (RAG) over the probing knowledge base</li><li>Served alongside the on-prem model</li></ul></div>\r\n      <div class=\"card\"><h4>Guardrails model <span class=\"tag w\">TBD</span></h4><ul><li>Llama Guard-style input/output filter</li><li>Hard rule: reject any claim not backed by a tool result</li></ul></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============ DATA & FILES ============ -->\r\n  <div class=\"tab\" id=\"tab-data\">\r\n    <h1>Data &amp; Files</h1>\r\n    <div class=\"sub\">What we ingest, the grain, and the domain meaning of each field.</div>\r\n    <div class=\"cards g3\">\r\n      <div class=\"card\"><h4>File types accepted</h4><ul><li><b>.xlsx</b> (Excel) — parsed in-browser, no libraries</li><li><b>.csv / .tsv</b> — delimiter auto-detected</li><li>Weekly demand file + optional <b>CQN mapping file</b></li></ul></div>\r\n      <div class=\"card\"><h4>Grain &amp; key</h4><ul><li>Keyed on <b>Forecast_name × Fiscal_Week</b></li><li>Forecasting is based on <b>Forecast_name</b></li><li>Mapping file (optional) resolves sequence → Forecast_name</li></ul></div>\r\n      <div class=\"card\"><h4>Scale</h4><ul><li>~100 queues scanned weekly</li><li>Handles 100k+ rows with chunked parsing</li><li>Top-N affected queues surfaced</li></ul></div>\r\n      <div class=\"card\"><h4>Domain knowledge</h4><ul><li><b>Final_Y1–Y5</b> = installed units under warranty year 1–5 (demand driver, <i>not</i> prior-year actuals)</li><li><b>ASU</b> = Planned/Actual service driver (exact acronym to confirm)</li><li><b>Mon–Sun</b> = day-level holiday/weekend flags</li></ul></div>\r\n      <div class=\"card\"><h4>Scope</h4><ul><li>Keyed on <b>Forecast_name</b> — forecasting is per forecast_name</li><li>Priority: <b>2–3 forecast_names</b>, not the whole file</li><li>Filter to the target forecast_names, then read RCA</li></ul></div>\r\n      <div class=\"card\"><h4>Metrics (only these two)</h4><ul><li><b>Forecast Accuracy</b> = (Actual_Offered ÷ fcst_offered) × 100</li><li><b>Plan Adherence</b> = (1 − Actual_Offered ÷ fcst_offered) × 100 — signed (negative = under-forecast, positive = over-forecast)</li><li>Flag when |Plan Adherence deviation| &gt; band %</li></ul></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============ DEFINITIONS & FORMULAS ============ -->\r\n  <div class=\"tab\" id=\"tab-defs\">\r\n    <h1>Definitions &amp; Formulas</h1>\r\n    <div class=\"sub\">Field headings, meaning, and the exact formula each rule-based tool computes.</div>\r\n    <h2 class=\"sec\">Formulas — the only two computed</h2>\r\n    <table class=\"def\">\r\n      <tr><th>Metric</th><th>Excel</th><th>Python (rule-based tool)</th></tr>\r\n      <tr><td><b>Forecast Accuracy</b></td><td><code>=(Actual_Offered / fcst_offered) * 100</code></td><td><code>(actual_offered / fcst_offered) * 100</code></td></tr>\r\n      <tr><td><b>Forecast Adherence</b></td><td><code>=IF(Actual_Offered=\"\",\"\",(1-(Actual_Offered/fcst_offered))*100)</code></td><td><code>\"\" if actual_offered==\"\" else (1-(actual_offered/fcst_offered))*100</code></td></tr>\r\n    </table>\r\n    <div class=\"sub\" style=\"margin-top:10px;\">Forecast = <code>fcst_offered</code>. Keyed on <code>Forecast_name</code>. Both shown as %. <b>Forecast Accuracy</b> is the traditional formula; <b>Forecast Adherence</b> is the formula used in the current Excel system — <b>signed</b> (negative = actual ran above forecast / under-forecast, positive = actual ran below forecast / over-forecast). Flag = accuracy outside <b>±10%</b> (≡ |forecast-adherence| &gt; 10%). <b>No other formulas are computed</b> — nothing is inferred or invented.</div>\r\n    <h2 class=\"sec\">Field definitions</h2>\r\n    <table class=\"def\" id=\"defTable\">\r\n      <tr><th>Field</th><th>Meaning</th></tr>\r\n      <tr><td><code>Fiscal_Week</code></td><td>Fiscal calendar week the row belongs to (e.g. 202249) — the primary time key. The week starts on Saturday and Friday is the last working day; the fiscal year starts from the 1st week of February.</td></tr>\r\n      <tr><td><code>Week_Ending</code></td><td>Calendar date on which that fiscal week ends.</td></tr>\r\n      <tr><td><code>Region</code></td><td>Top-level geographic region of the queue (regions divided into AMER / AMERICAS — includes North America (NA) and Canada — and LATAM — includes Brazil and the rest of Latin America).</td></tr>\r\n      <tr><td><code>SubRegion</code></td><td>Sub-region within the region.</td></tr>\r\n      <tr><td><code>Country</code></td><td>Country of the queue.</td></tr>\r\n      <tr><td><code>Forecast_name</code></td><td>Name of the queue which supports a particular business.</td></tr>\r\n      <tr><td><code>Forecaster</code></td><td>Person / team that owns the forecast for the queue.</td></tr>\r\n      <tr><td><code>Offering</code></td><td>Product or service offering the demand belongs to (Basic, Premium, Pro kind of support).</td></tr>\r\n      <tr><td><code>Projection_plan_name</code></td><td>Forecast plan which is being considered for that particular period, which could be a week or a month.</td></tr>\r\n      <tr><td><code>channel</code></td><td>Contact / demand channel (e.g. Voice, Chat, Email, Case, Social Media).</td></tr>\r\n      <tr><td><code>business_org</code></td><td>Business organisation the queue rolls up to.</td></tr>\r\n      <tr><td><code>Actual_Offered</code></td><td>Actual offered volume.</td></tr>\r\n      <tr><td><code>Actual_Handled</code></td><td>Actual volume handled.</td></tr>\r\n      <tr><td><code>fcst_offered</code></td><td>Forecasted volume.</td></tr>\r\n      <tr><td><code>fcst_handled</code></td><td>Forecasted handled volume.</td></tr>\r\n      <tr><td><code>ASU</code></td><td>Active Serviceable Units currently in the market and covered under warranty.</td></tr>\r\n      <tr><td><code>Planned_ASU</code></td><td>Planned Active Serviceable Units (as per ASU plan).</td></tr>\r\n      <tr><td><code>Actual_ASU</code></td><td>Actual ASUs.</td></tr>\r\n      <tr><td><code>Final_Units</code></td><td>Installed base (warranty units) — a demand driver. Final_Y1 to Y5 overlap, so the sum of Final_Y1..Y5 is not equal to Final_Units: Y2 is a subset of Y1, Y3 a subset of Y2, Y4 a subset of Y3, and so on through Y5.</td></tr>\r\n      <tr><td><code>Final_Y5</code></td><td>Installed units under warranty in year 5.</td></tr>\r\n      <tr><td><code>Final_Y4</code></td><td>Installed units under warranty in year 4.</td></tr>\r\n      <tr><td><code>Final_Y3</code></td><td>Installed units under warranty in year 3.</td></tr>\r\n      <tr><td><code>Final_Y2</code></td><td>Installed units under warranty in year 2.</td></tr>\r\n      <tr><td><code>Final_Y1</code></td><td>Installed units under warranty in year 1.</td></tr>\r\n      <tr><td><code>Final_upp_units</code></td><td>Additional installed units under an upgrade / extended-protection plan (&ldquo;upp&rdquo; — confirm with business).</td></tr>\r\n      <tr><td><code>Holiday_Count</code></td><td>Number of holidays falling in the fiscal week.</td></tr>\r\n      <tr><td><code>Monday–Sunday</code></td><td>Day-level flag for each day of the week (holiday).</td></tr>\r\n      <tr><td><code>Volume_Category</code></td><td>Volume band the queue falls into (e.g. 501–1000).</td></tr>\r\n    </table>\r\n  </div>\r\n\r\n</div>\r\n\r\n<!-- INSIGHTS DRAWER (right-side, slidable + resizable) -->\r\n<div id=\"insDrawer\" class=\"ins-drawer open\">\r\n  <div class=\"ins-panel\">\r\n    <div class=\"ins-resize\" id=\"insResize\" title=\"Drag to resize\"></div>\r\n    <div class=\"ins-handle\" onclick=\"toggleInsights()\" title=\"Show / hide insights\"><span>💡 Insights</span></div>\r\n    <div class=\"ins-head\"><span>💡 Insights</span><button class=\"ins-x\" onclick=\"toggleInsights()\" title=\"Close\">✕</button></div>\r\n    <div class=\"ins-body\" id=\"insDrawerBody\"></div>\r\n  </div>\r\n</div>\r\n\r\n<!-- MATH MODAL -->\r\n<div class=\"modal-bg\" id=\"mathModal\" onclick=\"if(event.target===this)closeMath()\">\r\n  <div class=\"modal\">\r\n    <h3 id=\"mTitle\">Formula</h3>\r\n    <div class=\"msub\" id=\"mSub\"></div>\r\n    <div id=\"mBody\"></div>\r\n    <button class=\"mclose\" onclick=\"closeMath()\">Close</button>\r\n  </div>\r\n</div>\r\n\r\n<!-- SQL SERVER (AA) CONNECT MODAL -->\r\n<div class=\"modal-bg\" id=\"sqlModal\" onclick=\"if(event.target===this)closeSQL()\">\r\n  <div class=\"modal\">\r\n    <h3>🗄 Connect to SQL Server (AA)</h3>\r\n    <div class=\"msub\">Pull the weekly demand table straight from the AA data layer — the same pipeline the deployed agent uses. Metrics are computed on the ingested table, not invented.</div>\r\n    <div class=\"sqlf\"><label>Server</label><input id=\"sqlSrv\" value=\"10.10.9.75\"></div>\r\n    <div class=\"sqlf\"><label>Database</label><input id=\"sqlDb\" value=\"Playground\"></div>\r\n    <div class=\"sqlf\"><label>Table / view</label><input id=\"sqlTbl\" value=\"dbo.Input_To_ML\"></div>\r\n    <div class=\"sqlnote\">🔌 <b>Live:</b> click <b>Fetch table</b> to query SQL Server through the local backend (<code>/api/data</code>) and run the pipeline — no upload. Connection is set in <code>backend/config.json</code>; start it with <code>uvicorn sql_backend:app --port 8000</code>.</div>\r\n    <button class=\"mclose\" style=\"float:none\" onclick=\"sqlFetch()\">⇩ Fetch table &amp; run pipeline</button>\r\n    <button class=\"filebtn ghost\" style=\"margin-left:8px\" onclick=\"closeSQL()\">Cancel</button>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n/* ---------------- Tabs ---------------- */\r\ndocument.querySelectorAll('.nav a[data-tab]').forEach(a=>{\r\n  a.onclick=()=>{\r\n    document.querySelectorAll('.nav a[data-tab]').forEach(x=>x.classList.remove('active'));\r\n    a.classList.add('active');\r\n    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));\r\n    document.getElementById('tab-'+a.dataset.tab).classList.add('active');\r\n    window.scrollTo(0,0);\r\n    updateInsDrawer();\r\n  };\r\n});\r\nloadRcaModels();   // populate the per-queue AI model picker from the backend (no-op if backend is down)\r\n\r\n/* ---------------- Insights drawer (right-side, slidable + resizable, reserves layout space) ---------------- */\r\nfunction toggleInsights(){ document.getElementById('insDrawer').classList.toggle('open'); syncInsLayout(); }\r\nfunction updateInsDrawer(){\r\n  const onDash=document.querySelector('.nav a[data-tab=\"dashboard\"]').classList.contains('active');\r\n  const hasData=document.getElementById('insDrawerBody').innerHTML.trim().length>0;\r\n  document.getElementById('insDrawer').classList.toggle('avail', onDash && hasData);\r\n  syncInsLayout();\r\n}\r\n// body reserves right padding only while the panel is both available AND open, so the\r\n// dashboard reflows into the remaining width instead of being covered by the fixed panel.\r\nfunction syncInsLayout(){\r\n  const d=document.getElementById('insDrawer');\r\n  document.body.classList.toggle('ins-open', d.classList.contains('avail') && d.classList.contains('open'));\r\n}\r\n(function wireInsResize(){\r\n  const grip=document.getElementById('insResize'); if(!grip) return;\r\n  grip.addEventListener('mousedown',e=>{\r\n    e.preventDefault();\r\n    const startX=e.clientX;\r\n    const startW=parseFloat(getComputedStyle(document.querySelector('.ins-panel')).width)||360;\r\n    const move=ev=>{ let w=startW+(startX-ev.clientX); w=Math.max(300,Math.min(w,Math.min(680,window.innerWidth*0.5))); document.documentElement.style.setProperty('--insW',w+'px'); };\r\n    const up=()=>{ document.removeEventListener('mousemove',move); document.removeEventListener('mouseup',up); document.body.style.userSelect=''; };\r\n    document.body.style.userSelect='none';\r\n    document.addEventListener('mousemove',move); document.addEventListener('mouseup',up);\r\n  });\r\n})();\r\n\r\n/* ---------------- State ---------------- */\r\nlet ROWS=[], FLAGS=[], MAP=null, FILTERS={}, FOCUS=new Set();\r\nfunction applyFocus(){\r\n  const raw=document.getElementById('focusInput').value.split(',').map(s=>s.trim()).filter(Boolean);\r\n  FOCUS=new Set(raw.map(s=>s.toLowerCase()));\r\n  if(ROWS.length) applyAndScan();\r\n}\r\nfunction clearFocus(){ document.getElementById('focusInput').value=''; FOCUS=new Set(); if(ROWS.length) applyAndScan(); }\r\n// One click to any queue in the loaded data — no need to know or type an exact Forecast_name.\r\nfunction pickRandomQueue(){\r\n  if(!ROWS.length){ alert('Load data first.'); return; }\r\n  const names=[...new Set(ROWS.map(r=>r.Forecast_name).filter(Boolean))];\r\n  if(!names.length) return;\r\n  const pick=names[Math.floor(Math.random()*names.length)];\r\n  document.getElementById('focusInput').value=pick;\r\n  applyFocus();\r\n}\r\nconst FILTER_FIELDS=[\r\n  ['Fiscal_Week','Fiscal Week'],\r\n  ['Region','Region'],\r\n  ['SubRegion','Sub-Region'],\r\n  ['Country','Country'],\r\n  ['Forecast_name','Forecast Name'],\r\n  ['Forecaster','Forecaster'],\r\n  ['Offering','Offering'],\r\n  ['Projection_plan_name','Projection Plan'],\r\n  ['channel','Channel'],\r\n  ['business_org','Business Org']\r\n];\r\n// dimensions summarised in the volumetrics panel (same set the business selected)\r\nconst VOL_DIMS=FILTER_FIELDS;\r\nfunction fmt2(v){ const x=num(v); return x==null ? (v===''||v==null?'(blank)':String(v)) : x.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }\r\n\r\nfunction num(v){ if(v==null) return null; const x=parseFloat(String(v).replace(/,/g,'').trim()); return isNaN(x)?null:x; }\r\nfunction cqn(r){ return [r.Forecast_name,r.Region,r.SubRegion,r.Country,r.channel].filter(Boolean).join(' · '); }\r\n\r\n/* ---------------- SQL Server (AA) connect + ingestion pipeline ---------------- */\r\nfunction openSQL(){ document.getElementById('sqlModal').classList.add('show'); }\r\nfunction closeSQL(){ document.getElementById('sqlModal').classList.remove('show'); }\r\n// The authoritative CQN mapping, served from SQL by GET /api/cqn-mapping (table dbo.CQN_Mapping,\r\n// loaded by backend/upload_cqn_mapping.py). Sets the same MAP the file-upload path sets, so the\r\n// \"unmapped\" badges resolve with no manual step. Never throws: if the table is missing the console\r\n// simply behaves as it did before.\r\nlet CQN_ALL=null;              // Forecast_Name -> [every Combined Queue it belongs to]\r\nasync function loadCqnMappingFromSql(apiBase){\r\n  try{\r\n    const r=await fetch((apiBase||'')+'/api/cqn-mapping');\r\n    if(!r.ok) return false;\r\n    const j=await r.json();\r\n    if(!j.configured || !j.mapping || !Object.keys(j.mapping).length) return false;\r\n    MAP=j.mapping; CQN_ALL=j.all_queues||null;\r\n    const multi=(j.multi_queue_names||[]).length;\r\n    document.getElementById('mapBadge').innerHTML=\r\n      '<span class=\"badge ok\">CQN mapped from SQL · '+j.count+' queues</span>'+\r\n      (multi?' <span class=\"badge unm\" title=\"These forecast names belong to more than one Combined Queue (vendor-site splits); the first is shown.\">'+multi+' multi-queue</span>':'');\r\n    return true;\r\n  }catch(_){ return false; }\r\n}\r\n// Live: pull the weekly table from the local FastAPI backend (/api/data), which queries SQL Server.\r\nasync function sqlFetch(){\r\n  closeSQL();\r\n  const API_BASE=(typeof location!=='undefined' && location.protocol==='file:')?'http://localhost:8000':'';\r\n  window.SRC='sql';\r\n  const fs=document.getElementById('fileStatus');\r\n  if(fs) fs.textContent='Querying SQL Server (AA) …';\r\n  showIngest('Querying SQL Server (AA)…'); ingStep(0,10);\r\n  renderPipe({source:'sql'});\r\n  try{\r\n    ingStep(1,35,'Running query & downloading rows…'); await _tick();\r\n    const r=await fetch(API_BASE+'/api/data');\r\n    if(!r.ok){ let d; try{ d=(await r.json()).detail; }catch(_){ d=r.statusText; } throw new Error(d||('HTTP '+r.status)); }\r\n    const j=await r.json(); const rows=j.rows||[];\r\n    if(!rows.length) throw new Error('query returned 0 rows');\r\n    ingStep(2,58,'Building records…'); await _tick();\r\n    ROWS=rows;\r\n    // Pull the authoritative CQN mapping from SQL (dbo.CQN_Mapping) so queues are resolved to\r\n    // their real Combined Queue Name without needing a manual file upload. Silent no-op if the\r\n    // table has not been loaded — the \"Upload CQN mapping\" path still works as before.\r\n    await loadCqnMappingFromSql(API_BASE);\r\n    if(fs) fs.innerHTML='🗄 <b>SQL Server (AA)</b> · '+((j.table)||'dbo.Input_To_ML')+' — '+rows.length.toLocaleString()+' rows';\r\n    document.getElementById('emptyState').style.display='none';\r\n    document.getElementById('consoleArea').style.display='block';\r\n    renderPipe({source:'sql', rows:rows.length});\r\n    ingStep(3,74,'Computing the two metrics…'); await _tick();\r\n    buildFilters(); buildDashFilters();\r\n    ingStep(4,90,'Flagging misses…'); await _tick();\r\n    applyAndScan();\r\n    ingStep(6,100,'Done'); await _tick();\r\n    hideIngest();\r\n  }catch(e){\r\n    hideIngest();\r\n    if(fs) fs.textContent='SQL error: '+e.message; renderPipe({source:'sql'});\r\n    alert('Connect to SQL Server failed: '+e.message+'\\n\\nStart the local backend first:\\n  cd backend\\n  uvicorn sql_backend:app --port 8000\\n\\n(connection is configured in backend/config.json)');\r\n  }\r\n}\r\nfunction pstage(cls,icon,title,val){ return `<div class=\"pstage ${cls}\"><div class=\"pi\">${icon}</div><div class=\"pt\">${title}</div><div class=\"pv\">${val}</div></div>`; }\r\n// Visualises the full path: source → ingest → compute (2 metrics) → flag (±band) → RCA. Fills as data flows.\r\nfunction renderPipe(st){\r\n  st=st||{}; const el=document.getElementById('pipe'); if(!el) return;\r\n  const src=st.source, rows=st.rows, comp=st.computable, flg=st.flagged, ready=st.ready;\r\n  el.innerHTML=\r\n    pstage(src?'done':'pending', src==='sql'?'🗄':'📄', 'Source', src==='sql'?'SQL Server (AA)':src==='file'?'File upload':'—')+\r\n    pstage(rows?'done':'pending', '📥', 'Ingest', rows?rows.toLocaleString()+' rows':'—')+\r\n    pstage(comp!=null?'done':'pending', '🧮', 'Compute · 2 metrics', comp!=null?comp.toLocaleString()+' scored':'—')+\r\n    pstage(rows?'done':'pending', '🚩', 'Flag · ±band', flg!=null?flg.toLocaleString()+' flagged':'—')+\r\n    pstage(ready?'done':(rows?'active':'pending'), '🔍', 'RCA', ready?'ready':(rows?'scanning…':'—'));\r\n}\r\n\r\n/* ---------------- Ingestion loading screen ---------------- */\r\nconst INGEST_STEPS=['Read source (file / SQL Server)','Parse rows','Build records','Compute the two metrics','Flag misses (±band)','Render dashboard & report'];\r\nconst _tick=()=>new Promise(r=>setTimeout(r,45));\r\nfunction showIngest(sub){\r\n  const host=document.getElementById('ingSteps'); if(!host) return;\r\n  host.innerHTML=INGEST_STEPS.map((s,i)=>`<div id=\"ings-${i}\" style=\"display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--muted);\"><span class=\"ingdot\" style=\"width:17px;height:17px;border-radius:50%;border:2px solid var(--border);display:inline-flex;align-items:center;justify-content:center;font-size:9px;flex:0 0 auto;\">${i+1}</span><span>${s}</span></div>`).join('');\r\n  const sb=document.getElementById('ingSub'); if(sb) sb.textContent=sub||'Starting…';\r\n  const bar=document.getElementById('ingBar'); if(bar) bar.style.width='0';\r\n  const ov=document.getElementById('ingestOverlay'); if(ov) ov.style.display='flex';\r\n}\r\nfunction ingStep(active,pct,note){\r\n  for(let k=0;k<INGEST_STEPS.length;k++){\r\n    const row=document.getElementById('ings-'+k); if(!row) continue;\r\n    const dot=row.querySelector('.ingdot');\r\n    if(k<active){ dot.style.background='var(--accent-2,#12986f)'; dot.style.borderColor='var(--accent-2,#12986f)'; dot.style.color='#fff'; dot.textContent='✓'; row.style.color='var(--text)'; row.style.fontWeight='400'; }\r\n    else if(k===active){ dot.style.borderColor='var(--accent)'; dot.style.color='var(--accent)'; dot.textContent=String(k+1); row.style.color='var(--text)'; row.style.fontWeight='700'; }\r\n    else { dot.style.background='transparent'; dot.style.borderColor='var(--border)'; dot.style.color='var(--muted)'; dot.textContent=String(k+1); row.style.color='var(--muted)'; row.style.fontWeight='400'; }\r\n  }\r\n  if(pct!=null){ const bar=document.getElementById('ingBar'); if(bar) bar.style.width=pct+'%'; }\r\n  if(note){ const sb=document.getElementById('ingSub'); if(sb) sb.textContent=note; }\r\n}\r\nfunction hideIngest(){ const ov=document.getElementById('ingestOverlay'); if(ov) ov.style.display='none'; }\r\n\r\n/* ---------------- Dashboard dropdown filters (drive the same scan engine) ---------------- */\r\nconst DASH_FILTER_FIELDS=[['Region','Region'],['SubRegion','Sub-Region'],['Country','Country'],['channel','Channel'],['Offering','Offering'],['Forecaster','Forecaster'],['Projection_plan_name','Projection plan']];\r\nfunction buildDashFilters(){\r\n  const host=document.getElementById('dashFilters'); if(!host) return;\r\n  const fws=distinctValues('Fiscal_Week');\r\n  // Fiscal Week — typeable (Excel-style): type a week, a partial (2024 → all FY24 weeks), a comma list, or a range 202401-202410.\r\n  const fwHtml=`<label style=\"display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted);\"><span style=\"display:inline-flex;align-items:center;gap:5px;\">Fiscal Week <span onclick=\"fwInfo()\" title=\"Type or pick a Fiscal Week and press Enter — a popup lists the affected (flagged) queues for that week: names, adherence %, band and direction.\" style=\"cursor:pointer;display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;border:1px solid var(--muted);color:var(--muted);font-size:10px;font-weight:800;flex:0 0 auto;\">i</span></span> <span style=\"opacity:.65\">type / range e.g. 202401-202410 · Enter → affected queues</span>\r\n      <input list=\"dashFwList\" id=\"dashFwInput\" placeholder=\"All weeks — type to filter\" onchange=\"dashFwApply(this)\" onkeydown=\"if(event.key==='Enter'){dashFwApply(this);}\" style=\"min-width:230px;background:var(--panel-2);color:var(--text);border:1px solid var(--border);border-radius:7px;padding:6px 8px;font-size:12px;\">\r\n      <datalist id=\"dashFwList\">${fws.map(w=>`<option value=\"${w}\"></option>`).join('')}</datalist></label>`;\r\n  const sels=DASH_FILTER_FIELDS.map(([f,l])=>{\r\n    const vals=distinctValues(f);\r\n    return `<label style=\"display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted);\">${l}\r\n      <select data-f=\"${f}\" onchange=\"dashFilterChange(this)\" style=\"min-width:132px;background:var(--panel-2);color:var(--text);border:1px solid var(--border);border-radius:7px;padding:6px 8px;font-size:12px;\">\r\n        <option value=\"\">(All)</option>${vals.map(v=>`<option value=\"${String(v).replace(/\"/g,'&quot;')}\">${v}</option>`).join('')}\r\n      </select></label>`;\r\n  }).join('');\r\n  host.innerHTML=fwHtml+sels+`<button class=\"filebtn ghost\" style=\"align-self:flex-end;\" onclick=\"dashFiltersReset()\">↻ Reset</button>`;\r\n  const wrap=document.getElementById('dashFilterWrap'); if(wrap) wrap.style.display='block';\r\n}\r\nfunction dashFilterChange(sel){\r\n  const f=sel.getAttribute('data-f'), v=sel.value;\r\n  FILTERS[f]= v ? new Set([v]) : null;\r\n  applyAndScan();               // recomputes flagged/affected queues within the new scope, re-renders the dashboard graphs\r\n}\r\nfunction dashFwApply(inp){\r\n  const raw=(inp.value||'').trim();\r\n  if(!raw){ FILTERS['Fiscal_Week']=null; applyAndScan(); return; }\r\n  const all=distinctValues('Fiscal_Week'); const sel=new Set();\r\n  raw.split(',').map(s=>s.trim()).filter(Boolean).forEach(tok=>{\r\n    const rng=tok.match(/^(\\d+)\\s*[-–]\\s*(\\d+)$/);           // range: 202401-202410 (fixed-width YYYYWW → lexicographic = numeric)\r\n    if(rng){ const lo=rng[1], hi=rng[2]; all.forEach(w=>{ if(w>=lo && w<=hi) sel.add(w); }); }\r\n    else { all.forEach(w=>{ if(w===tok || w.indexOf(tok)>=0) sel.add(w); }); }   // exact or partial (type-ahead)\r\n  });\r\n  FILTERS['Fiscal_Week']=sel;   // matched weeks; if nothing matched the set is empty → no rows (Excel behaviour)\r\n  applyAndScan();\r\n  openAffPopup();               // show the affected queues (real names) for the selected week(s)\r\n}\r\nfunction dashFiltersReset(){\r\n  DASH_FILTER_FIELDS.forEach(([f])=>{ FILTERS[f]=null; });\r\n  FILTERS['Fiscal_Week']=null;\r\n  document.querySelectorAll('#dashFilters select').forEach(s=>s.value='');\r\n  const fwi=document.getElementById('dashFwInput'); if(fwi) fwi.value='';\r\n  applyAndScan();\r\n}\r\n/* Affected-queues popup — lists the real flagged forecast names for the current scope.\r\n   Every value comes straight from the computed rows (FLAGS); nothing is inferred or invented. */\r\nfunction bandLabel(v){ const d=Math.abs(v); if(d<=5)return'±5%'; if(d<=10)return'±5–10%'; if(d<=15)return'±10–15%'; if(d<=20)return'±15–20%'; if(d<=25)return'±20–25%'; return'>±25%'; }\r\nfunction escHtml(s){ return String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c])); }\r\nfunction openAffPopup(){\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const list=(FLAGS||[]).filter(r=>r&&r._padh!=null&&Math.abs(+r._padh.toFixed(1))>band).slice().sort((a,b)=>Math.abs(b._padh)-Math.abs(a._padh));\r\n  const fwi=document.getElementById('dashFwInput'); const fwTxt=(fwi&&fwi.value)?fwi.value:'(current filter)';\r\n  const head=document.getElementById('affPopupHead'), body=document.getElementById('affPopupBody'); if(!head||!body) return;\r\n  head.innerHTML=`Affected queues — Fiscal Week <b>${escHtml(fwTxt)}</b> <span style=\"color:var(--muted);font-weight:600;font-size:12px;\">· ${list.length} beyond ±${band}%</span>`;\r\n  if(!list.length){ body.innerHTML=`<div class=\"empty\" style=\"border:none;\">No affected queues — every forecast name is within ±${band}% for this selection.</div>`; }\r\n  else {\r\n    body.innerHTML=`<table style=\"width:100%;border-collapse:collapse;font-size:12.5px;\"><thead><tr style=\"text-align:left;color:var(--muted);\"><th style=\"padding:6px 8px;\">#</th><th style=\"padding:6px 8px;\">Forecast name (queue)</th><th style=\"padding:6px 8px;\">Fiscal Week</th><th style=\"padding:6px 8px;text-align:right;\">Forecast Adherence</th><th style=\"padding:6px 8px;\">Band</th><th style=\"padding:6px 8px;\">Direction</th></tr></thead><tbody>`+\r\n      list.map((r,i)=>{ const p=r._padh; const dir=p<0?'under-forecast (actual ran above)':(p>0?'over-forecast (actual ran below)':'on plan'); const col=Math.abs(p)>25?'var(--danger)':'#c96a10'; return `<tr style=\"border-top:1px solid var(--border);\"><td style=\"padding:6px 8px;color:var(--muted);\">${i+1}</td><td style=\"padding:6px 8px;font-weight:600;\">${escHtml(r.Forecast_name||'(blank)')}</td><td style=\"padding:6px 8px;\">${escHtml(r._wk)}</td><td style=\"padding:6px 8px;text-align:right;font-variant-numeric:tabular-nums;color:${col};\">${p>0?'+':''}${p.toFixed(1)}%</td><td style=\"padding:6px 8px;\">${bandLabel(p)}</td><td style=\"padding:6px 8px;color:var(--muted);\">${dir}</td></tr>`; }).join('')+\r\n      `</tbody></table>`;\r\n  }\r\n  const pop=document.getElementById('affPopup'); if(pop) pop.style.display='flex';\r\n}\r\nfunction closeAffPopup(){ const p=document.getElementById('affPopup'); if(p) p.style.display='none'; }\r\nfunction fwInfo(){\r\n  const fwi=document.getElementById('dashFwInput');\r\n  if(fwi && fwi.value.trim()){ openAffPopup(); return; }   // a week is picked → just show the affected queues\r\n  alert('Fiscal Week → Affected queues\\n\\nType or pick a Fiscal Week and press Enter. A popup then lists the affected (flagged) queues for that week — their names, Forecast Adherence %, severity band and direction (over/under-forecast). All names come straight from the data.');\r\n}\r\nif(typeof document!=='undefined' && !window.__affEsc){ window.__affEsc=true; document.addEventListener('keydown',e=>{ if(e.key==='Escape') closeAffPopup(); }); }\r\n\r\n/* ---------------- Parsing (CSV / TSV / XLSX) ---------------- */\r\nfunction detectDelim(t){const fl=(t.split(/\\r?\\n/)[0]||'');const a=(fl.match(/\\t/g)||[]).length,c=(fl.match(/,/g)||[]).length,s=(fl.match(/;/g)||[]).length;if(a>=c&&a>=s&&a>0)return '\\t';if(s>c)return ';';return ',';}\r\nfunction parseDelimited(text,d){\r\n  if(text.indexOf('\"')===-1){const o=[];const ls=text.split(/\\r?\\n/);for(let i=0;i<ls.length;i++)if(ls[i].length)o.push(ls[i].split(d));return o;}\r\n  const rows=[];let row=[],cur='',q=false;\r\n  for(let i=0;i<text.length;i++){const ch=text[i];\r\n    if(q){if(ch==='\"'){if(text[i+1]==='\"'){cur+='\"';i++;}else q=false;}else cur+=ch;}\r\n    else{if(ch==='\"')q=true;else if(ch===d){row.push(cur);cur='';}else if(ch==='\\n'){row.push(cur);rows.push(row);row=[];cur='';}else if(ch==='\\r'){}else cur+=ch;}}\r\n  if(cur.length||row.length){row.push(cur);rows.push(row);}\r\n  return rows.filter(r=>r.some(c=>c!==''));\r\n}\r\nfunction colIndex(ref){const m=(ref||'').match(/^[A-Z]+/);if(!m)return -1;let x=0;for(const c of m[0])x=x*26+(c.charCodeAt(0)-64);return x-1;}\r\nfunction decodeEnt(s){if(s.indexOf('&')===-1)return s;return s.replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&apos;/g,\"'\").replace(/&#x([0-9a-fA-F]+);/g,(_,h)=>String.fromCodePoint(parseInt(h,16))).replace(/&#(\\d+);/g,(_,d)=>String.fromCodePoint(parseInt(d,10))).replace(/&amp;/g,'&');}\r\nasync function inflateRaw(u8){const ds=new DecompressionStream('deflate-raw');const st=new Blob([u8]).stream().pipeThrough(ds);return new Uint8Array(await new Response(st).arrayBuffer());}\r\nfunction parseShared(xml){const a=[];if(!xml)return a;const si=/<si\\b[^>]*>([\\s\\S]*?)<\\/si>/g,t=/<t\\b[^>]*>([\\s\\S]*?)<\\/t>/g;let m;while((m=si.exec(xml))){let s='';t.lastIndex=0;let tm;while((tm=t.exec(m[1])))s+=decodeEnt(tm[1]);a.push(s);}return a;}\r\nfunction parseRow(inner,shared){const arr=[];const cRe=/<c\\b([^>]*?)(?:\\/>|>([\\s\\S]*?)<\\/c>)/g;let cm;while((cm=cRe.exec(inner))){const at=cm[1]||'',bd=cm[2];const rM=at.match(/r=\"([A-Z]+)\\d+\"/);const ci=rM?colIndex(rM[1]):-1;const tM=at.match(/t=\"([^\"]+)\"/);const t=tM?tM[1]:null;let v='';if(bd!==undefined){if(t==='s'){const vM=bd.match(/<v>([\\s\\S]*?)<\\/v>/);const idx=vM?parseInt(vM[1],10):-1;v=(idx>=0&&shared[idx]!=null)?shared[idx]:'';}else if(t==='inlineStr'){const tR=/<t\\b[^>]*>([\\s\\S]*?)<\\/t>/g;let tm;while((tm=tR.exec(bd)))v+=decodeEnt(tm[1]);}else{const vM=bd.match(/<v>([\\s\\S]*?)<\\/v>/);v=vM?decodeEnt(vM[1]):'';}}if(ci>=0)arr[ci]=v;else arr.push(v);}for(let i=0;i<arr.length;i++)if(arr[i]===undefined)arr[i]='';return arr;}\r\nasync function parseXlsx(buf){\r\n  const dv=new DataView(buf),u8=new Uint8Array(buf),dec=new TextDecoder();\r\n  let e=-1;for(let i=u8.length-22;i>=0&&i>u8.length-65558;i--){if(dv.getUint32(i,true)===0x06054b50){e=i;break;}}\r\n  if(e<0)throw new Error('Not a valid .xlsx');\r\n  const cdo=dv.getUint32(e+16,true),cdc=dv.getUint16(e+10,true);const ent={};let p=cdo;\r\n  for(let k=0;k<cdc;k++){if(dv.getUint32(p,true)!==0x02014b50)break;const meth=dv.getUint16(p+10,true),cs=dv.getUint32(p+20,true),nl=dv.getUint16(p+28,true),el=dv.getUint16(p+30,true),cl=dv.getUint16(p+32,true),lo=dv.getUint32(p+42,true);const nm=dec.decode(u8.subarray(p+46,p+46+nl)).replace(/\\\\/g,'/');ent[nm]={meth,cs,lo};p+=46+nl+el+cl;}\r\n  async function read(n){const x=ent[n];if(!x)return null;const nl=dv.getUint16(x.lo+26,true),el=dv.getUint16(x.lo+28,true),st=x.lo+30+nl+el;const d=u8.subarray(st,st+x.cs);let out;if(x.meth===0)out=d;else if(x.meth===8)out=await inflateRaw(d);else throw new Error('zip method');return dec.decode(out);}\r\n  const shared=parseShared(await read('xl/sharedStrings.xml'));\r\n  let sn='xl/worksheets/sheet1.xml';if(!ent[sn]){const k=Object.keys(ent).find(x=>/^xl\\/worksheets\\/sheet\\d+\\.xml$/.test(x));if(k)sn=k;}\r\n  const sx=await read(sn);if(!sx)throw new Error('no sheet');\r\n  const rows=[];const rr=/<row\\b[^>]*>([\\s\\S]*?)<\\/row>/g;let m;while((m=rr.exec(sx)))rows.push(parseRow(m[1],shared));return rows;\r\n}\r\nfunction buildRows(arrays){if(!arrays||arrays.length<2)return[];const h=arrays[0].map(x=>String(x==null?'':x).trim());const o=[];for(let i=1;i<arrays.length;i++){const c=arrays[i];if(!c||!c.length)continue;const r={};for(let j=0;j<h.length;j++)if(h[j])r[h[j]]=(c[j]!==undefined?String(c[j]).trim():'');o.push(r);}return o;}\r\nasync function fileToArrays(file){const nm=(file.name||'').toLowerCase();if(nm.endsWith('.xlsx'))return parseXlsx(await file.arrayBuffer());if(nm.endsWith('.xls'))throw new Error('Legacy .xls not supported — save as .xlsx/.csv');const t=await file.text();return parseDelimited(t,detectDelim(t));}\r\n\r\n/* ---------------- Upload handlers ---------------- */\r\nasync function onWeekly(file){\r\n  if(!file)return;\r\n  const src=window._pendingSrc||'file'; window.SRC=src; window._pendingSrc=null;\r\n  showIngest(src==='sql'?'Querying SQL Server (AA)…':'Reading '+file.name+'…'); ingStep(0,8);\r\n  document.getElementById('fileStatus').textContent=(src==='sql'?'Querying SQL Server (AA) → ':'Reading ')+file.name+' …';\r\n  renderPipe({source:src});\r\n  try{\r\n    ingStep(1,28,'Parsing rows…'); await _tick();\r\n    const arrays=await fileToArrays(file);\r\n    ingStep(2,52,'Building records…'); await _tick();\r\n    const rows=buildRows(arrays);\r\n    if(!rows.length)throw new Error('no rows');\r\n    ROWS=rows;\r\n    document.getElementById('fileStatus').innerHTML=(src==='sql'?'🗄 <b>SQL Server (AA)</b> · dbo.demand_facts — ':'<b>'+file.name+'</b> — ')+rows.length.toLocaleString()+' rows';\r\n    document.getElementById('emptyState').style.display='none';\r\n    document.getElementById('consoleArea').style.display='block';\r\n    renderPipe({source:src, rows:rows.length});\r\n    ingStep(3,72,'Computing the two metrics…'); await _tick();\r\n    buildFilters(); buildDashFilters();\r\n    ingStep(4,88,'Flagging misses…'); await _tick();\r\n    applyAndScan();\r\n    ingStep(6,100,'Done'); await _tick();\r\n    hideIngest();\r\n  }catch(e){ hideIngest(); document.getElementById('fileStatus').textContent='Error: '+e.message; renderPipe({source:src}); alert('Could not read weekly file: '+e.message); }\r\n}\r\nasync function onMapping(file){\r\n  if(!file)return;\r\n  try{\r\n    const arr=await fileToArrays(file);\r\n    MAP={}; for(let i=1;i<arr.length;i++){ if(arr[i][0]) MAP[String(arr[i][0]).trim()]=String(arr[i][1]!==undefined?arr[i][1]:'').trim(); }\r\n    document.getElementById('mapBadge').innerHTML='<span class=\"badge ok\">CQN mapped · '+Object.keys(MAP).length+' entries</span>';\r\n    if(ROWS.length) applyAndScan();\r\n  }catch(e){ alert('Could not read mapping file: '+e.message); }\r\n}\r\n\r\n/* ---------------- Filters (Excel-style) ---------------- */\r\nfunction distinctValues(field){\r\n  const s=new Set();\r\n  ROWS.forEach(r=>{ const v=r[field]; if(v!=null&&v!=='') s.add(String(v)); });\r\n  return [...s].sort();\r\n}\r\nfunction buildFilters(){\r\n  FILTERS={};\r\n  const host=document.getElementById('filterGroups'); host.innerHTML='';\r\n  FILTER_FIELDS.forEach(([field,label])=>{\r\n    FILTERS[field]=null; // null = All\r\n    const vals=distinctValues(field);\r\n    const g=document.createElement('div'); g.className='fgroup';\r\n    g.innerHTML=`<div class=\"ft\" onclick=\"this.parentNode.classList.toggle('collapsed')\">${label}<span>▾</span></div>\r\n      <div class=\"fbody\">\r\n        <input class=\"fsearch\" placeholder=\"Search ${label}…\" oninput=\"filterSearch('${field}',this.value)\">\r\n        <label class=\"fopt\"><input type=\"checkbox\" checked onchange=\"toggleAll('${field}',this.checked)\"> <b>(All)</b></label>\r\n        <div class=\"fopts\" id=\"fopts-${field}\">\r\n          ${vals.map(v=>`<label class=\"fopt\" data-v=\"${v.replace(/\"/g,'&quot;')}\"><input type=\"checkbox\" onchange=\"toggleOpt('${field}','${v.replace(/'/g,\"\\\\'\")}',this.checked)\"> ${v}</label>`).join('')}\r\n        </div>\r\n      </div>`;\r\n    host.appendChild(g);\r\n    if(field==='Forecast_name'){\r\n      const dl=document.getElementById('fnList');\r\n      if(dl) dl.innerHTML=vals.map(v=>`<option value=\"${v.replace(/\"/g,'&quot;')}\">`).join('');\r\n    }\r\n  });\r\n}\r\nfunction filterSearch(field,q){ q=q.toLowerCase(); document.querySelectorAll('#fopts-'+field+' .fopt').forEach(el=>{ el.style.display=el.getAttribute('data-v').toLowerCase().includes(q)?'flex':'none'; }); }\r\nfunction toggleAll(field,on){\r\n  FILTERS[field]= on?null:new Set();\r\n  document.querySelectorAll('#fopts-'+field+' input').forEach(cb=>cb.checked=false);\r\n  applyAndScan();\r\n}\r\nfunction toggleOpt(field,val,on){\r\n  if(FILTERS[field]==null) FILTERS[field]=new Set();\r\n  if(on) FILTERS[field].add(val); else FILTERS[field].delete(val);\r\n  // if none selected -> treat as All\r\n  const allCb=document.querySelector('#fopts-'+field).parentNode.querySelector('.fopt input');\r\n  if(FILTERS[field].size===0){ FILTERS[field]=null; allCb.checked=true; } else allCb.checked=false;\r\n  applyAndScan();\r\n}\r\nfunction resetFilters(){ buildFilters(); applyAndScan(); }\r\nfunction toggleFilters(){ const f=document.getElementById('filters'); const c=f.classList.toggle('collapsed'); document.getElementById('filtChev').textContent=c?'▸':'▾'; }\r\nfunction passFilters(r){\r\n  if(FOCUS.size && !FOCUS.has(String(r.Forecast_name||'').toLowerCase())) return false;\r\n  for(const [field] of FILTER_FIELDS){\r\n    const sel=FILTERS[field]; if(!sel) continue;\r\n    if(!sel.has(String(r[field]))) return false;\r\n  }\r\n  return true;\r\n}\r\n\r\n/* ---------------- Scan (ONLY the two specified formulas, keyed on Forecast_name) ---------------- */\r\nfunction applyAndScan(){\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const rows=ROWS.filter(passFilters);\r\n  rows.forEach(r=>{\r\n    r._ao=num(r.Actual_Offered); r._fo=num(r.fcst_offered);\r\n    // Forecast Accuracy = Actual_Offered / fcst_offered * 100   (Forecast = fcst_offered)\r\n    r._acc=(r._ao!=null&&r._fo!=null&&r._fo>0)? r._ao/r._fo*100 : null;\r\n    // Forecast Adherence = (1 - Actual_Offered/fcst_offered) * 100 ; blank if no actual\r\n    // Signed: negative = actual ran ABOVE forecast (under-forecast); positive = actual ran BELOW forecast (over-forecast).\r\n    // Flagging/severity/MAPE below compare on Math.abs(r._padh) — the ±band test is about MAGNITUDE, the displayed number stays signed so direction is visible.\r\n    r._padh=(r.Actual_Offered===''||r._ao==null)? null : ((r._fo!=null&&r._fo>0)? (1-(r._ao/r._fo))*100 : null);\r\n    r._noF=(r._ao!=null&&(r._fo==null||r._fo<=0));   // actual present but no/zero forecast → undefined\r\n    r._key=String(r.Forecast_name||''); r._wk=String(r.Fiscal_Week||'');\r\n    r._mapped = MAP ? (MAP[r.Forecast_name]!=null) : false;\r\n  });\r\n  const groups={};\r\n  rows.forEach(r=>{ (groups[r._key]=groups[r._key]||[]).push(r); });\r\n  Object.values(groups).forEach(g=>{ g.sort((a,b)=>a._wk.localeCompare(b._wk)); g.forEach(r=>r._group=g); });\r\n  // Only computable rows (valid actual + forecast). Zero/blank forecast rows are data gaps — never shown as results.\r\n  const computable=rows.filter(r=>!r._noF && r._padh!=null);\r\n  window._noFCount=rows.length-computable.length;\r\n  const flaggedCount=computable.filter(r=> Math.abs(+r._padh.toFixed(1)) > band).length;   // ±band% on accuracy ≡ |plan-adh| > band%\r\n  if(FOCUS.size){\r\n    // Testing mode: show EVERY computable week for the focused Forecast_name(s), chronological.\r\n    FLAGS=computable.slice().sort((a,b)=> a._key.localeCompare(b._key) || a._wk.localeCompare(b._wk));\r\n  } else {\r\n    // Default: only weeks outside the ±band (worst first, by magnitude — the signed value can be negative), on the displayed 1-dp value.\r\n    FLAGS=computable.filter(r=> Math.abs(+r._padh.toFixed(1)) > band).sort((a,b)=> Math.abs(b._padh) - Math.abs(a._padh));\r\n  }\r\n  const avgAcc=setAccuracy(rows);\r\n  renderMetrics(groups,rows,flaggedCount,avgAcc);\r\n  // stash for the dashboard's drill-down (which re-renders without re-scanning); a filter change resets the drill.\r\n  window._lastRows=rows; window._lastGroups=groups; window._lastFlagged=flaggedCount; window._lastAcc=avgAcc; DRILL=[];\r\n  renderPipe({source:window.SRC||'file', rows:ROWS.length, computable:computable.length, flagged:flaggedCount, ready:true});\r\n  renderDashboard(rows,groups,flaggedCount,avgAcc);\r\n  renderContextProbes(rows,groups);\r\n  renderList();\r\n  document.getElementById('report').innerHTML='<div class=\"empty\" style=\"border:none;padding:40px 10px;\">Select a flagged item to see its RCA.</div>';\r\n  if(FLAGS.length) selectFlag(0);\r\n}\r\n// Forecast accuracy of the set = 100 − MAPE (mean ABSOLUTE % error), where the\r\n// per-row absolute % error is |Plan-Adherence deviation| (_padh is now signed,\r\n// so MAPE explicitly takes Math.abs() here — otherwise over/under-forecasts\r\n// would cancel again and reintroduce the ~100%-even-when-badly-off bug this was\r\n// built to fix; the DISPLAYED _padh stays signed, only this aggregate uses abs).\r\nfunction setAccuracy(rows){\r\n  const errs=rows.filter(r=>r._padh!=null).map(r=>Math.abs(r._padh));\r\n  if(!errs.length) return null;\r\n  const mape=errs.reduce((a,b)=>a+b,0)/errs.length;\r\n  return Math.max(0,100-mape);\r\n}\r\nfunction renderMetrics(groups,rows,flaggedCount,avgAcc){\r\n  const nq=Object.keys(groups).length;\r\n  const accTxt=(avgAcc==null)?'N/A':avgAcc.toFixed(1)+'%';\r\n  const m=[['metric','',nq,'Forecast names'],['metric','',rows.length.toLocaleString(),'Rows'],['metric flag','',flaggedCount,'Flagged (±band)'],['metric good','title=\"100 − MAPE (mean absolute % error). Averaging Actual÷Fcst directly cancels over/under-forecasts and overstates accuracy.\"',accTxt,'Avg accuracy (100−MAPE)']];\r\n  document.getElementById('metrics').innerHTML=m.map(x=>`<div class=\"${x[0]}\" ${x[1]}><div class=\"v\">${x[2]}</div><div class=\"l\">${x[3]}</div></div>`).join('');\r\n}\r\n\r\n/* ---------------- Chart primitives (no libraries) ---------------- */\r\nconst compactN=n=>{ n=Math.round(n); if(n>=1e9)return (n/1e9).toFixed(2)+'B'; if(n>=1e6)return (n/1e6).toFixed(2)+'M'; if(n>=1e3)return (n/1e3).toFixed(1)+'K'; return n.toLocaleString(); };\r\nlet _gradSeq=0;\r\n// Horizontal bars in plain HTML — single-hue (magnitude), rounded ends, value labels + native hover title.\r\nfunction htmlBars(items,opt){\r\n  opt=opt||{}; const fmt=opt.fmt||(v=>v.toLocaleString());\r\n  if(!items.length) return '<div class=\"cs\">No data in scope.</div>';\r\n  const max=Math.max(1,...items.map(d=>d.value));\r\n  return `<div style=\"display:flex;flex-direction:column;gap:9px;\">`+items.map(d=>{\r\n    const pct=(d.value/max*100), col=d.color||'var(--accent)';\r\n    return `<div title=\"${String(d.label+': '+fmt(d.value)).replace(/\"/g,'&quot;')}\">\r\n      <div style=\"display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:3px;gap:8px;\">\r\n        <span style=\"color:var(--text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">${d.label}</span>\r\n        <span style=\"color:var(--muted);font-variant-numeric:tabular-nums;flex-shrink:0;\">${fmt(d.value)}${d.note?' · '+d.note:''}</span>\r\n      </div>\r\n      <div style=\"height:9px;background:var(--panel-2);border-radius:99px;overflow:hidden;\"><div style=\"height:100%;width:${pct.toFixed(1)}%;background:${col};border-radius:99px;\"></div></div>\r\n    </div>`;\r\n  }).join('')+`</div>`;\r\n}\r\n// Single-series area+line trend as SVG, with a JS crosshair+tooltip wired by wireTrends().\r\nfunction buildTrend(points,opt){\r\n  opt=opt||{}; const n=points.length; if(!n) return '<div class=\"cs\">No data in scope.</div>';\r\n  const W=640,H=170,padL=46,padR=12,padT=12,padB=22, iw=W-padL-padR, ih=H-padT-padB;\r\n  const max=Math.max(...points.map(p=>p.value),0)||1, min=0;\r\n  const X=i=> padL + (n===1?iw/2:i*iw/(n-1));\r\n  const Y=v=> padT + ih - ((v-min)/((max-min)||1))*ih;\r\n  const line=points.map((p,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Y(p.value).toFixed(1)).join(' ');\r\n  const area='M'+X(0).toFixed(1)+' '+(padT+ih)+' '+points.map((p,i)=>'L'+X(i).toFixed(1)+' '+Y(p.value).toFixed(1)).join(' ')+' L'+X(n-1).toFixed(1)+' '+(padT+ih)+' Z';\r\n  let grid=''; [0,.5,1].forEach(t=>{ const v=min+(max-min)*t, y=Y(v).toFixed(1); grid+=`<line class=\"grid-l\" x1=\"${padL}\" y1=\"${y}\" x2=\"${W-padR}\" y2=\"${y}\"/><text class=\"axt\" x=\"${padL-6}\" y=\"${(+y+3).toFixed(1)}\" text-anchor=\"end\">${opt.yfmt?opt.yfmt(v):Math.round(v)}</text>`; });\r\n  let xl=''; [...new Set([0,Math.floor((n-1)/2),n-1])].forEach(i=>{ xl+=`<text class=\"axt\" x=\"${X(i).toFixed(1)}\" y=\"${H-6}\" text-anchor=\"middle\">${points[i].label}</text>`; });\r\n  const col=opt.color||'var(--accent)', gid='grad'+(_gradSeq++);\r\n  const pts=points.map((p,i)=>({x:+X(i).toFixed(1),y:+Y(p.value).toFixed(1),l:p.disp||p.label,v:opt.tip?opt.tip(p.value):String(p.value)}));\r\n  return `<div class=\"trend\" data-pts='${JSON.stringify(pts).replace(/'/g,\"&#39;\")}'>\r\n    <svg viewBox=\"0 0 ${W} ${H}\" role=\"img\">\r\n      <defs><linearGradient id=\"${gid}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${col}\" stop-opacity=\"0.26\"/><stop offset=\"1\" stop-color=\"${col}\" stop-opacity=\"0.02\"/></linearGradient></defs>\r\n      ${grid}${xl}\r\n      <path d=\"${area}\" fill=\"url(#${gid})\"/>\r\n      <path d=\"${line}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\r\n      <line class=\"cx-line cx-ln\" x1=\"0\" y1=\"${padT}\" x2=\"0\" y2=\"${padT+ih}\" style=\"opacity:0\"/>\r\n      <circle class=\"cx-dot\" r=\"4\" fill=\"${col}\" stroke=\"var(--panel)\" stroke-width=\"1.5\" style=\"opacity:0\"/>\r\n    </svg>\r\n    <div class=\"cx-tip\"></div>\r\n  </div>`;\r\n}\r\n// Two-series trend (e.g. Actual vs Forecast) — same y-scale (same unit, no dual-axis). Legend + crosshair.\r\nfunction buildTrend2(labels, sa, sb, opt){\r\n  opt=opt||{}; const n=labels.length; if(!n) return '<div class=\"cs\">No data in scope.</div>';\r\n  const W=640,H=180,padL=48,padR=12,padT=14,padB=24, iw=W-padL-padR, ih=H-padT-padB;\r\n  const max=Math.max(...sa.vals,...sb.vals,0)||1, min=0;\r\n  const X=i=> padL+(n===1?iw/2:i*iw/(n-1));\r\n  const Y=v=> padT+ih-((v-min)/((max-min)||1))*ih;\r\n  const path=vals=> vals.map((v,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Y(v).toFixed(1)).join(' ');\r\n  const area='M'+X(0).toFixed(1)+' '+(padT+ih)+' '+sa.vals.map((v,i)=>'L'+X(i).toFixed(1)+' '+Y(v).toFixed(1)).join(' ')+' L'+X(n-1).toFixed(1)+' '+(padT+ih)+' Z';\r\n  let grid=''; [0,.5,1].forEach(t=>{ const v=min+(max-min)*t, y=Y(v).toFixed(1); grid+=`<line class=\"grid-l\" x1=\"${padL}\" y1=\"${y}\" x2=\"${W-padR}\" y2=\"${y}\"/><text class=\"axt\" x=\"${padL-6}\" y=\"${(+y+3).toFixed(1)}\" text-anchor=\"end\">${opt.yfmt?opt.yfmt(v):Math.round(v)}</text>`; });\r\n  let xl=''; [...new Set([0,Math.floor((n-1)/2),n-1])].forEach(i=>{ xl+=`<text class=\"axt\" x=\"${X(i).toFixed(1)}\" y=\"${H-6}\" text-anchor=\"middle\">${labels[i]}</text>`; });\r\n  const gid='grad'+(_gradSeq++), fmt=opt.fmt||(v=>String(v));\r\n  const pts=labels.map((l,i)=>({x:+X(i).toFixed(1), l:'FW '+l, items:[\r\n    {y:+Y(sa.vals[i]).toFixed(1), v:fmt(sa.vals[i]), name:sa.name, c:sa.color},\r\n    {y:+Y(sb.vals[i]).toFixed(1), v:fmt(sb.vals[i]), name:sb.name, c:sb.color}\r\n  ]}));\r\n  return `<div class=\"trend\" data-multi='${JSON.stringify({pts}).replace(/'/g,\"&#39;\")}'>\r\n    <svg viewBox=\"0 0 ${W} ${H}\" role=\"img\">\r\n      <defs><linearGradient id=\"${gid}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${sa.color}\" stop-opacity=\"0.22\"/><stop offset=\"1\" stop-color=\"${sa.color}\" stop-opacity=\"0.02\"/></linearGradient></defs>\r\n      ${grid}${xl}\r\n      <path d=\"${area}\" fill=\"url(#${gid})\"/>\r\n      <path d=\"${path(sa.vals)}\" fill=\"none\" stroke=\"${sa.color}\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\r\n      <path d=\"${path(sb.vals)}\" fill=\"none\" stroke=\"${sb.color}\" stroke-width=\"2\" stroke-dasharray=\"4 3\" stroke-linejoin=\"round\"/>\r\n      <line class=\"cx-line cx-ln\" x1=\"0\" y1=\"${padT}\" x2=\"0\" y2=\"${padT+ih}\" style=\"opacity:0\"/>\r\n      <circle class=\"cx-dot\" r=\"4\" fill=\"${sa.color}\" stroke=\"var(--panel)\" stroke-width=\"1.5\" style=\"opacity:0\"/>\r\n      <circle class=\"cx-dot\" r=\"4\" fill=\"${sb.color}\" stroke=\"var(--panel)\" stroke-width=\"1.5\" style=\"opacity:0\"/>\r\n    </svg>\r\n    <div class=\"cx-tip\"></div>\r\n    <div class=\"dlegend\"><span><span class=\"sw\" style=\"background:${sa.color}\"></span>${sa.name}</span><span><span class=\"sw\" style=\"background:${sb.color};opacity:.9\"></span>${sb.name} <span style=\"opacity:.6\">(dashed)</span></span></div>\r\n  </div>`;\r\n}\r\n// Diverging signed-bias bars centred on zero. value = Σactual÷Σforecast − 1 (fraction).\r\nfunction divergingBars(items, opt){\r\n  opt=opt||{}; if(!items.length) return '<div class=\"cs\">Not enough matched Actual+Forecast rows in scope.</div>';\r\n  const maxAbs=Math.max(0.05,...items.map(d=>Math.abs(d.value)));\r\n  const over=opt.overColor||'var(--accent)', under=opt.underColor||'var(--warn)';\r\n  const rows=items.map(d=>{\r\n    const half=Math.abs(d.value)/maxAbs*50, pos=d.value>=0;\r\n    const style=pos?`left:50%;width:${half.toFixed(1)}%;background:${under};`:`right:50%;width:${half.toFixed(1)}%;background:${over};`;\r\n    const sign=(d.value>0?'+':'')+(d.value*100).toFixed(1)+'%';\r\n    return `<div class=\"dvg-row\"><div class=\"dvg-t\"><span class=\"nm\" title=\"${String(d.label).replace(/\"/g,'&quot;')}\">${d.label}</span><span style=\"color:${pos?under:over};font-weight:800;font-variant-numeric:tabular-nums;\">${sign}${opt.sub?' · '+opt.sub(d):''}</span></div><div class=\"dvg-track\"><div class=\"mid\"></div><div class=\"dvg-fill\" style=\"${style}\"></div></div></div>`;\r\n  }).join('');\r\n  return `<div class=\"dvg\">${rows}</div><div class=\"dvg-legend\"><span>◀ over-forecast (fcst &gt; actual)</span><span>under-forecast (actual &gt; fcst) ▶</span></div>`;\r\n}\r\nfunction wireTrends(){\r\n  document.querySelectorAll('#dashboardArea .trend').forEach(el=>{\r\n    const svg=el.querySelector('svg'), ln=el.querySelector('.cx-ln'), tip=el.querySelector('.cx-tip');\r\n    const multiAttr=el.getAttribute('data-multi');\r\n    if(multiAttr){\r\n      let data; try{ data=JSON.parse(multiAttr); }catch(e){ return; }\r\n      const pts=data.pts, dots=[...el.querySelectorAll('.cx-dot')];\r\n      svg.addEventListener('mousemove',e=>{\r\n        const rect=svg.getBoundingClientRect(); if(!rect.width) return;\r\n        const xv=Math.min(1,Math.max(0,(e.clientX-rect.left)/rect.width))*640;\r\n        let best=0,bd=1e9; pts.forEach((p,i)=>{ const d=Math.abs(p.x-xv); if(d<bd){bd=d;best=i;} });\r\n        const p=pts[best];\r\n        ln.setAttribute('x1',p.x); ln.setAttribute('x2',p.x); ln.style.opacity=1;\r\n        p.items.forEach((it,i)=>{ if(dots[i]){ dots[i].setAttribute('cx',p.x); dots[i].setAttribute('cy',it.y); dots[i].style.opacity=1; } });\r\n        tip.style.left=((p.x/640)*rect.width)+'px'; tip.style.top=((Math.min(...p.items.map(it=>it.y))/180)*rect.height)+'px'; tip.style.opacity=1;\r\n        tip.innerHTML=`<b>${p.l}</b><br>`+p.items.map(it=>`<span style=\"color:${it.c}\">■</span> ${it.name}: ${it.v}`).join('<br>');\r\n      });\r\n      svg.addEventListener('mouseleave',()=>{ ln.style.opacity=0; dots.forEach(d=>d.style.opacity=0); tip.style.opacity=0; });\r\n      return;\r\n    }\r\n    let pts; try{ pts=JSON.parse(el.getAttribute('data-pts')||'[]'); }catch(e){ return; }\r\n    if(!pts.length) return;\r\n    const dot=el.querySelector('.cx-dot');\r\n    svg.addEventListener('mousemove',e=>{\r\n      const rect=svg.getBoundingClientRect(); if(!rect.width) return;\r\n      const xv=Math.min(1,Math.max(0,(e.clientX-rect.left)/rect.width))*640;\r\n      let best=0,bd=1e9; pts.forEach((p,i)=>{ const d=Math.abs(p.x-xv); if(d<bd){bd=d;best=i;} });\r\n      const p=pts[best];\r\n      ln.setAttribute('x1',p.x); ln.setAttribute('x2',p.x); ln.style.opacity=1;\r\n      dot.setAttribute('cx',p.x); dot.setAttribute('cy',p.y); dot.style.opacity=1;\r\n      tip.style.left=((p.x/640)*rect.width)+'px'; tip.style.top=((p.y/170)*rect.height)+'px'; tip.style.opacity=1;\r\n      tip.innerHTML=`<b>${p.l}</b><br>${p.v}`;\r\n    });\r\n    svg.addEventListener('mouseleave',()=>{ ln.style.opacity=0; dot.style.opacity=0; tip.style.opacity=0; });\r\n  });\r\n}\r\n\r\n/* ---------------- Dashboard drill-down (local to the volumetrics; does NOT touch console filters) ---------------- */\r\nlet DRILL=[];   // breadcrumb path: [{f,label,v}]\r\nfunction reDash(){ if(window._lastRows) renderDashboard(window._lastRows,window._lastGroups,window._lastFlagged,window._lastAcc); }\r\nfunction drillInto(f,v){ if(DRILL.some(d=>d.f===f)) return; const lbl=(FILTER_FIELDS.find(x=>x[0]===f)||[f,f])[1]; DRILL.push({f,label:lbl,v}); reDash(); }\r\nfunction drillTo(n){ DRILL=DRILL.slice(0,n); reDash(); }        // keep first n crumbs\r\nfunction drillClear(){ DRILL=[]; reDash(); }\r\nfunction drillMatch(r,d){ return d.v==='(blank)' ? (r[d.f]==null||r[d.f]==='') : String(r[d.f]==null?'':r[d.f])===d.v; }\r\nfunction drillCrumbs(){\r\n  const esc=s=>String(s).replace(/</g,'&lt;');\r\n  let h=`<div class=\"vdrill\"><span class=\"vd-crumb${DRILL.length?'':' cur'}\" onclick=\"drillClear()\">All data</span>`;\r\n  DRILL.forEach((d,i)=>{ h+=`<span class=\"vd-sep\">›</span><span class=\"vd-crumb${i===DRILL.length-1?' cur':''}\" onclick=\"drillTo(${i+1})\">${esc(d.label)}: ${esc(d.v)}</span>`; });\r\n  if(DRILL.length) h+=`<button class=\"vd-clear\" onclick=\"drillClear()\">✕ clear drill</button>`;\r\n  return h+`</div>`;\r\n}\r\n\r\n/* ---------------- Dashboard — volumetrics + graphs, reflects the ACTIVE filters + drill path ---------------- */\r\nfunction renderDashboard(rows,groups,flaggedCount,avgAcc){\r\n  const empty=document.getElementById('dashEmpty'), host=document.getElementById('dashboardArea');\r\n  if(!rows.length){ empty.style.display='block'; host.style.display='none'; host.innerHTML=''; return; }\r\n  empty.style.display='none'; host.style.display='block';\r\n\r\n  const band=num(document.getElementById('band').value)||10;\r\n  // scope to the active drill path, then recompute the headline numbers from the scoped set\r\n  if(DRILL.length) rows=rows.filter(r=>DRILL.every(d=>drillMatch(r,d)));\r\n  if(!rows.length){ host.innerHTML=`<div class=\"vol\"><div class=\"vtop\"><div class=\"vtitle\"><span class=\"spark\">📊</span> Data Volumetrics</div></div>${drillCrumbs()}<div class=\"empty\" style=\"border:none;color:#c2d0ee;\">No rows for this drill path.</div></div>`; document.getElementById('insDrawerBody').innerHTML=''; updateInsDrawer(); return; }\r\n  const gset=new Set(); rows.forEach(r=>gset.add(String(r.Forecast_name||''))); const nForecast=gset.size;\r\n  flaggedCount=rows.filter(r=>r._padh!=null && Math.abs(+r._padh.toFixed(1))>band).length;\r\n  { const e=rows.filter(r=>r._padh!=null).map(r=>Math.abs(r._padh)); avgAcc=e.length?Math.max(0,100-e.reduce((a,b)=>a+b,0)/e.length):null; }\r\n\r\n  // ---- single-pass aggregation ----\r\n  let totOff=0,totHand=0,haveOff=0;\r\n  const dimMaps={}; VOL_DIMS.forEach(([f])=>dimMaps[f]=new Map());\r\n  const volBy={Region:new Map(),Offering:new Map(),channel:new Map()};\r\n  const weekOff=new Map(), weekFcst=new Map(), weekPadh=new Map();   // fw -> Σoffered ; Σforecast ; [padh…]\r\n  const flagByName=new Map();                       // forecast_name -> flagged count\r\n  const sumReg=new Map(), sumName=new Map();        // signed-bias sums: key -> [Σactual, Σforecast]\r\n  let cA=0,cF=0,noFscope=0;                          // computable Σactual/Σforecast ; unscoreable rows\r\n  const dev=[0,0,0,0,0];                            // ≤5, 5–10, 10–20, 20–25, >25 (abs deviation %)\r\n  const biasAdd=(m,k,a,f)=>{ k=(k==null||k==='')?'(blank)':String(k); const o=m.get(k)||[0,0]; o[0]+=a; o[1]+=f; m.set(k,o); };\r\n  rows.forEach(r=>{\r\n    const ao=r._ao; if(ao!=null){ totOff+=ao; haveOff++; }\r\n    const ah=num(r.Actual_Handled); if(ah!=null) totHand+=ah;\r\n    VOL_DIMS.forEach(([f])=>{ const v=(r[f]==null||r[f]==='')?'(blank)':String(r[f]); dimMaps[f].set(v,(dimMaps[f].get(v)||0)+1); });\r\n    Object.keys(volBy).forEach(f=>{ if(ao!=null){ const v=(r[f]==null||r[f]==='')?'(blank)':String(r[f]); volBy[f].set(v,(volBy[f].get(v)||0)+ao); } });\r\n    const wk=r._wk||'(blank)';\r\n    if(ao!=null) weekOff.set(wk,(weekOff.get(wk)||0)+ao);\r\n    if(r._fo!=null) weekFcst.set(wk,(weekFcst.get(wk)||0)+r._fo);\r\n    if(r._noF) noFscope++;\r\n    if(ao!=null && r._fo!=null && r._fo>0){ cA+=ao; cF+=r._fo; biasAdd(sumReg,r.Region,ao,r._fo); biasAdd(sumName,r.Forecast_name,ao,r._fo); }\r\n    if(r._padh!=null){ (weekPadh.get(wk)||weekPadh.set(wk,[]).get(wk)).push(r._padh);\r\n      const d=Math.abs(r._padh); if(d<=5)dev[0]++; else if(d<=10)dev[1]++; else if(d<=20)dev[2]++; else if(d<=25)dev[3]++; else dev[4]++;\r\n      if(d>band){ const nm=r.Forecast_name||'(blank)'; flagByName.set(nm,(flagByName.get(nm)||0)+1); }\r\n    }\r\n  });\r\n  const fw=[...dimMaps['Fiscal_Week'].keys()].filter(x=>x!=='(blank)').sort();\r\n  const fwSpan=fw.length?(fw[0]===fw[fw.length-1]?fw[0]:fw[0]+' → '+fw[fw.length-1]):'—';\r\n  const filtered=Object.values(FILTERS).some(v=>v)||FOCUS.size;\r\n\r\n  // ---- EPIC volumetrics hero (with drill-vs-baseline delta on accuracy) ----\r\n  const base=window._lastAcc;\r\n  const accDelta=(DRILL.length && base!=null && avgAcc!=null)?(avgAcc-base):null;\r\n  const accDeltaHtml=accDelta!=null?`<div class=\"d ${accDelta>=0?'up':'down'}\">${accDelta>=0?'▲ +':'▼ '}${accDelta.toFixed(1)}pp vs all</div>`:'';\r\n  const hero=[\r\n    ['',rows.length.toLocaleString(),'Rows in scope',''],\r\n    ['',nForecast.toLocaleString(),'Forecast names',''],\r\n    ['',fwSpan,'Fiscal weeks ('+dimMaps['Fiscal_Week'].size+')',''],\r\n    ['accent',compactN(totOff),'Actual offered (Σ)',''],\r\n    ['accent',compactN(totHand),'Actual handled (Σ)',''],\r\n    ['flag',flaggedCount.toLocaleString(),'Flagged (±band)',''],\r\n    ['warn',(avgAcc==null?'N/A':avgAcc.toFixed(1)+'%'),'Avg accuracy',accDeltaHtml],\r\n  ];\r\n  const heroHtml=hero.map(h=>`<div class=\"vhcell ${h[0]}\"><div class=\"n\">${h[1]}</div><div class=\"k\">${h[2]}</div>${h[3]||''}</div>`).join('');\r\n  // Cards drill down: click any value → the whole panel re-scopes to it (one→many). Dimensions\r\n  // already on the drill path are hidden. Fiscal_Week is excluded (it's the time axis; see week charts).\r\n  // Bars show ROW COUNTS, not % of total. \"+N more\" expands the member list in place.\r\n  const attr=s=>String(s).replace(/\"/g,'&quot;');\r\n  const mkBar=(f,v,c,mx)=>`<div class=\"vbar drillable\" data-df=\"${attr(f)}\" data-dv=\"${attr(v)}\" title=\"Drill into ${attr(v)}\"><div class=\"vb-t\"><span class=\"vb-name\">${v}</span><span class=\"vb-pct\">${c.toLocaleString()}</span></div><div class=\"vb-track\"><div class=\"vb-fill\" style=\"width:${(c/mx*100).toFixed(1)}%\"></div></div></div>`;\r\n  const K=DRILL.length?6:3, REST_CAP=25;\r\n  const dimHtml=VOL_DIMS.filter(([f])=>f!=='Fiscal_Week' && !DRILL.some(d=>d.f===f)).map(([f,label])=>{\r\n    const mp=dimMaps[f], ent=[...mp.entries()].sort((a,b)=>b[1]-a[1]), mx=ent.length?ent[0][1]:1;\r\n    const vis=ent.slice(0,K).map(([v,c])=>mkBar(f,v,c,mx)).join('');\r\n    const restArr=ent.slice(K,K+REST_CAP);\r\n    const rest=restArr.length?`<div class=\"vd-rest\" id=\"rest-${attr(f)}\" hidden>${restArr.map(([v,c])=>mkBar(f,v,c,mx)).join('')}</div>`:'';\r\n    const beyond=ent.length-K;\r\n    const moreTxt=beyond>0?`+${beyond.toLocaleString()} more${ent.length>K+REST_CAP?' (showing top '+REST_CAP+')':''}`:'';\r\n    const more=beyond>0?`<div class=\"vd-more\" data-expand=\"${attr(f)}\" data-more=\"${attr(moreTxt)}\">${moreTxt}</div>`:'';\r\n    return `<div class=\"vdim\"><div class=\"vd-h\"><span class=\"vd-l\">${label}</span><span class=\"vd-c\">${mp.size.toLocaleString()}<small>values</small></span></div>${vis}${rest}${more}</div>`;\r\n  }).join('');\r\n\r\n  // ---- trend series (chronological) ----\r\n  const offPts=fw.map(w=>({label:w.slice(-2)?w:w,disp:'FW '+w,value:weekOff.get(w)||0}));\r\n  offPts.forEach(p=>p.label=p.disp.replace('FW ',''));\r\n  const accPts=fw.filter(w=>weekPadh.get(w)).map(w=>{ const a=weekPadh.get(w); const m=a.reduce((x,y)=>x+Math.abs(y),0)/a.length; return {label:w.slice(2),disp:'FW '+w,value:Math.max(0,100-m)}; });\r\n\r\n  // ---- bar datasets ----\r\n  const flagTot=[...flagByName.values()].reduce((a,b)=>a+b,0)||1;   // total flagged weeks across ALL queues\r\n  const topFlag=[...flagByName.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([l,v])=>({label:l,value:v,color:'var(--danger)',note:(v/flagTot*100).toFixed(1)+'%'}));\r\n  const regBars=[...volBy.Region.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([l,v])=>({label:l,value:v}));\r\n  const chBars=[...volBy.channel.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([l,v])=>({label:l,value:v}));\r\n  const offBars=[...volBy.Offering.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([l,v])=>({label:l,value:v}));\r\n  const devTot=dev[0]+dev[1]+dev[2]+dev[3]+dev[4]||1;\r\n  const devBars=[\r\n    {label:'±5% · on-plan',value:dev[0],color:'var(--accent)'},     // blue\r\n    {label:'±10% · warning',value:dev[1],color:'var(--accent-2)'},  // green\r\n    {label:'±15–20% · elevated',value:dev[2],color:'#e8770f'},      // orange\r\n    {label:'±20–25% · serious',value:dev[3],color:'#f2b01e'},       // amber\r\n    {label:'>±25% · critical',value:dev[4],color:'var(--danger)'},  // red\r\n  ].map(d=>({...d,note:(d.value/devTot*100).toFixed(0)+'%'}));\r\n\r\n  // ---- Forecast names by Forecast-Adherence band (ALL names in scope; each bucketed by its WORST week) ----\r\n  // Fine bands starting at ±5. Pick a Fiscal Week → each name has one value that week, so this shows\r\n  // exactly which names sat at ±5%, ±10%, ±15–20%, … that week.\r\n  const worstByQueue=new Map();\r\n  rows.forEach(r=>{ if(r._padh!=null){ const nm=(r.Forecast_name==null||r.Forecast_name==='')?'(blank)':String(r.Forecast_name); worstByQueue.set(nm,Math.max(worstByQueue.get(nm)||0,Math.abs(r._padh))); } });\r\n  const adhDefs=[[0,5,'≤ ±5%'],[5,10,'±5–10%'],[10,15,'±10–15%'],[15,20,'±15–20%'],[20,25,'±20–25%'],[25,Infinity,'> ±25%']];\r\n  const adhBucket=d=>{ for(let i=0;i<adhDefs.length;i++){ if(d>adhDefs[i][0] && d<=adhDefs[i][1]) return i; } return adhDefs.length-1; };\r\n  const adhCnt=adhDefs.map(()=>0), adhWk=adhDefs.map(()=>0);\r\n  worstByQueue.forEach(d=>{ adhCnt[adhBucket(d)]++; });\r\n  rows.forEach(r=>{ if(r._padh!=null) adhWk[adhBucket(Math.abs(r._padh))]++; });\r\n  const affTot=adhCnt.reduce((a,b)=>a+b,0)||1;\r\n  const affColors=['var(--accent-2)','var(--accent)','#f2b01e','#e8770f','#d1451f','var(--danger)'];\r\n  const affBars=adhDefs.map((d,i)=>({label:d[2],value:adhCnt[i],color:affColors[i],note:(adhCnt[i]/affTot*100).toFixed(0)+'% · '+adhWk[i].toLocaleString()+' wks'}));\r\n\r\n  // ---- Actual vs Forecast overlay (same unit → one y-scale) ----\r\n  const sActual={name:'Actual offered',color:'var(--accent-2)',vals:fw.map(w=>weekOff.get(w)||0)};\r\n  const sFcst  ={name:'Forecast offered',color:'var(--accent)', vals:fw.map(w=>Math.round(weekFcst.get(w)||0))};\r\n\r\n  // ---- signed forecast bias = Σactual ÷ Σforecast − 1 (positive = under-forecast) ----\r\n  const biasReg=[...sumReg.entries()].map(([k,[a,f]])=>({label:k,value:a/f-1,a,f})).sort((x,y)=>Math.abs(y.value)-Math.abs(x.value));\r\n  const matFloor=0.003*(cF||1);   // material queues only: ≥0.3% of forecast volume, so tiny queues don't dominate\r\n  const movers=[...sumName.entries()].filter(([,[a,f]])=>f>=matFloor).map(([k,[a,f]])=>({label:k,value:a/f-1,a,f}))\r\n                 .sort((x,y)=>Math.abs(y.value)-Math.abs(x.value)).slice(0,8);\r\n  const overallBias=cF?(cA/cF-1):null;\r\n\r\n  // ---- rule-based auto-insights for the current scope ----\r\n  const ins=[];\r\n  if(avgAcc!=null){\r\n    if(DRILL.length && base!=null){ const dp=avgAcc-base; ins.push({i:dp>=0?'▲':'▼',t:`Accuracy here is <b>${avgAcc.toFixed(1)}%</b> — <span class=\"ins-${dp>=0?'up':'down'}\">${dp>=0?'+':''}${dp.toFixed(1)}pp</span> vs the overall <b>${base.toFixed(1)}%</b>.`}); }\r\n    else ins.push({i:'🎯',t:`Overall forecast accuracy is <b>${avgAcc.toFixed(1)}%</b> (100 − MAPE).`});\r\n  }\r\n  if(overallBias!=null){ const p=overallBias*100; ins.push({i:p>=0?'📈':'📉',t:`Forecast runs <b>${Math.abs(p).toFixed(1)}% ${p>=0?'under':'over'}</b> on average — actual demand ${p>=0?'exceeded':'fell short of'} plan (Σ actual vs Σ forecast).`}); }\r\n  if(movers.length){ const m=movers[0], p=m.value*100; ins.push({i:'🔎',t:`Most mis-forecast queue: <b>${m.label}</b> at <b>${p>=0?'+':''}${p.toFixed(0)}%</b> (${p>=0?'under':'over'}-forecast).`}); }\r\n  { const ch=[...volBy.channel.entries()].sort((a,b)=>b[1]-a[1])[0]; if(ch) ins.push({i:'📊',t:`<b>${ch[0]}</b> is the largest channel — <b>${(ch[1]/(totOff||1)*100).toFixed(0)}%</b> of offered volume.`}); }\r\n  { const tot=[...flagByName.values()].reduce((a,b)=>a+b,0); if(tot){ const t3=[...flagByName.entries()].sort((a,b)=>b[1]-a[1]).slice(0,3); const s3=t3.reduce((a,[,v])=>a+v,0); ins.push({i:'⚠️',t:`Top 3 queues drive <b>${(s3/tot*100).toFixed(0)}%</b> of flagged weeks (${t3.map(x=>x[0]).join(', ')}).`}); } }\r\n  if(noFscope>0) ins.push({i:'🧩',t:`<b>${noFscope.toLocaleString()}</b> row(s) can't be scored (no/zero forecast) — data gap, excluded from accuracy.`});\r\n  const insBody=`<div class=\"ins-scope\">${DRILL.length?'Scoped to '+DRILL.map(d=>d.v).join(' › '):'Whole '+(filtered?'filtered set':'file')}</div><ul class=\"ins-ul\">${ins.map(x=>`<li><span class=\"ic\">${x.i}</span><span>${x.t}</span></li>`).join('')}</ul>`;\r\n\r\n  host.innerHTML=`\r\n  <div class=\"vol\">\r\n    <div class=\"vtop\">\r\n      <div>\r\n        <div class=\"vtitle\"><span class=\"spark\">📊</span> Data Volumetrics</div>\r\n        <div class=\"vsub\">Shape of the loaded demand file at a glance — headline totals, then how the data splits across each business dimension. <b>Click any value to drill in</b> (e.g. Region → EMEA) and the whole panel re-scopes card-by-card. Updates live as you filter in the RCA Console.</div>\r\n      </div>\r\n      <div class=\"vscope\">${(filtered||DRILL.length)?'<b>Filtered</b> view':'<b>Full</b> file'}<br>${haveOff.toLocaleString()} rows with Actual_Offered</div>\r\n    </div>\r\n    <div class=\"vhero\">${heroHtml}</div>\r\n    ${drillCrumbs()}\r\n    <div class=\"vgrid-h\">${DRILL.length?'Drill-down · scoped to '+DRILL.map(d=>d.v).join(' › ')+' — click to go deeper':'Dimension mix — click a value to drill in'}</div>\r\n    <div class=\"vgrid\">${dimHtml}</div>\r\n  </div>\r\n\r\n  <div class=\"dash\">\r\n    <div class=\"dgrid\">\r\n      <div class=\"chart\"><h4>Actual vs Forecast — offered by week</h4><div class=\"cs\">Green = actual, dashed blue = forecast (fcst_offered). The gap between the lines <b>is</b> the miss.</div>${buildTrend2(fw.map(w=>w),sActual,sFcst,{yfmt:v=>compactN(v),fmt:v=>compactN(v)})}</div>\r\n      <div class=\"chart\"><h4>Forecast accuracy by fiscal week</h4><div class=\"cs\">Weekly accuracy = 100 − mean plan-adherence deviation. Higher is better.</div>${buildTrend(accPts,{color:'var(--accent-2)',yfmt:v=>v.toFixed(0)+'%',tip:v=>v.toFixed(1)+'% accuracy'})}</div>\r\n    </div>\r\n    <div class=\"dgrid\">\r\n      <div class=\"chart\"><h4>Forecast bias by Region</h4><div class=\"cs\">Signed Σactual ÷ Σforecast − 1. Right = under-forecast (demand ran hot); left = over-forecast (plan too high).</div>${divergingBars(biasReg,{sub:d=>compactN(d.a)+' vs '+compactN(d.f)})}</div>\r\n      <div class=\"chart\"><h4>Most over/under-forecast queues</h4><div class=\"cs\">Largest signed bias among material queues (≥0.3% of forecast volume). The RCA shortlist.</div>${divergingBars(movers)}</div>\r\n    </div>\r\n    <div class=\"dgrid\">\r\n      <div class=\"chart\"><h4>Forecast Adherence spread — all weeks</h4><div class=\"cs\">Every computable week bucketed by |Forecast Adherence| (= |1 − Actual÷Fcst|). Full distribution incl. on-plan; bands carry a status label, not colour alone.</div>${htmlBars(devBars,{fmt:v=>v.toLocaleString()+' wks'})}</div>\r\n      <div class=\"chart\"><h4 style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;\">Top flagged forecast names <span style=\"font-size:11px;font-weight:600;color:var(--muted);white-space:nowrap;\">${flagTot.toLocaleString()} wks flagged</span></h4><div class=\"cs\">Forecast names with the most weeks outside the ±${band}% band. % = share of all flagged weeks.</div>${htmlBars(topFlag,{fmt:v=>v.toLocaleString()+' wks'})}</div>\r\n    </div>\r\n    <div class=\"chart\"><h4>Forecast names by adherence band</h4><div class=\"cs\">Every forecast name in scope, bucketed by its <b>worst</b> week's |Forecast Adherence| into ±5 / ±10 / ±15–20 / ±20–25 / &gt;±25. <b>Pick a Fiscal Week above</b> to see which names sat in each band that week. Value = distinct forecast names; note = share · weeks in band.</div>${htmlBars(affBars,{fmt:v=>v.toLocaleString()+' names'})}</div>\r\n    <div class=\"dgrid\">\r\n      <div class=\"chart\"><h4>Actual offered by Region</h4><div class=\"cs\">Σ Actual_Offered per region.</div>${htmlBars(regBars,{fmt:compactN})}</div>\r\n      <div class=\"chart\"><h4>Actual offered by Channel</h4><div class=\"cs\">Σ Actual_Offered per channel.</div>${htmlBars(chBars,{fmt:compactN})}</div>\r\n    </div>\r\n    <div class=\"chart\"><h4>Actual offered by Offering</h4><div class=\"cs\">Σ Actual_Offered per offering tier.</div>${htmlBars(offBars,{fmt:compactN})}</div>\r\n  </div>`;\r\n  document.getElementById('insDrawerBody').innerHTML=insBody;\r\n  updateInsDrawer();\r\n  wireTrends();\r\n}\r\nfunction renderList(){\r\n  const el=document.getElementById('qlist');\r\n  const hd=document.querySelector('.listcol h3'); if(hd) hd.textContent=FOCUS.size?'Results — focused forecast names':'Flagged queues / weeks';\r\n  const noFNote=(window._noFCount>0)?`<div class=\"empty\" style=\"border:none;font-size:11px;\">${window._noFCount.toLocaleString()} row(s) skipped — no/zero forecast (can't compute).</div>`:'';\r\n  if(!FLAGS.length){ el.innerHTML=(FOCUS.size?'<div class=\"empty\" style=\"border:none;\">No matching computable rows for those Forecast_name(s).</div>':'<div class=\"empty\" style=\"border:none;\">No weeks outside the ±band 🎉</div>')+noFNote; return; }\r\n  const CAP=250, shown=FLAGS.slice(0,CAP);\r\n  const band=num(document.getElementById('band').value)||10;\r\n  let h=shown.map((r,i)=>{\r\n    const dev=+r._padh.toFixed(1), devAbs=Math.abs(dev);\r\n    const sev=devAbs>25?'red':(devAbs>band?'amber':'green');\r\n    return `<div class=\"qitem\" id=\"q${i}\" onclick=\"selectFlag(${i})\">\r\n      <div class=\"qn\">${r.Forecast_name} ${r._mapped?'':'<span class=\"badge unm\" style=\"font-size:8.5px\">unmapped</span>'}</div>\r\n      <div class=\"qmeta\">${r.Region||''} · ${r.Country||''} · ${r.channel||''} · FW ${r._wk}</div>\r\n      <div class=\"chips\"><span class=\"chip ${sev}\">acc ${r._acc.toFixed(0)}%</span><span class=\"chip ${sev}\">${r._padh.toFixed(0)}% dev</span></div>\r\n    </div>`;\r\n  }).join('');\r\n  if(FLAGS.length>CAP)h+=`<div class=\"empty\" style=\"border:none;font-size:11px;\">Top ${CAP} of ${FLAGS.length.toLocaleString()} shown</div>`;\r\n  el.innerHTML=h+noFNote;\r\n}\r\n\r\n/* ---------------- Drivers with math (for ⓘ) ---------------- */\r\nlet CUR_MATH=[];\r\nfunction buildFindings(r){\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const d=[], A=r._ao, F=r._fo;\r\n  // 1) Forecast Accuracy = Actual_Offered / fcst_offered * 100   (Forecast = fcst_offered)\r\n  d.push({\r\n    s:(r._acc!=null&&Math.abs(r._acc-100)<=band)?'info':'hit',\r\n    b:r._noF?`<b>Forecast accuracy — N/A.</b> fcst_offered is zero/blank, so Actual ÷ Forecast is undefined.`\r\n            :`<b>Forecast accuracy = ${r._acc.toFixed(1)}%</b>`,\r\n    m:{title:'Forecast Accuracy',\r\n       formula:'Forecast Accuracy = (Actual_Offered ÷ Forecast Offered) × 100',\r\n       values:[`Actual_Offered = ${A}`,`Forecast Offered = ${r._noF?'0 / blank':fmt2(F)}`],\r\n       result:r._noF?'N/A (fcst_offered ≤ 0)':r._acc.toFixed(1)+'%'}\r\n  });\r\n  // 2) Forecast Adherence = (1 - Actual_Offered/fcst_offered) * 100 ; blank if no actual\r\n  // Signed: negative = actual ran above forecast (under-forecast), positive = actual ran below forecast (over-forecast).\r\n  const noActual=(r.Actual_Offered===''||r._ao==null);\r\n  d.push({\r\n    s:(r._padh!=null&&Math.abs(r._padh)<=band)?'info':'hit',\r\n    b:noActual?`<b>Forecast adherence — blank.</b> No Actual_Offered for this week (formula returns \"\").`\r\n       :r._noF?`<b>Forecast adherence — N/A.</b> fcst_offered is zero/blank → division undefined.`\r\n       :`<b>Forecast adherence = ${r._padh.toFixed(1)}%</b> deviation from forecast (0% = perfect; negative = actual ran above forecast/under-forecast, positive = actual ran below forecast/over-forecast).`,\r\n    m:{title:'Forecast Adherence',\r\n       formula:'Forecast Adherence = (1 − (Actual_Offered / Forecast Offered)) × 100',\r\n       values:[`Actual_Offered = ${noActual?'(blank)':A}`,`Forecast Offered = ${r._noF?'0 / blank':fmt2(F)}`],\r\n       result:noActual?'\"\" (blank, no actual)':(r._noF?'N/A (÷ by zero)':r._padh.toFixed(1)+'%')}\r\n  });\r\n  return d;\r\n}\r\n\r\nfunction selectFlag(i){\r\n  document.querySelectorAll('.qitem').forEach(e=>e.classList.remove('active'));\r\n  const qi=document.getElementById('q'+i); if(qi)qi.classList.add('active');\r\n  const r=FLAGS[i]; const d=buildFindings(r); CUR_MATH=d.map(x=>x.m);\r\n  window.CUR_CTX=`${r.Forecast_name||'—'} · FW ${r._wk} · ${r.Region||''}/${r.Country||''} · ${r.channel||''} · Plan ${r.Projection_plan_name||'—'} · Forecaster ${r.Forecaster||'—'}`;\r\n  const accCol=(r._acc==null)?'var(--muted)':((r._padh!=null&&Math.abs(r._padh)>25)?'var(--danger)':(r._padh!=null&&Math.abs(r._padh)>10)?'var(--warn)':'var(--accent-2)');\r\n  const bullets=d.map((x,idx)=>`<li><span class=\"bdot ${x.s}\"></span><div class=\"btext\">${x.b}</div><button class=\"ibtn\" title=\"Show the formula & numbers\" onclick=\"showMath(${idx})\">i</button></li>`).join('');\r\n  document.getElementById('report').innerHTML=`\r\n    <div class=\"rhead\">\r\n      <div>\r\n        <div class=\"rtitle\">${r.Forecast_name} ${r._mapped?'<span class=\"badge ok\">mapped</span>':'<span class=\"badge unm\">unmapped</span>'}</div>\r\n        <div class=\"rmeta\">${r.Region||''} · ${r.SubRegion||''} · ${r.Country||''} · ${r.channel||''}<br>Fiscal Week ${r._wk} · Plan: ${r.Projection_plan_name||'—'} · Forecaster: ${r.Forecaster||'—'}</div>\r\n      </div>\r\n      <div class=\"acc\"><div class=\"big\" style=\"color:${accCol}\">${r._padh!=null?r._padh.toFixed(1)+'%':'N/A'}</div><div class=\"lbl\">Forecast Adherence${r._padh!=null?'<div class=\"adhdir\">'+(r._padh<0?'Under-forecast — actual came in above plan':(r._padh>0?'Over-forecast — actual came in below plan':'On plan'))+'</div>':''}</div></div>\r\n    </div>\r\n    <div class=\"subhead\">Findings <span style=\"text-transform:none;font-weight:500;color:var(--muted)\">(ⓘ = the exact formula &amp; numbers)</span></div>\r\n    <ul class=\"rca-bullets\">${bullets}</ul>\r\n    <div class=\"subhead\">Inputs used (from file)</div>\r\n    <div class=\"kv\"><span class=\"k\">Actual_Offered</span><span class=\"val\">${r.Actual_Offered===''?'(blank)':(r._ao!=null?r._ao.toLocaleString():r.Actual_Offered)}</span></div>\r\n    <div class=\"kv\"><span class=\"k\">Forecast Offered</span><span class=\"val\">${r._fo!=null?fmt2(r._fo):(r.fcst_offered||'(blank)')}</span></div>\r\n    <div class=\"subhead\">Root-Cause Investigation</div>\r\n    <div class=\"rca-cap\">Every field available for this queue — the target week, its recent history, and the other queues in its Combined Queue — is consolidated into a single evidence base. Each candidate explanation is then tested against that evidence: competing hypotheses are weighed, those the data does not support are rejected and recorded with the reason, and the remainder are ranked by the strength of the evidence behind them. Conclusions are stated in business language with the underlying figures attached, and where the data cannot settle a question, that limit is reported rather than filled in.</div>\r\n    <div id=\"investigationPanel\"><div style=\"display:flex;align-items:center;gap:12px;flex-wrap:wrap;\"><button class=\"filebtn\" onclick=\"triggerRCA(${i})\">🔎 Investigate Root Cause</button>${rcaModelPickerHtml()}</div></div>\r\n  `;\r\n}\r\n\r\n/* ---------------- Math modal ---------------- */\r\nfunction showMath(idx){\r\n  const m=CUR_MATH[idx]; if(!m)return;\r\n  document.getElementById('mTitle').textContent=m.title;\r\n  document.getElementById('mSub').textContent='Rule-based calculation — the exact formula and the numbers from the file.';\r\n  document.getElementById('mBody').innerHTML=\r\n    `<div class=\"formula\"><span class=\"lbl\">Formula</span>${m.formula}</div>`+\r\n    (m.values&&m.values.length?`<div class=\"formula\"><span class=\"lbl\">Values</span>${m.values.join('<br>')}</div>`:'')+\r\n    `<div class=\"formula\"><span class=\"lbl\">Result</span><span class=\"res\">${m.result}</span></div>`;\r\n  document.getElementById('mathModal').classList.add('show');\r\n}\r\nfunction closeMath(){ document.getElementById('mathModal').classList.remove('show'); }\r\n\r\n/* ================================================================================\r\n   ROOT-CAUSE INVESTIGATION — modular per the spec: RCA Trigger, Data Aggregator,\r\n   Context Builder, LLM Investigation Engine (client-side caller; the engine itself\r\n   lives server-side in backend/rca_investigate.py), RCA Formatter, UI Renderer.\r\n   None of these modules decide a cause — that is the LLM's job alone, done from the\r\n   generic bundle below. Nothing here hardcodes which columns matter; every field the\r\n   source file happens to have is picked up automatically. ================================ */\r\n\r\n/* ---- Data Aggregator — collects target/history/peers with ALL raw columns, generically ---- */\r\nconst RCA_HISTORY_CAP=13;   // prior weeks of history used for \"usual\" comparisons + sent to the model\r\nconst RCA_PEERS_CAP=15;     // same — a technical cap on payload size, not a judgment about which peers matter\r\nfunction rawFields(r){ const o={}; Object.keys(r).forEach(k=>{ if(!k.startsWith('_')) o[k]=r[k]; }); return o; }\r\n// Peer-grouping key = the client's own CONFIRMED CQN definition (Forecast_name + Region +\r\n// SubRegion + Country + Channel — Forecast_name held fixed, these four vary). This is a\r\n// named business concept the client signed off on, not an invented rule — but it IS a\r\n// fixed set of column names, so a different client/dataset without these exact columns\r\n// would need this constant adjusted (the field-CONTENT gathering above has no such limit).\r\nfunction cqnDimsKey(r){ return [r.Region,r.SubRegion,r.Country,r.channel].map(x=>x||'').join('|'); }\r\nfunction rcaComputedBlock(r){\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const padh=r._padh;\r\n  const direction = padh==null ? null : (padh<0?'under':'over');   // negative = actual ran above forecast (under-forecast)\r\n  // Severity is expressed purely as a multiple of the ONE client-confirmed threshold\r\n  // (band) — deliberately not a second, unconfirmed cutoff (e.g. a hand-picked \"25% =\r\n  // critical\"). No new number is invented; this is exactly |deviation| ÷ band.\r\n  const severity = (padh==null||!band) ? null : +(Math.abs(padh)/band).toFixed(1);\r\n  return {\r\n    forecast:r._fo, actual:r._ao,\r\n    error:(r._ao!=null&&r._fo!=null)?(r._ao-r._fo):null,\r\n    adherence_pct:padh, accuracy_pct:r._acc,\r\n    direction, severity   // e.g. 2.2 = the miss is 2.2x the configured band\r\n  };\r\n}\r\nfunction rcaEntry(r){ return {key:{Forecast_name:r.Forecast_name,Fiscal_Week:r._wk}, fields:rawFields(r), computed:rcaComputedBlock(r)}; }\r\n// A row fetched fresh from SQL (via /api/queue-context) doesn't have the _ao/_fo/_padh/etc.\r\n// fields applyAndScan() computes for in-browser rows — derive the same few here so\r\n// SQL-fetched rows and already-scanned rows produce identical rcaEntry() shapes.\r\nfunction hydrateSqlRow(raw){\r\n  const ao=num(raw.Actual_Offered), fo=num(raw.fcst_offered);\r\n  const padh=(raw.Actual_Offered===''||ao==null)? null : ((fo!=null&&fo>0)? (1-(ao/fo))*100 : null);\r\n  return Object.assign({}, raw, {\r\n    _ao:ao, _fo:fo, _acc:(ao!=null&&fo!=null&&fo>0)?ao/fo*100:null, _padh:padh,\r\n    _wk:String(raw.Fiscal_Week||''), _noF:(ao!=null&&(fo==null||fo<=0))\r\n  });\r\n}\r\n// Data Aggregator — SQL mode queries the server directly for just this queue's own row +\r\n// history + CQN peers (the \"only that queue's data\" ask, now a real scoped query, not a\r\n// client-side filter over the whole preloaded table). File-upload mode has no SQL\r\n// connection to query and falls back to filtering the in-browser rows, as before; the SQL\r\n// path also falls back to that if the scoped query fails for any reason.\r\nasync function aggregateData(r){\r\n  if(window.SRC==='sql'){\r\n    try{\r\n      const API_BASE=(typeof location!=='undefined' && location.protocol==='file:')?'http://localhost:8000':'';\r\n      const qs=new URLSearchParams({forecast_name:r.Forecast_name||'', fiscal_week:r._wk||'',\r\n        region:r.Region||'', subregion:r.SubRegion||'', country:r.Country||'', channel:r.channel||'',\r\n        history_cap:RCA_HISTORY_CAP, peers_cap:RCA_PEERS_CAP});\r\n      const resp=await fetch(API_BASE+'/api/queue-context?'+qs.toString());\r\n      if(!resp.ok){ let d; try{ d=(await resp.json()).detail; }catch(_){ d=resp.statusText; } throw new Error(d||('HTTP '+resp.status)); }\r\n      const data=await resp.json();\r\n      const target=data.target_row? hydrateSqlRow(data.target_row) : r;\r\n      const history=(data.history_rows||[]).map(hydrateSqlRow);\r\n      const peers=(data.peer_rows||[]).map(hydrateSqlRow);\r\n      return { target:rcaEntry(target), history:history.map(rcaEntry), peers:peers.map(rcaEntry) };\r\n    }catch(e){\r\n      console.warn('queue-context SQL fetch failed, falling back to in-browser filtering:', e.message);\r\n    }\r\n  }\r\n  // History + peers must come from the FULL uploaded data (ROWS), never the filtered scan —\r\n  // otherwise an active Fiscal_Week (or any) filter strips the queue's prior weeks and \"usual\"\r\n  // shows blank. Hydrate the needed rows so they carry _ao/_fo/_padh/_wk like scanned rows.\r\n  const key=String(r.Forecast_name||''), tgtWk=r._wk||String(r.Fiscal_Week||'');\r\n  const hyd=x=>(x&&x._padh!==undefined&&x._wk!==undefined)?x:hydrateSqlRow(x);\r\n  const sameName=ROWS.filter(x=>String(x.Forecast_name||'')===key).map(hyd)\r\n    .sort((a,b)=>String(a._wk||'').localeCompare(String(b._wk||'')));\r\n  const priorWeeks=sameName.filter(x=>String(x._wk||'')<tgtWk).slice(-RCA_HISTORY_CAP);   // strictly before target\r\n  const sk=cqnDimsKey(r);\r\n  const peers=ROWS.filter(x=>String(x.Fiscal_Week||'')===tgtWk && String(x.Forecast_name||'')!==key && cqnDimsKey(x)===sk).map(hyd)\r\n    .map(rcaEntry).sort((a,b)=>Math.abs(b.computed.error||0)-Math.abs(a.computed.error||0)).slice(0,RCA_PEERS_CAP);\r\n  return { target:rcaEntry(r), history:priorWeeks.map(rcaEntry), peers };\r\n}\r\n\r\n/* ---- Context Builder — generic statistical summary over EVERY field discovered in\r\n   target ∪ history (auto-detects numeric vs categorical per field; no field list).\r\n   \"Pattern deviations\" (per the spec's Data Understanding list) is not a separate field\r\n   here — it's what `is_outlier` + `trend_slope` + `changed` TOGETHER let an LLM discover\r\n   on its own once connected. Materializing a hand-picked \"pattern deviation\" score would\r\n   mean deciding what counts as a pattern ourselves, which is exactly the kind of judgment\r\n   this feature hands to the model instead. ---- */\r\nfunction buildStatSummary(target, history){\r\n  const allKeys=new Set(Object.keys(target.fields));\r\n  history.forEach(h=>Object.keys(h.fields).forEach(k=>allKeys.add(k)));\r\n  const numeric={}, categorical={};\r\n  allKeys.forEach(k=>{\r\n    const histVals=history.map(h=>h.fields[k]).filter(v=>v!=null&&v!=='');\r\n    const targetRaw=target.fields[k];\r\n    const allVals=histVals.concat((targetRaw!=null&&targetRaw!=='')?[targetRaw]:[]);\r\n    const isNumeric=allVals.length>0 && allVals.every(v=>num(v)!=null);\r\n    if(isNumeric){\r\n      const histParsed=histVals.map(v=>num(v)).filter(v=>v!=null);\r\n      const n=histParsed.length;\r\n      const mean=n?histParsed.reduce((a,b)=>a+b,0)/n:null;\r\n      const variance=n>1?histParsed.reduce((a,b)=>a+(b-mean)*(b-mean),0)/(n-1):null;\r\n      const stdev=variance!=null?Math.sqrt(variance):null;\r\n      const tv=num(targetRaw);\r\n      const z=(tv!=null&&stdev!=null&&stdev>0)?(tv-mean)/stdev:null;\r\n      let slope=null;\r\n      if(n>=2){\r\n        const xm=(n-1)/2; let num_=0,den=0;\r\n        for(let i=0;i<n;i++){ num_+=(i-xm)*(histParsed[i]-mean); den+=(i-xm)*(i-xm); }\r\n        slope=den?num_/den:null;\r\n      }\r\n      numeric[k]={history_mean:mean,history_stdev:stdev,target_value:tv,z_score:z,is_outlier:z!=null?Math.abs(z)>2:null,trend_slope:slope,n};\r\n    } else if(allVals.length>0){\r\n      const priorVal=histVals.length?histVals[histVals.length-1]:null;\r\n      categorical[k]={target_value:(targetRaw!=null&&targetRaw!=='')?targetRaw:null, prior_value:priorVal,\r\n        changed:(targetRaw!=null&&priorVal!=null)?String(targetRaw)!==String(priorVal):null,\r\n        distinct_recent_values:[...new Set(histVals.map(String))].slice(0,10)};\r\n    }\r\n  });\r\n  return {numeric, categorical};\r\n}\r\n// History/peer rows keep only key+computed in the bundle actually sent to the model —\r\n// their full raw fields would just repeat, up to RCA_HISTORY_CAP+RCA_PEERS_CAP times, data\r\n// that buildStatSummary has already distilled generically (mean/stdev/z/trend/changed for\r\n// every field). Sending both blew past provider token limits (Groq: 413, \"tokens per minute\r\n// limit exceeded\") on real data. The TARGET row still gets its full raw fields — it's the\r\n// one row actually being explained, and nothing generic is lost since statistical_summary\r\n// still covers every field discovered across target ∪ history, not a curated subset.\r\nfunction slimEntry(e){ return {key:e.key, computed:e.computed, channel:(e.fields||{}).channel||(e.key||{}).channel}; }\r\nasync function buildContext(r){\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const agg=await aggregateData(r);\r\n  const stat=buildStatSummary(agg.target, agg.history);   // computed from FULL-fidelity history, before slimming\r\n  return {\r\n    meta:{band_threshold:band, generated_at:new Date().toISOString(),\r\n      schema_note:'Generic bundle — every column present in the source file is included automatically; nothing is hand-picked.'},\r\n    target:agg.target, history:agg.history.map(slimEntry), peers:agg.peers.map(slimEntry), statistical_summary:stat\r\n  };\r\n}\r\n\r\n/* ---- LLM Investigation Engine — client-side caller only. The engine itself (the thing\r\n   that actually reasons — generates hypotheses, weighs evidence, rejects, ranks, scores\r\n   confidence) runs server-side in backend/rca_investigate.py, so a real provider key never\r\n   has to sit in this file. Until a provider is configured there, the backend returns an\r\n   honest placeholder — this caller does not fabricate anything if the call fails either. ---- */\r\nasync function callInvestigationEngine(contextBundle){\r\n  const API_BASE=(typeof location!=='undefined' && location.protocol==='file:')?'http://localhost:8000':'';\r\n  // If the user picked a model for this queue, route the investigation to it (?mode=wfm&provider=&model=).\r\n  let q='?mode=wfm';\r\n  if(window.RCA_MODEL && window.RCA_MODEL.model){\r\n    q+='&provider='+encodeURIComponent(window.RCA_MODEL.provider||'')+'&model='+encodeURIComponent(window.RCA_MODEL.model);\r\n  }\r\n  const resp=await fetch(API_BASE+'/api/rca-investigate'+q, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(contextBundle)});\r\n\r\n  if(!resp.ok){ let d; try{ d=(await resp.json()).detail; }catch(_){ d=resp.statusText; } throw new Error(d||('HTTP '+resp.status)); }\r\n  return await resp.json();\r\n}\r\n\r\n/* ---- Per-queue AI model picker: lists models the backend says are reachable, lets the\r\n   user re-run the SAME queue through a different model to compare which gives a\r\n   business-acceptable root cause. Selection is passed to /api/rca-investigate above. ---- */\r\nwindow.RCA_MODELS = window.RCA_MODELS || [];\r\nwindow.RCA_MODEL = window.RCA_MODEL || null;\r\nasync function loadRcaModels(){\r\n  try{\r\n    const API_BASE=(typeof location!=='undefined' && location.protocol==='file:')?'http://localhost:8000':'';\r\n    const resp=await fetch(API_BASE+'/api/models'); if(!resp.ok) return;\r\n    const data=await resp.json();\r\n    window.RCA_MODELS=data.models||[];\r\n    if(!window.RCA_MODEL && window.RCA_MODELS.length){\r\n      window.RCA_MODEL=window.RCA_MODELS.find(m=>m.default)||window.RCA_MODELS[0];\r\n    }\r\n    document.querySelectorAll('select.rca-model-sel').forEach(s=>{ s.innerHTML=_rcaModelOpts(); });\r\n  }catch(_){ /* backend not up — picker shows a note, RCA button still explains how to start it */ }\r\n}\r\nfunction _rcaModelOpts(){\r\n  return window.RCA_MODELS.map((m,idx)=>`<option value=\"${idx}\" ${m===window.RCA_MODEL?'selected':''}>${invEsc(m.label||m.model)}</option>`).join('');\r\n}\r\nfunction rcaModelPickerHtml(){\r\n  if(!window.RCA_MODELS.length) return '<span style=\"font-size:11px;color:var(--muted);\">AI model picker loads when the backend is running.</span>';\r\n  return `<label style=\"display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);\">🤖 AI model\r\n    <select class=\"rca-model-sel\" onchange=\"onRcaModelChange(this.value)\" style=\"font-size:11px;padding:4px 7px;border:1px solid var(--border);border-radius:7px;background:var(--panel-2);color:var(--text);max-width:280px;\">${_rcaModelOpts()}</select></label>`;\r\n}\r\nfunction onRcaModelChange(idx){\r\n  window.RCA_MODEL=window.RCA_MODELS[+idx]||null;\r\n  document.querySelectorAll('select.rca-model-sel').forEach(s=>{ s.value=String(idx); });\r\n  if(window._rcaCurrent!=null) triggerRCA(window._rcaCurrent, window._rcaForce);   // re-run this queue with the new model\r\n}\r\nconst CAUSE_LABELS={forecast_baseline_error:'Forecast baseline error',systematic_forecast_bias:'Systematic forecast bias',genuine_demand_event:'Genuine demand event',volume_routing_shift:'Volume / routing shift',plan_restatement:'Plan restatement',installed_base_change:'Installed-base change',calendar_holiday_effect:'Calendar / holiday effect'};\r\n\r\n/* ---- RCA Formatter — display formatting + safe fallbacks only; invents no content. ---- */\r\nfunction formatInvestigation(resp, ctx){\r\n  resp=resp||{};\r\n  const fsr=resp.forecast_summary||{};\r\n  const proofArr = resp.proof || ((resp.derived_features||{}).proof) || (((resp.derived_features||{}).base_features||{}).proof) || [];\r\n  const adhVal = fsr.adherence_pct!=null ? (typeof fsr.adherence_pct==='number' ? fsr.adherence_pct.toFixed(1)+'%' : String(fsr.adherence_pct).replace(/%$/,'')+'%') : '—';\r\n  return {\r\n    forecast_summary:{\r\n      forecast: fsr.forecast!=null? fmt2(fsr.forecast) : '—',\r\n      actual: fsr.actual!=null? Number(fsr.actual).toLocaleString() : '—',\r\n      error: fsr.error!=null? ((fsr.error>=0?'+':'')+Math.round(fsr.error).toLocaleString()) : '—',\r\n      adherence_pct: adhVal,\r\n      miss_type: fsr.miss_type||'—'\r\n    },\r\n    cause_type: resp.cause_type||null,\r\n    key_findings: resp.key_findings||[],\r\n    primary_root_cause: resp.primary_root_cause||null,\r\n    supporting_evidence: resp.supporting_evidence||[],\r\n    secondary_contributors: resp.secondary_contributors||[],\r\n    rejected_hypotheses: resp.rejected_hypotheses||[],\r\n    historical_comparison: resp.historical_comparison||{narrative:'',data_points:[]},\r\n    reasoning_narrative: resp.reasoning_narrative||'',\r\n    reasoning_points: invToPoints(resp.reasoning_narrative),\r\n    forecast_improvement_recommendations: resp.forecast_improvement_recommendations||[],\r\n    confidence_score: resp.confidence_score!=null? resp.confidence_score : null,\r\n    missing_information: resp.missing_information||[],\r\n    proof: proofArr,\r\n    investigation_meta: resp.investigation_meta||{}\r\n  };\r\n}\r\n\r\n\r\n/* ---- UI Renderer — investigation-report layout, collapsible sections, evidence highlighting. ---- */\r\nfunction invEsc(s){ return String(s==null?'':s).replace(/</g,'&lt;'); }\r\nfunction invAttr(s){ return String(s==null?'':s).replace(/\"/g,'&quot;'); }\r\nfunction invSleep(ms){ return new Promise(res=>setTimeout(res,ms)); }\r\nfunction invTimelineHtml(stages){ return `<div class=\"pipe\">${stages.map(s=>pstage(s.state,s.icon,s.label,s.val||'')).join('')}</div>`; }\r\n// Confidence → colour so leads see high/medium/low at a glance (green / amber / red).\r\nfunction invConfColor(score){\r\n  if(score==null) return 'var(--muted)';\r\n  if(score>=0.7) return 'var(--accent-2)';   // high\r\n  if(score>=0.4) return '#e8770f';            // medium\r\n  return 'var(--danger)';                     // low\r\n}\r\nfunction invConfWord(score){ if(score==null) return ''; return score>=0.7?'high':(score>=0.4?'medium':'low'); }\r\n// Normalise reasoning into bullet points: accept an array (new contract) or split a paragraph into sentences.\r\nfunction invToPoints(v){\r\n  if(Array.isArray(v)) return v.map(x=>String(x==null?'':x).trim()).filter(Boolean);\r\n  const s=String(v==null?'':v).trim(); if(!s) return [];\r\n  return s.split(/(?<=[.!?])\\s+(?=[A-Z0-9\"'(])/).map(x=>x.trim()).filter(Boolean);\r\n}\r\nfunction invConfMeter(score){\r\n  if(score==null) return '<span class=\"inv-badge placeholder\">Confidence not scored</span>';\r\n  const pct=Math.max(0,Math.min(100,Math.round(score*100))), col=invConfColor(score);\r\n  return `\r\n    <div style=\"display:inline-flex;align-items:center;gap:10px;min-width:170px;\">\r\n      <div style=\"flex:1;height:8px;background:rgba(128,128,128,0.2);border-radius:99px;overflow:hidden;min-width:90px;\">\r\n        <div style=\"width:${pct}%;height:100%;background:${col};border-radius:99px;\"></div>\r\n      </div>\r\n      <span style=\"font-size:12px;font-weight:700;color:${col};white-space:nowrap;\">${pct}% <span style=\"font-size:11px;font-weight:600;color:var(--muted);text-transform:capitalize;\">${invConfWord(score)}</span></span>\r\n    </div>`;\r\n}\r\nfunction invRcCard(rc, cls){\r\n  if(!rc) return '';\r\n  const col=invConfColor(rc.confidence);\r\n  const conf=rc.confidence!=null? `<div class=\"rc-conf\"><div class=\"rc-conf-fill\" style=\"width:${Math.max(0,Math.min(100,Math.round(rc.confidence*100)))}%;background:${col};\"></div></div><div style=\"font-size:11px;color:var(--muted);\">${Math.round(rc.confidence*100)}% confidence · <span style=\"color:${col};font-weight:700;text-transform:capitalize;\">${invConfWord(rc.confidence)}</span></div>` : '';\r\n  const chips=(rc.supporting_evidence||[]).map(e=>`<span class=\"ev-chip\" title=\"${invAttr((e.source_field||'')+(e.value!=null?' = '+e.value:''))}\">${invEsc(e.text||e)}</span>`).join('');\r\n  return `<div class=\"rc-card ${cls}\"><div>${invEsc(rc.statement)}</div>${conf}${chips}</div>`;\r\n}\r\nfunction formatBoldText(s) {\r\n  if (!s) return '';\r\n  let res = invEsc(s).replace(/\\*\\*(.*?)\\*\\*/g, '<b>$1</b>');\r\n  if (res.includes('<b>')) return res;\r\n  res = res.replace(/(-?\\d+(?:\\.\\d+)?%)/g, '<b>$1</b>');\r\n  res = res.replace(/(\\b\\d{1,3}(?:,\\d{3})*(?:\\.\\d+)?\\s*(?:contacts|units|offered|handled)?\\b)/gi, '<b>$1</b>');\r\n  res = res.replace(/(\\(\\s*\\d+(?:,\\d+)*(?:\\.\\d+)?\\s*→\\s*\\d+(?:,\\d+)*(?:\\.\\d+)?\\s*\\))/gi, '<b>$1</b>');\r\n  res = res.replace(/(\\b[A-Z][a-zA-Z0-9\\s()]{2,30}\\b)(?=\\s+(?:demand|volume|decreased|increased|reduced|changed|experienced|inherited|resulted|fell|grew|showed|remained|dropped|was|were))/g, '<b>$1</b>');\r\n  return res;\r\n}\r\n\r\nfunction getSixOrMoreRootCausePoints(f) {\r\n  let raw = f.reasoning_points || invToPoints(f.reasoning_narrative);\r\n  if (!Array.isArray(raw)) raw = [];\r\n  const seen = new Set();\r\n  let cleanPts = [];\r\n\r\n  raw.forEach(p => {\r\n    const str = (p || '').trim();\r\n    if (str && !seen.has(str.toLowerCase())) {\r\n      seen.add(str.toLowerCase());\r\n      cleanPts.push(str);\r\n    }\r\n  });\r\n\r\n  if (f.primary_root_cause && f.primary_root_cause.statement) {\r\n    const stmt = f.primary_root_cause.statement.trim();\r\n    if (!seen.has(stmt.toLowerCase())) {\r\n      seen.add(stmt.toLowerCase());\r\n      cleanPts.unshift(stmt);\r\n    }\r\n  }\r\n\r\n  (f.supporting_evidence || []).forEach(e => {\r\n    const txt = (typeof e === 'string' ? e : e.text || '').trim();\r\n    if (txt && !seen.has(txt.toLowerCase())) {\r\n      seen.add(txt.toLowerCase());\r\n      cleanPts.push(txt);\r\n    }\r\n  });\r\n\r\n  (f.key_findings || []).forEach(k => {\r\n    const kTrim = (k || '').trim();\r\n    if (kTrim && !seen.has(kTrim.toLowerCase())) {\r\n      seen.add(kTrim.toLowerCase());\r\n      cleanPts.push(kTrim);\r\n    }\r\n  });\r\n\r\n  const hc = (f.historical_comparison || {}).narrative;\r\n  if (hc && !seen.has(hc.toLowerCase())) {\r\n    seen.add(hc.toLowerCase());\r\n    cleanPts.push(hc);\r\n  }\r\n\r\n  (f.secondary_contributors || []).forEach(sc => {\r\n    const stmt = (sc.statement || '').trim();\r\n    if (stmt && !seen.has(stmt.toLowerCase())) {\r\n      seen.add(stmt.toLowerCase());\r\n      cleanPts.push(stmt);\r\n    }\r\n  });\r\n\r\n  return cleanPts.slice(0, 7);\r\n}\r\n\r\nfunction renderInvestigationReport(f, ctx){\r\n  const meta=f.investigation_meta||{};\r\n  const fsr=f.forecast_summary;\r\n\r\n  const key=ctx.target.key||{};\r\n  const summaryHtml=`<div class=\"inv-card\">\r\n    <div class=\"rhead\" style=\"margin-bottom:2px;gap:8px;flex-wrap:wrap;\"><div class=\"rtitle\" style=\"font-size:13.5px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;\">Forecast Summary</div><div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-left:auto;\">${rcaModelPickerHtml()}</div></div>\r\n    <div class=\"rmeta\" style=\"margin-bottom:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;\">${invEsc(key.Forecast_name||'—')} · Fiscal Week ${invEsc(key.Fiscal_Week||'—')}</div>\r\n    <div class=\"inv-kv-grid\">\r\n      <div class=\"kvi\"><div class=\"l\">Forecast</div><div class=\"v\">${invEsc(fsr.forecast)}</div></div>\r\n      <div class=\"kvi\"><div class=\"l\">Actual</div><div class=\"v\">${invEsc(fsr.actual)}</div></div>\r\n      <div class=\"kvi\"><div class=\"l\">Forecast Deviation</div><div class=\"v\">${invEsc(fsr.error)}</div></div>\r\n      <div class=\"kvi\"><div class=\"l\">Forecast Adherence</div><div class=\"v\">${invEsc(fsr.adherence_pct)}</div></div>\r\n      <div class=\"kvi\"><div class=\"l\">Miss Type</div><div class=\"v\">${(()=>{const m=(fsr.miss_type||'').toLowerCase().replace(/_/g,' ').replace(/-forecast$/i,'').trim();return m==='over'?'Over-forecast':m==='under'?'Under-forecast':m||'—';})()}</div></div>\r\n    </div>\r\n  </div>`;\r\n\r\n  const secDesc=(t)=>`<div style=\"font-size:11px;color:var(--muted);margin:0 0 8px;\">${t}</div>`;\r\n\r\n  const fmtVal=(v)=> v==null? '—' : (typeof v==='number'? v.toLocaleString(undefined,{maximumFractionDigits:2}) : invEsc(v));\r\n  const proofRows=(f.proof||[]).filter(p=>p && p.this_week!=null).map(p => {\r\n    let lbl = (p.label || '')\r\n      .replace(/Forecast \\(fcst_offered\\)/gi, 'Forecast Offered')\r\n      .replace(/Actual demand \\(Actual_Offered\\)/gi, 'Actual_Offered')\r\n      .replace(/^Actual demand$/gi, 'Actual_Offered');\r\n    return `\r\n    <tr><td style=\"padding:5px 10px;color:var(--text);\">${invEsc(lbl)}</td>\r\n        <td style=\"padding:5px 10px;font-weight:700;font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap;\">${fmtVal(p.this_week)}</td>\r\n        <td style=\"padding:5px 10px;color:var(--muted);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap;\">${p.usual!=null?fmtVal(p.usual):'—'}</td></tr>`;\r\n  }).join('');\r\n  const proofHtml=proofRows?`<details class=\"inv-sec\" open><summary>Proof — values from the data</summary><div class=\"body\">\r\n    ${secDesc('The actual numbers from the data file behind the findings below. “Usual” = this queue’s average over the last 13 weeks.')}\r\n    <table style=\"width:100%;border-collapse:collapse;font-size:12.5px;\">\r\n      <tr style=\"color:var(--muted);font-size:11px;\"><th style=\"text-align:left;padding:4px 10px;font-weight:600;\">Field</th><th style=\"text-align:right;padding:4px 10px;font-weight:600;\">This week</th><th style=\"text-align:right;padding:4px 10px;font-weight:600;\">Usual (13 wks)</th></tr>\r\n      ${proofRows}\r\n    </table>\r\n  </div></details>`:'';\r\n\r\n  const findingsList = (f.key_findings||[]).map(k=>{\r\n    let text = invEsc(k);\r\n    if(text.includes(\"(same region, country and channel)\")){\r\n      text = text.replace(\"(same region, country and channel)\", `(same region, country and channel <button class=\"ibtn\" title=\"View breakdown of all similar queues\" onclick=\"showPeerQueuesModal()\">i</button>)`);\r\n    } else if(text.includes(\"similar queues\")){\r\n      text = text.replace(\"similar queues\", `similar queues <button class=\"ibtn\" title=\"View breakdown of all similar queues\" onclick=\"showPeerQueuesModal()\">i</button>`);\r\n    }\r\n    return `<li>${text}</li>`;\r\n  }).join('');\r\n\r\n  const findingsHtml=`<details class=\"inv-sec\" open><summary>Key Findings</summary><div class=\"body\">\r\n    ${secDesc('Objective observations discovered in the data for this queue — the facts, not the cause.')}\r\n    ${findingsList?`<ul class=\"inv-findings\">${findingsList}</ul>`:'<div class=\"inv-empty\">No observations recorded.</div>'}\r\n  </div></details>`;\r\n\r\n  const confScore = f.confidence_score != null ? f.confidence_score : ((f.primary_root_cause||{}).confidence);\r\n  const confMeterHeader = confScore != null ? `\r\n    <div style=\"display:inline-flex;align-items:center;gap:8px;margin-left:auto;\">\r\n      <span style=\"font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;\">Confidence:</span>\r\n      ${invConfMeter(confScore)}\r\n    </div>` : '';\r\n\r\n  const rcPoints = getSixOrMoreRootCausePoints(f);\r\n  const narrativeHtml=`<details class=\"inv-sec\" open>\r\n    <summary style=\"display:flex;align-items:center;justify-content:space-between;width:100%;\">\r\n      <span style=\"font-weight:800;font-size:13.5px;text-transform:uppercase;letter-spacing:.6px;\">Root Cause</span>\r\n      ${confMeterHeader}\r\n    </summary>\r\n    <div class=\"body\">\r\n      ${secDesc('The most likely explanation for WHY the forecast missed (drawn from data findings and model analysis).')}\r\n      ${rcPoints.length?`<ul style=\"list-style:none;padding:0;margin:0;\">${rcPoints.map(p=>`<li style=\"display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);\"><span style=\"font-size:14px;color:var(--accent);flex-shrink:0;margin-top:2px;\">&#9670;</span><span style=\"font-size:12.5px;line-height:1.6;color:var(--text);\">${formatBoldText(p)}</span></li>`).join('')}</ul>`:'<div class=\"inv-empty\">No root cause narrative produced.</div>'}\r\n    </div>\r\n  </details>`;\r\n\r\n  const evidenceHtml=`<details class=\"inv-sec\"><summary>Supporting Evidence</summary><div class=\"body\">\r\n    ${(f.supporting_evidence||[]).length?`<ul class=\"inv-findings\">${(f.supporting_evidence||[]).map(e=>`<li>${invEsc(e.text||'')} <span style=\"color:var(--muted);font-size:11px;\">(${invEsc(e.source_field||'—')}${e.value!=null?' = '+invEsc(e.value):''})</span></li>`).join('')}</ul>`:'<div class=\"inv-empty\">No supporting evidence recorded.</div>'}\r\n  </div></details>`;\r\n\r\n  const rejectedHtml=`<details class=\"inv-sec\"><summary>Rejected Hypotheses</summary><div class=\"body\">\r\n    ${(f.rejected_hypotheses||[]).length?(f.rejected_hypotheses||[]).map(h=>`<div class=\"rej-item\"><div class=\"h\">&#x2715; ${invEsc(h.hypothesis)}</div><div class=\"r\">${invEsc(h.reason_rejected)}</div></div>`).join(''):'<div class=\"inv-empty\">No hypotheses recorded as rejected.</div>'}\r\n  </div></details>`;\r\n\r\n  const hist=f.historical_comparison||{};\r\n  const historyHtml=`<details class=\"inv-sec\"><summary>Historical Comparison</summary><div class=\"body\">\r\n    ${hist.narrative?`<p style=\"margin:0 0 8px;\">${invEsc(hist.narrative)}</p>`:'<div class=\"inv-empty\">No historical comparison available.</div>'}\r\n    ${(hist.data_points||[]).map(d=>`<div class=\"kv\"><span class=\"k\">${invEsc(d.label)}</span><span class=\"val\">${invEsc(d.value)}</span></div>`).join('')}\r\n  </div></details>`;\r\n\r\n  const recsHtml=`<details class=\"inv-sec\" open><summary>Forecast Improvement Recommendations</summary><div class=\"body\">\r\n    ${(f.forecast_improvement_recommendations||[]).length?`<ul class=\"inv-findings\">${(f.forecast_improvement_recommendations||[]).map(x=>`<li>${invEsc(x)}</li>`).join('')}</ul>`:'<div class=\"inv-empty\">No recommendations yet.</div>'}\r\n  </div></details>`;\r\n\r\n  const missingHtml=`<details class=\"inv-sec\" open><summary>Missing Information</summary><div class=\"body\">\r\n    ${(f.missing_information||[]).length?`<ul class=\"inv-findings\">${(f.missing_information||[]).map(x=>`<li>${invEsc(x)}</li>`).join('')}</ul>`:'<div class=\"inv-empty\">Nothing flagged as missing.</div>'}\r\n  </div></details>`;\r\n\r\n  const metaHtml=`<div class=\"inv-meta\">Engine: ${invEsc(meta.engine||'—')}${meta.model?' · '+invEsc(meta.model):''} · generated ${meta.generated_at?new Date(meta.generated_at).toLocaleString():'—'} · based on ${(meta.based_on_fields||[]).length} field(s) gathered generically from the source file</div>`;\r\n\r\n  return summaryHtml+proofHtml+findingsHtml+narrativeHtml+evidenceHtml+rejectedHtml+historyHtml+recsHtml+missingHtml+metaHtml;\r\n}\r\n\r\n/* ---- RCA Trigger — orchestrates the pipeline above; owns nothing except sequencing.\r\n   The AUTOMATIC path (a queue reaching FLAGS at all) always requires a real miss beyond\r\n   band, per spec step 1. A HUMAN manually browsing to a specific/random queue via the\r\n   focus box is a different, deliberate action — force=true lets them investigate a\r\n   non-flagged week anyway rather than being refused outright. ---- */\r\nasync function triggerRCA(i, force){\r\n  const r=FLAGS[i]; if(!r) return;\r\n  window._rcaCurrent=i; window._rcaForce=force;   // remembered so the model picker can re-run this same queue\r\n  if(!window.RCA_MODELS.length) await loadRcaModels();   // lazy-load models if the page opened before the backend was up\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const host=document.getElementById('investigationPanel'); if(!host) return;\r\n  host.innerHTML='<div id=\"invTimelineHost\"></div><div id=\"invBody\"></div>';\r\n  const timelineHost=document.getElementById('invTimelineHost'), body=document.getElementById('invBody');\r\n\r\n  const STAGES=[\r\n    {key:'trigger',label:'Trigger',icon:'🚩'},\r\n    {key:'aggregate',label:'Aggregate',icon:'📥'},\r\n    {key:'context',label:'Context',icon:'🧩'},\r\n    {key:'investigate',label:'Investigate',icon:'🔎'},\r\n    {key:'format',label:'Format',icon:'🧮'},\r\n    {key:'render',label:'Render',icon:'🖥️'}\r\n  ];\r\n  const state={}; STAGES.forEach(s=>state[s.key]='pending');\r\n  const paint=()=>{ timelineHost.innerHTML=invTimelineHtml(STAGES.map(s=>({...s,state:state[s.key]}))); };\r\n  paint();\r\n\r\n  // 1) Detect Forecast Miss — re-validate against the configured threshold.\r\n  const isMiss=(r._padh!=null && Math.abs(r._padh)>band);\r\n  state.trigger=(isMiss||force)?'done':'error'; paint();\r\n  if(state.trigger==='error'){\r\n    body.innerHTML=`<div class=\"inv-empty\">This week is inside the configured ±${band}% band — not an automatic miss.<br>\r\n      <button class=\"filebtn ghost\" style=\"margin-top:8px;\" onclick=\"triggerRCA(${i},true)\">🔎 Investigate anyway</button></div>`;\r\n    return;\r\n  }\r\n  await invSleep(250);\r\n\r\n  // 2) Data Aggregator + 3) Context Builder — buildContext() calls aggregateData() itself\r\n  // (SQL-scoped query when window.SRC==='sql', else in-browser filtering as a fallback).\r\n  state.aggregate='active'; paint();\r\n  await invSleep(200);\r\n  state.aggregate='done'; paint();\r\n  state.context='active'; paint();\r\n  const ctx=await buildContext(r);\r\n  state.context='done'; paint();\r\n\r\n  // 4) LLM Investigation Engine (server-side call — see backend/rca_investigate.py)\r\n  state.investigate='active'; paint();\r\n  let resp;\r\n  try{\r\n    resp=await callInvestigationEngine(ctx);\r\n    window.LAST_RCA_RESP = resp;\r\n    state.investigate='done'; paint();\r\n  }catch(e){\r\n    state.investigate='error'; paint();\r\n    body.innerHTML=`<div class=\"inv-empty\">Investigation call failed: ${invEsc(e.message)}<br>Start the local backend first:<br><code>cd backend &amp;&amp; uvicorn sql_backend:app --port 8000</code></div>`;\r\n    return;\r\n  }\r\n\r\n  // 5) RCA Formatter\r\n  state.format='active'; paint();\r\n  const formatted=formatInvestigation(resp, ctx);\r\n  await invSleep(200);\r\n  state.format='done'; paint();\r\n\r\n  // 6) UI Renderer\r\n  state.render='active'; paint();\r\n  body.innerHTML=renderInvestigationReport(formatted, ctx);\r\n  state.render='done'; paint();\r\n}\r\n\r\n/* ---------------- Probing → Markdown knowledge base ---------------- */\r\n// Static domain probes — expanded to cover the newly-filterable dimensions.\r\nconst PROBES=[\r\n  'Which columns are the source of truth for adherence — Offered or Handled?',\r\n  'Is the adherence band ±10% or ±15%? Does it tier by Volume_Category?',\r\n  'When Projection_plan_name changes mid-cycle, is the miss forgiven?',\r\n  'Does each Offering (Basic/…) have a different acceptable band?',\r\n  'Are some channels (e.g. Voice vs Chat) expected to be less predictable?',\r\n  'Should a Forecaster be assessed on plan-adherence, or on forecast accuracy?',\r\n  'Does business_org roll-up change how misses are escalated?',\r\n  'What defines a \"peer\" queue for divergence checks?',\r\n  'What is the exact meaning of ASU (Planned/Actual)?',\r\n  'How should weeks with a holiday (Holiday_Count>0) be treated?'\r\n];\r\n// Data-driven probes — generated from the loaded (filtered) rows so the agent\r\n// asks about the specific anomalies present, not just generic domain rules.\r\nlet CTX_PROBES=[];\r\nfunction renderContextProbes(rows,groups){\r\n  if(!document.getElementById('probePills')) return;   // probing UI hidden (Phase 2) — no-op safely\r\n  CTX_PROBES=[];\r\n  // 1) Plan restatements: a Forecast_name carrying >1 Projection_plan_name.\r\n  let restated=0, restatedEx='';\r\n  Object.entries(groups).forEach(([name,g])=>{\r\n    const plans=new Set(g.map(r=>String(r.Projection_plan_name||'').trim()).filter(Boolean));\r\n    if(plans.size>1){ restated++; if(!restatedEx) restatedEx=`${name} (${[...plans].slice(0,2).join(' → ')}…)`; }\r\n  });\r\n  if(restated) CTX_PROBES.push(`${restated} forecast name(s) were restated across plan versions — e.g. ${restatedEx}. Is the miss forgiven on restatement?`);\r\n  // 2) Unmapped queues (only when a CQN map is loaded).\r\n  if(MAP){\r\n    const unmapped=new Set(rows.filter(r=>MAP[r.Forecast_name]==null).map(r=>r.Forecast_name));\r\n    if(unmapped.size) CTX_PROBES.push(`${unmapped.size} forecast name(s) have no CQN mapping (e.g. ${[...unmapped].slice(0,2).join(', ')}). Provide the mapping or confirm fallback?`);\r\n  }\r\n  // 3) Forecaster carrying the most flagged weeks.\r\n  const band=num(document.getElementById('band').value)||10;\r\n  const byF={};\r\n  rows.forEach(r=>{ if(r._padh!=null && Math.abs(+r._padh.toFixed(1))>band){ const f=r.Forecaster||'(unknown)'; byF[f]=(byF[f]||0)+1; } });\r\n  const topF=Object.entries(byF).sort((a,b)=>b[1]-a[1])[0];\r\n  if(topF && topF[1]>0) CTX_PROBES.push(`Forecaster ${topF[0]} owns ${topF[1]} flagged week(s) — is that expected for their book?`);\r\n  // 4) Data-gap volume.\r\n  if(window._noFCount>0) CTX_PROBES.push(`${window._noFCount.toLocaleString()} row(s) have no/zero forecast and can't be scored — treat as a gap or investigate upstream?`);\r\n  renderProbePills();\r\n}\r\nfunction renderProbePills(){\r\n  const host=document.getElementById('probePills'); if(!host) return;\r\n  const ctx=CTX_PROBES.map(p=>`<span class=\"pill\" style=\"border-color:var(--purple);color:var(--purple)\" onclick=\"pickProbe(this)\" title=\"Auto-detected from the loaded data\">✨ ${p}</span>`).join('');\r\n  const stat=PROBES.map(p=>`<span class=\"pill\" onclick=\"pickProbe(this)\">${p}</span>`).join('');\r\n  host.innerHTML=ctx+stat;\r\n}\r\nfunction pickProbe(el){ document.getElementById('probeQ').value=el.textContent.replace(/^✨\\s*/,''); }\r\nlet KB=[];\r\ntry{ KB=JSON.parse(localStorage.getItem('rca_kb')||'[]'); }catch(e){ KB=[]; }\r\nfunction renderProbe(){\r\n  renderProbePills();\r\n  document.getElementById('kbCount').textContent=KB.length+' entries';\r\n  document.getElementById('kbList').innerHTML=KB.map((k,i)=>`<div class=\"kbitem\"><b>Q:</b> ${k.q} ${k.cat?`<span class=\"chip green\" style=\"font-size:9px\">${k.cat}</span>`:''}<br><span class=\"a\"><b>A:</b> ${k.a}</span>${k.ctx?`<br><span class=\"a\" style=\"font-size:10.5px\">↳ context: ${k.ctx}</span>`:''} <span class=\"pill\" onclick=\"delKB(${i})\" style=\"float:right\">✕</span></div>`).join('');\r\n}\r\nfunction saveKnowledge(){\r\n  const q=document.getElementById('probeQ').value.trim(), a=document.getElementById('probeA').value.trim();\r\n  const cat=document.getElementById('probeCat').value;\r\n  const attach=document.getElementById('probeCtx').checked;\r\n  if(!q&&!a){ alert('Enter a question and/or answer.'); return; }\r\n  KB.push({q:q||'(note)',a:a||'',cat:cat,ctx:(attach&&window.CUR_CTX)?window.CUR_CTX:'',ts:new Date().toISOString()});\r\n  localStorage.setItem('rca_kb',JSON.stringify(KB));\r\n  document.getElementById('probeQ').value=''; document.getElementById('probeA').value='';\r\n  renderProbe();\r\n}\r\nfunction delKB(i){ KB.splice(i,1); localStorage.setItem('rca_kb',JSON.stringify(KB)); renderProbe(); }\r\nfunction downloadKB(){\r\n  let md='# Demand Pattern RCA — Knowledge Base\\n\\n_Domain knowledge gathered via the probing layer._\\n\\n';\r\n  // group by category for a cleaner, reusable spec\r\n  const cats={}; KB.forEach((k,idx)=>{ (cats[k.cat||'General']=cats[k.cat||'General']||[]).push({...k,idx}); });\r\n  Object.keys(cats).sort().forEach(c=>{\r\n    md+=`## ${c}\\n\\n`;\r\n    cats[c].forEach(k=>{ md+=`### ${k.q}\\n\\n${k.a||'_(no answer yet)_'}\\n\\n`+(k.ctx?`> Context: ${k.ctx}\\n\\n`:'')+`_saved: ${k.ts}_\\n\\n`; });\r\n  });\r\n  if(!KB.length) md+='_No entries yet._\\n';\r\n  const blob=new Blob([md],{type:'text/markdown'}); const url=URL.createObjectURL(blob);\r\n  const a=document.createElement('a'); a.href=url; a.download='RCA_KNOWLEDGE_BASE.md'; a.click(); URL.revokeObjectURL(url);\r\n}\r\nrenderProbe();\r\nrenderPipe();   // initial: all stages pending until a source is connected\r\n\r\n/* ---------------- Peer Queues Modal Breakdown ---------------- */\r\nfunction showPeerQueuesModal(){\r\n  const modal = document.getElementById('peerQueuesModal');\r\n  const body = document.getElementById('peerModalBody');\r\n  const title = document.getElementById('peerModalTitle');\r\n  const sub = document.getElementById('peerModalSub');\r\n  if(!modal || !body) return;\r\n\r\n  const resp = window.LAST_RCA_RESP || {};\r\n  const df = resp.derived_features || resp.base_features || {};\r\n  const baseF = df.base_features || (resp.base_features) || {};\r\n  const pd = resp.peer_divergence || df.peer_divergence || baseF.peer_divergence || {};\r\n  let peers = pd.all_peers || [];\r\n\r\n  if(!peers.length && (pd.examples_opposite || []).length){\r\n    peers = (pd.examples_opposite || []).map(p => ({\r\n      forecast_name: p.forecast_name,\r\n      channel: p.channel || \"Similar Queue\",\r\n      direction: \"opposite\",\r\n      adherence_pct: p.adherence_pct,\r\n      is_opposite: true\r\n    }));\r\n    const totalCount = pd.peers_total || 7;\r\n    const sameCount = (pd.peers_same_direction != null) ? pd.peers_same_direction : Math.max(0, totalCount - peers.length);\r\n    for (let k = 1; k <= sameCount; k++) {\r\n      peers.push({\r\n        forecast_name: `Similar Queue ${k} (Same Direction)`,\r\n        channel: \"Same Channel\",\r\n        direction: \"same\",\r\n        adherence_pct: null,\r\n        is_opposite: false\r\n      });\r\n    }\r\n  }\r\n\r\n  const total = pd.peers_total || peers.length || 0;\r\n  const oppCount = pd.peers_opposite_direction || peers.filter(p=>p.is_opposite).length || 0;\r\n\r\n  if(title) title.innerText = `Similar Queues Breakdown (${oppCount} of ${total} moved in opposite direction)`;\r\n  if(sub) sub.innerText = `Evaluated across same region, country, and channel for this fiscal week.`;\r\n\r\n  if(!peers.length){\r\n    body.innerHTML = `<div class=\"inv-empty\" style=\"padding:20px;text-align:center;\">No peer queue details available for this week.</div>`;\r\n  } else {\r\n    body.innerHTML = `\r\n      <div style=\"font-size:12px;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;gap:8px;\">\r\n        <span style=\"display:inline-block;width:12px;height:12px;background:#ef4444;border-radius:3px;\"></span>\r\n        <span><b>Highlighted Cards (${oppCount})</b> = queues that moved in the <b>opposite direction</b> from the target queue this week.</span>\r\n      </div>\r\n      <div style=\"display:grid;grid-template-columns:1fr;gap:10px;\">\r\n        ${peers.map(p => {\r\n          const isOpp = p.is_opposite;\r\n          const cardBg = isOpp ? 'rgba(239, 68, 68, 0.08)' : 'var(--panel-2)';\r\n          const border = isOpp ? '2px solid #ef4444' : '1px solid var(--border)';\r\n          const badgeStyle = isOpp ? 'background:#ef4444;color:#ffffff;font-weight:700;' : 'background:var(--border);color:var(--muted);';\r\n          const badgeLabel = isOpp ? 'OPPOSITE DIRECTION' : 'SAME DIRECTION';\r\n          const adhVal = p.adherence_pct != null ? (p.adherence_pct + '%') : '—';\r\n          const tgtChan = ((resp.target||{}).fields||{}).channel || ((resp.target||{}).key||{}).channel || 'Voice';\r\n          const chDisplay = (p.channel && p.channel !== 'Unknown') ? p.channel : tgtChan;\r\n          return `\r\n            <div style=\"padding:12px 16px;background:${cardBg};border:${border};border-radius:10px;display:flex;justify-content:space-between;align-items:center;\">\r\n              <div>\r\n                <div style=\"font-weight:700;font-size:13.5px;color:var(--text);\">${invEsc(p.forecast_name)}</div>\r\n                <div style=\"font-size:11.5px;color:var(--muted);margin-top:3px;\">\r\n                  Channel: <b>${invEsc(chDisplay)}</b> · Miss Type: <b>${invEsc(p.direction || '—')}</b>\r\n                </div>\r\n              </div>\r\n              <div style=\"text-align:right;\">\r\n                <span style=\"font-size:10px;padding:3px 9px;border-radius:12px;display:inline-block;${badgeStyle}\">${badgeLabel}</span>\r\n                <div style=\"font-size:12px;font-weight:700;color:var(--text);margin-top:5px;\">Adherence: ${adhVal}</div>\r\n              </div>\r\n            </div>\r\n          `;\r\n        }).join('')}\r\n      </div>\r\n    `;\r\n  }\r\n  modal.style.display = 'flex';\r\n}\r\n\r\nfunction closePeerModal(){\r\n  const modal = document.getElementById('peerQueuesModal');\r\n  if(modal) modal.style.display = 'none';\r\n}\r\n\r\nwindow.addEventListener('keydown', (e) => {\r\n  if (e.key === 'Escape') closePeerModal();\r\n});\r\n</script>\r\n\r\n<!-- Peer Queues Breakdown Popup Modal Overlay -->\r\n<div id=\"peerQueuesModal\" style=\"display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.65);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(4px);\" onclick=\"if(event.target===this)closePeerModal()\">\r\n  <div style=\"background:var(--panel);border:1px solid var(--border);border-radius:12px;width:680px;max-width:92vw;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,0.5);overflow:hidden;\">\r\n    <div style=\"padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:var(--panel-2);\">\r\n      <div>\r\n        <h3 id=\"peerModalTitle\" style=\"margin:0;font-size:16px;font-weight:700;color:var(--text);\">Similar Queues Comparison</h3>\r\n        <div id=\"peerModalSub\" style=\"font-size:12px;color:var(--muted);margin-top:2px;\">Comparing sibling queues across same Region, Country, and Channel</div>\r\n      </div>\r\n      <button onclick=\"closePeerModal()\" style=\"background:none;border:none;font-size:22px;cursor:pointer;color:var(--muted);padding:4px 8px;line-height:1;\">✕</button>\r\n    </div>\r\n    <div id=\"peerModalBody\" style=\"padding:20px;overflow-y:auto;flex:1;\"></div>\r\n  </div>\r\n</div>\r\n</body>\r\n</html>\r\n\r\n"
          },
