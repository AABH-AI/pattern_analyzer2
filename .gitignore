# User-generated probing-layer exports (downloaded into the folder) — not source
RCA_KNOWLEDGE_BASE.md

# Local input data (never commit the demand file)
Input_To_ML_*.xlsx
*.xlsx
*.csv

# The offline SQL mirror. This is a LOCAL CACHE of Playground.dbo.Input_To_ML built from the
# spreadsheet by results/offline_source.py -- i.e. the same client data the rules above already
# refuse to commit, just in a different container. `*.xlsx` and `*.csv` did not cover it and a
# 31 MB copy of the source table reached a commit before this line existed.
results/_offline_cache/
*.sqlite
*.sqlite3
*.db

# Backend secrets & Python cruft
backend/config.json
.env
backend/.env
__pycache__/
*.pyc

# OS / editor cruft
Thumbs.db
.DS_Store
.vscode/

# Canary screen recordings — kept OUT of git deliberately: ~33 MB of WebM that would
# bloat every future clone forever. The evidence survives without them: report.html
# embeds the per-step screenshots, and screenshots/ + network.har + console.log are
# committed. The videos live in the Canary session dirs under ~/.canary/sessions/ and
# are copied into results/canary-*/video/ locally. Force-add if you really want them.
results/**/video/
*.webm
# ...but a transcoded MP4 is small enough to keep (V0.4 is 1.8 MB vs 5.5 MB WebM), so it is
# committed as the shareable record. Convert with:
#   ffmpeg -i <session>.webm -c:v libx264 -crf 24 -pix_fmt yuv420p -movflags +faststart out.mp4
!results/**/*.mp4

# Backups and variants of the secrets file. config.json itself is ignored above, but a copy named
# config.json.bak / .bak-preGroq / .orig is not, and every such copy on disk carries the live SQL
# password and the LLM API keys. One `git add -A` is all it takes.
backend/config.json.*
backend/config.*.json
config.json.*
