  "challenge_questions": [
    {
      "key": "STAT_SIGNIFICANCE",
      "category": "Statistical Validation",
      "applies_to": [
        "Demand",
        "Statistical",
        "Forecast"
      ],
      "question": "Is the deviation statistically distinguishable from this queue's normal variation?"
    },
    {
      "key": "STAT_METRIC_AGREEMENT",
      "category": "Statistical Validation",
      "applies_to": [
        "Demand",
