# Copy to .env (in the repo root, next to docker-compose.yml) and fill in.
# .env is gitignored — credentials are never committed.
SQL_USERNAME=your_sql_login
SQL_PASSWORD=your_password

# Optional overrides (defaults are set in docker-compose.yml):
# SQL_SERVER=10.10.9.75
# SQL_DATABASE=Playground
# SQL_TABLE=dbo.Input_To_ML
# SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_ENCRYPT=false
# SQL_TRUST_CERT=true
