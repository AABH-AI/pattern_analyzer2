# Copy to .env (in the repo root, next to docker-compose.yml) and fill in.
# .env is gitignored — credentials are never committed.
SQL_USERNAME=your_sql_login
SQL_PASSWORD=your_password

# Optional overrides (defaults are set in docker-compose.yml):
# SQL_SERVER=10.10.9.75
# SQL_DATABASE=Playground
# SQL_TABLE=dbo.Input_To_ML
# SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_ENCRYPT=false
# SQL_TRUST_CERT=true

# LLM Investigation Engine — leave both unset to keep the honest placeholder response.
# Priority (which is tried first) is set in backend/config.json's "llm" primary/secondary
# slots, NOT by which env var you set here — these just supply/override credentials for
# whichever provider each slot names. Currently: primary = NVIDIA, secondary = Groq.
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
